@page "/seasons/{id:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(season?.Name ?? "Season")</PageTitle>

@if (notFound)
{
    <p class="text-muted">Season not found.</p>
}
else if (season is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <nav class="small mb-2"><a href="/seasons">Seasons</a> / @season.Name</nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@season.Name</h1>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary fs-6">@season.Status</span>
            @if (season.RegistrationOpen)
            {
                <span class="badge bg-success fs-6">Registration Open</span>
            }
            <AuthorizeView Roles="Bloodsport.Admin">
                <Authorized>
                    <a href="/seasons/@season.Id/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <button class="btn btn-sm btn-primary" @onclick="BuildBracket" disabled="@buildingBracket">
                        @if (buildingBracket)
                        {
                            <span>Building...</span>
                        }
                        else
                        {
                            <span>Build Bracket</span>
                        }
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-2">Start</dt>
        <dd class="col-sm-10">@season.StartDate.ToLocalTime().ToString("MMMM d, yyyy")</dd>

        <dt class="col-sm-2">End</dt>
        <dd class="col-sm-10">@season.EndDate.ToLocalTime().ToString("MMMM d, yyyy")</dd>
    </dl>

    @if (season.RegistrationOpen)
    {
        <div class="mb-4">
            @if (alreadyRegisteredTeams.Count > 0)
            {
                <div class="alert alert-success py-2">
                    @if (alreadyRegisteredTeams.Count == 1)
                    {
                        <span><strong>@alreadyRegisteredTeams[0].Name</strong> is registered for this season.</span>
                    }
                    else
                    {
                        <span>Your teams <strong>@string.Join(", ", alreadyRegisteredTeams.Select(t => t.Name))</strong> are registered for this season.</span>
                    }
                </div>
            }

            @if (eligibleTeams.Count > 0)
            {
                <form method="post" action="/api/seasons/@season.Id/register">
                    <div class="d-flex gap-2 align-items-center">
                        @if (eligibleTeams.Count == 1)
                        {
                            <input type="hidden" name="teamId" value="@eligibleTeams[0].Id" />
                            <button type="submit" class="btn btn-success btn-sm">
                                Register @eligibleTeams[0].Name
                            </button>
                        }
                        else
                        {
                            <select name="teamId" class="form-select form-select-sm" style="max-width: 250px;">
                                @foreach (var team in eligibleTeams)
                                {
                                    <option value="@team.Id">@team.Name</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-success btn-sm">Register</button>
                        }
                    </div>
                </form>
            }
        </div>
    }

    <h2>Registered Teams</h2>

    @if (season.SeasonRegistrations.Count == 0)
    {
        <p class="text-muted">No teams registered yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Team</th>
                    <th>Manager</th>
                    <th>Registered</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in season.SeasonRegistrations)
                {
                    <tr>
                        <td><a href="/teams/@reg.Team.Id">@reg.Team.Name</a></td>
                        <td><a href="/users/@reg.Team.Manager.Id">@reg.Team.Manager.DisplayName</a></td>
                        <td>@reg.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

}

@code {
    [Parameter] public long Id { get; set; }

    private Season? season;
    private bool notFound;
    private bool buildingBracket;
    private List<Team> eligibleTeams = [];
    private List<Team> alreadyRegisteredTeams = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        season = await db.Seasons
            .Include(s => s.SeasonRegistrations)
                .ThenInclude(r => r.Team)
                    .ThenInclude(t => t.Manager)
            .Include(s => s.SeasonRegistrations)
                .ThenInclude(r => r.Team)
                    .ThenInclude(t => t.TeamMemberships)
            .FirstOrDefaultAsync(s => s.Id == Id);

        if (season is null)
        {
            notFound = true;
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is null)
            return;

        var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);

        if (user is null)
            return;

        var managedTeams = await db.Teams
            .Where(t => t.ManagerId == user.Id)
            .ToListAsync();

        var registeredTeamIds = season.SeasonRegistrations.Select(r => r.TeamId).ToHashSet();

        alreadyRegisteredTeams = managedTeams.Where(t => registeredTeamIds.Contains(t.Id)).ToList();
        eligibleTeams = managedTeams.Where(t => !registeredTeamIds.Contains(t.Id)).ToList();
    }

    private async Task BuildBracket()
    {
        buildingBracket = true;

        // TODO: dispatch service bus message to Function App

        buildingBracket = false;
    }
}
