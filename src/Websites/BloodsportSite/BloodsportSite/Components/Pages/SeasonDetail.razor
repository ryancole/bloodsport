@page "/seasons/{id:long}"
@inject NavigationManager NavigationManager
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(season?.Name ?? "Season") | BSAL</PageTitle>

@if (notFound)
{
    <p class="text-sm text-gray-500">Season not found.</p>
}
else if (season is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    <SectionContent SectionName="breadcrumbs">
        <nav><a href="/seasons" class="link">Seasons</a> / @season.Name</nav>
    </SectionContent>

    <div class="mb-6 flex items-center justify-between gap-4">
        <h1 class="page-title">@season.Name</h1>
        <AuthorizeView Roles="Champions.Admin">
            <Authorized>
                <div class="flex items-center gap-2">
                    <a href="/seasons/@season.Id/edit" class="btn btn-secondary">Edit</a>
                    @if (season.SeasonWeeks.Count == 0 && !season.RegistrationOpen && season.Status == SeasonStatus.PreSeason)
                    {
                        <form method="post" action="/api/seasons/@season.Id/build">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-primary">Build Season</button>
                        </form>
                    }
                    @if (season.SeasonWeeks.Count > 0 && !season.RegistrationOpen && season.Status == SeasonStatus.PreSeason)
                    {
                        <form method="post" action="/api/seasons/@season.Id/start">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-primary">Start Season</button>
                        </form>
                    }
                    @if (season.Status == SeasonStatus.Completed && season.Playoff is null)
                    {
                        <form method="post" action="/api/seasons/@season.Id/create-playoffs">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-primary">Create Playoffs</button>
                        </form>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    <dl class="mb-6 grid grid-cols-[140px_1fr] gap-y-2 text-sm">
        <dt class="font-medium text-gray-500">Status</dt>
        <dd><SeasonStatusBadge Status="season.Status" /></dd>

        <dt class="font-medium text-gray-500">Registration</dt>
        <dd>
            <Pill Color="@(season.RegistrationOpen ? PillColor.Green : PillColor.Red)"
                  IconPath="@(season.RegistrationOpen ? StatusIcons.LockOpen : StatusIcons.LockClosed)">@(season.RegistrationOpen ? "Open" : "Closed")</Pill>
        </dd>

        <dt class="font-medium text-gray-500">Length</dt>
        <dd class="text-gray-700">@season.Length weeks</dd>

        <dt class="font-medium text-gray-500">Region</dt>
        <dd class="text-gray-700">@season.RiotRegion</dd>

        <dt class="font-medium text-gray-500">Estimated Start</dt>
        <dd class="text-gray-700">@(season.EstimatedDateStart?.ToLocalTime().ToString("MMMM d, yyyy") ?? "TBD")</dd>

        <dt class="font-medium text-gray-500">Estimated End</dt>
        <dd class="text-gray-700">@(season.EstimatedDateEnd?.ToLocalTime().ToString("MMMM d, yyyy") ?? "TBD")</dd>

        @if (season.Playoff is not null)
        {
            <dt class="font-medium text-gray-500">Playoff</dt>
            <dd><a href="/playoffs/@season.Playoff.Id" class="link">@season.Playoff.Name</a></dd>
        }
    </dl>

    @if (season.Status == SeasonStatus.PreSeason)
    {
        <div role="alert" class="alert alert-warning mb-6">
            <strong>Roster Lock Warning:</strong> Once this season is started, all team rosters are locked and cannot be modified. Teams that are unable to field their roster will be recorded as a loss.
        </div>
    }

    @if (season.Status == SeasonStatus.Upcoming)
    {
        @if (season.RegistrationOpen)
        {
            <div class="card mb-6 max-w-xl">
                <h2 class="mb-2 section-title">Registration is Open</h2>

                @if (alreadyRegisteredTeams.Count > 0)
                {
                    <p class="mb-3 text-gray-600">
                        @if (alreadyRegisteredTeams.Count == 1)
                        {
                            <span><a href="/teams/@alreadyRegisteredTeams[0].Id" class="link"><strong>@alreadyRegisteredTeams[0].Name</strong></a> is registered for this season.</span>
                        }
                        else
                        {
                            <span>Your teams @for (var i = 0; i < alreadyRegisteredTeams.Count; i++)
                            {
                                var team = alreadyRegisteredTeams[i];
                                <a href="/teams/@team.Id" class="link"><strong>@team.Name</strong></a>
                                if (i < alreadyRegisteredTeams.Count - 1)
                                {
                                    <text>, </text>
                                }
                            } are registered for this season.</span>
                        }
                    </p>
                }

                @if (eligibleTeams.Count > 0)
                {
                    <p class="mb-3 text-gray-600">Register one of your teams to compete in this season.</p>
                    <form method="post" action="/api/seasons/@season.Id/register">
                        <AntiforgeryToken />
                        <div class="flex items-center gap-2">
                            @if (eligibleTeams.Count == 1)
                            {
                                <input type="hidden" name="teamId" value="@eligibleTeams[0].Id" />
                                <button type="submit" class="btn btn-primary">
                                    Register @eligibleTeams[0].Name
                                </button>
                            }
                            else
                            {
                                <select name="teamId" class="input max-w-[250px]">
                                    @foreach (var team in eligibleTeams)
                                    {
                                        <option value="@team.Id">@team.Name</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary">Register</button>
                            }
                        </div>
                    </form>
                }
                else if (alreadyRegisteredTeams.Count == 0)
                {
                    <p class="text-gray-600">You don't have any teams eligible to register.</p>
                }
            </div>
        }
    }

    @if (season.Status == SeasonStatus.Active || season.Status == SeasonStatus.Completed)
    {
        <div class="mb-8">
            <SeasonWeeksTable SeasonId="season.Id" Weeks="season.SeasonWeeks" />
        </div>
    }

    @if (season.Status == SeasonStatus.Upcoming)
    {
        <SeasonRegistrationsTable SeasonId="season.Id" Registrations="season.SeasonRegistrations" CurrentPage="CurrentPage" />
    }
    else
    {
        <SeasonStandingsTable SeasonId="season.Id" Results="season.TeamSeasonResults" CurrentPage="CurrentPage" />
    }

}

@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery] private int teamsPage { get; set; }
    private int CurrentPage => teamsPage < 1 ? 1 : teamsPage;

    private Season? season;
    private bool notFound;
    private List<Team> eligibleTeams = [];
    private List<Team> alreadyRegisteredTeams = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        season = await db.Seasons
            .Include(s => s.SeasonWeeks)
            .Include(s => s.Playoff)
            .Include(s => s.SeasonRegistrations)
                .ThenInclude(r => r.Team)
                    .ThenInclude(t => t.Manager)
            .Include(s => s.SeasonRegistrations)
                .ThenInclude(r => r.Team)
                    .ThenInclude(t => t.TeamMemberships)
            .Include(s => s.TeamSeasonResults)
                .ThenInclude(r => r.Team)
            .FirstOrDefaultAsync(s => s.Id == Id);

        if (season is null)
        {
            notFound = true;
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is null)
            return;

        var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);

        if (user is null)
            return;

        var managedTeams = await db.Teams
            .Where(t => t.ManagerId == user.Id)
            .ToListAsync();

        var registeredTeamIds = season.SeasonRegistrations.Select(r => r.TeamId).ToHashSet();

        alreadyRegisteredTeams = managedTeams.Where(t => registeredTeamIds.Contains(t.Id)).ToList();
        eligibleTeams = managedTeams.Where(t => !registeredTeamIds.Contains(t.Id)).ToList();
    }

}
