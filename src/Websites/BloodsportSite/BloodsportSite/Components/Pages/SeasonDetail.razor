@page "/seasons/{id:long}"
@inject NavigationManager NavigationManager
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(season?.Name ?? "Season")</PageTitle>

@if (notFound)
{
    <p class="text-muted">Season not found.</p>
}
else if (season is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <nav class="small mb-2"><a href="/seasons">Seasons</a> / @season.Name</nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@season.Name</h1>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary fs-6">@season.Status</span>
            @if (season.RegistrationOpen)
            {
                <span class="badge bg-success fs-6">Registration Open</span>
            }
            <AuthorizeView Roles="Bloodsport.Admin">
                <Authorized>
                    <a href="/seasons/@season.Id/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                    @if (season.SeasonWeeks.Count == 0)
                    {
                        <form method="post" action="/api/seasons/@season.Id/build" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Build Season</button>
                        </form>
                    }
                    @if (season.Status != SeasonStatus.Completed)
                    {
                        <form method="post" action="/api/seasons/@season.Id/end" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-danger">End Season</button>
                        </form>
                    }
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-2">Start</dt>
        <dd class="col-sm-10">@season.StartDate.ToLocalTime().ToString("MMMM d, yyyy")</dd>

        <dt class="col-sm-2">End</dt>
        <dd class="col-sm-10">@season.EndDate.ToLocalTime().ToString("MMMM d, yyyy")</dd>
    </dl>

    @if (season.RegistrationOpen)
    {
        <div class="mb-4">
            @if (alreadyRegisteredTeams.Count > 0)
            {
                <div class="alert alert-success py-2">
                    @if (alreadyRegisteredTeams.Count == 1)
                    {
                        <span><strong>@alreadyRegisteredTeams[0].Name</strong> is registered for this season.</span>
                    }
                    else
                    {
                        <span>Your teams <strong>@string.Join(", ", alreadyRegisteredTeams.Select(t => t.Name))</strong> are registered for this season.</span>
                    }
                </div>
            }

            @if (eligibleTeams.Count > 0)
            {
                <form method="post" action="/api/seasons/@season.Id/register">
                    <div class="d-flex gap-2 align-items-center">
                        @if (eligibleTeams.Count == 1)
                        {
                            <input type="hidden" name="teamId" value="@eligibleTeams[0].Id" />
                            <button type="submit" class="btn btn-success btn-sm">
                                Register @eligibleTeams[0].Name
                            </button>
                        }
                        else
                        {
                            <select name="teamId" class="form-select form-select-sm" style="max-width: 250px;">
                                @foreach (var team in eligibleTeams)
                                {
                                    <option value="@team.Id">@team.Name</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-success btn-sm">Register</button>
                        }
                    </div>
                </form>
            }
        </div>
    }

    <h2>Regular Season Weeks</h2>

    @if (season.SeasonWeeks.Count == 0)
    {
        <p class="text-muted">No weeks scheduled yet.</p>
    }
    else
    {
        <table class="table mb-4">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Start</th>
                    <th>End</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var week in season.SeasonWeeks.OrderBy(w => w.Index))
                {
                    <tr>
                        <td>@week.Index</td>
                        <td><a href="/seasons/@season.Id/weeks/@week.Id">@week.Name</a></td>
                        <td>@week.DateStart.ToLocalTime().ToString("MMMM d, yyyy")</td>
                        <td>@week.DateEnd.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">Registered Teams</h2>
        @{
            var sortedRegistrations = season.SeasonRegistrations
                .OrderByDescending(r => teamRecords.GetValueOrDefault(r.TeamId).Wins)
                .ThenBy(r => r.Team.Name)
                .ToList();
            var totalPages = (int)Math.Ceiling(sortedRegistrations.Count / (double)PageSize);
            var pageRegistrations = sortedRegistrations.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
        }
        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/seasons/@season.Id?teamsPage=@(CurrentPage - 1)">Previous</a>
                    </li>
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        var pageNum = p;
                        <li class="page-item @(CurrentPage == pageNum ? "active" : "")">
                            <a class="page-link" href="/seasons/@season.Id?teamsPage=@pageNum">@pageNum</a>
                        </li>
                    }
                    <li class="page-item @(CurrentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="/seasons/@season.Id?teamsPage=@(CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>

    @if (season.SeasonRegistrations.Count == 0)
    {
        <p class="text-muted">No teams registered yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Team</th>
                    <th>W</th>
                    <th>L</th>
                    <th>Registered</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in pageRegistrations)
                {
                    var record = teamRecords.GetValueOrDefault(reg.TeamId);
                    <tr>
                        <td><a href="/teams/@reg.Team.Id">@reg.Team.Name</a></td>
                        <td>@record.Wins</td>
                        <td>@record.Losses</td>
                        <td>@reg.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

}

@code {
    private const int PageSize = 20;

    [Parameter] public long Id { get; set; }

    private Season? season;
    private bool notFound;
    private List<Team> eligibleTeams = [];
    private List<Team> alreadyRegisteredTeams = [];
    private Dictionary<long, (int Wins, int Losses)> teamRecords = [];
    [SupplyParameterFromQuery] private int teamsPage { get; set; }
    private int CurrentPage => teamsPage < 1 ? 1 : teamsPage;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        season = await db.Seasons
            .Include(s => s.SeasonWeeks)
                .ThenInclude(w => w.SeasonWeekMatchups)
                    .ThenInclude(m => m.SeasonWeekMatchupResult)
            .Include(s => s.SeasonRegistrations)
                .ThenInclude(r => r.Team)
                    .ThenInclude(t => t.Manager)
            .Include(s => s.SeasonRegistrations)
                .ThenInclude(r => r.Team)
                    .ThenInclude(t => t.TeamMemberships)
            .FirstOrDefaultAsync(s => s.Id == Id);

        if (season is not null)
        {
            var allMatchups = season.SeasonWeeks
                .SelectMany(w => w.SeasonWeekMatchups)
                .ToList();

            teamRecords = season.SeasonRegistrations
                .Select(r => r.TeamId)
                .ToDictionary(
                    teamId => teamId,
                    teamId =>
                    {
                        var played = allMatchups
                            .Where(m => (m.TeamOneId == teamId || m.TeamTwoId == teamId) && m.SeasonWeekMatchupResult is not null)
                            .ToList();
                        int wins = played.Count(m => m.SeasonWeekMatchupResult!.WinnerTeamId == teamId);
                        return (Wins: wins, Losses: played.Count - wins);
                    });
        }

        if (season is null)
        {
            notFound = true;
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is null)
            return;

        var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);

        if (user is null)
            return;

        var managedTeams = await db.Teams
            .Where(t => t.ManagerId == user.Id)
            .ToListAsync();

        var registeredTeamIds = season.SeasonRegistrations.Select(r => r.TeamId).ToHashSet();

        alreadyRegisteredTeams = managedTeams.Where(t => registeredTeamIds.Contains(t.Id)).ToList();
        eligibleTeams = managedTeams.Where(t => !registeredTeamIds.Contains(t.Id)).ToList();
    }

}
