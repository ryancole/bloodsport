@page "/news/{id:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Markdig
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(post?.Title ?? "Post") | BSAL</PageTitle>

@if (notFound)
{
    <p class="text-muted">Post not found.</p>
}
else if (post is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <SectionContent SectionName="breadcrumbs">
        <nav class="small"><a href="/news">News</a> / @post.Title</nav>
    </SectionContent>

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="mb-1">@post.Title</h1>
            <div class="news-item-meta">
                <time>@post.DateCreated.ToString("MMMM d, yyyy")</time>
                <span class="news-item-meta-sep">·</span>
                <a href="/users/@post.User.Id">@post.User.DisplayName</a>
            </div>
        </div>
        <AuthorizeView Roles="Bloodsport.Admin">
            <Authorized>
                <a href="/news/@post.Id/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="post-content mb-5">
        @renderedHtml
    </div>

    <section class="post-comments" id="comments">
        <h2 class="h5 mb-3">@(comments.Count == 1 ? "1 Comment" : $"{comments.Count} Comments")</h2>

        @if (commentError is not null)
        {
            <div class="alert alert-danger py-2 px-3 small mb-3">@commentError</div>
        }

        <AuthorizeView>
            <Authorized>
                <form method="post" action="/api/posts/@post.Id/comments" class="mb-4">
                    <AntiforgeryToken />
                    <div class="mb-2">
                        <textarea name="body" class="form-control" rows="3" placeholder="Write a comment..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Post Comment</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <p class="text-muted small mb-4"><a href="/auth/login">Log in</a> to leave a comment.</p>
            </NotAuthorized>
        </AuthorizeView>

        @if (comments.Count == 0)
        {
            <p class="text-muted small">No comments yet. Be the first!</p>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var comment in comments)
                {
                    <div class="post-comment">
                        <div class="post-comment-meta">
                            <a href="/users/@comment.User.Id">@comment.User.DisplayName</a>
                            <span class="news-item-meta-sep">·</span>
                            <time>@comment.DateCreated.ToString("MMMM d, yyyy")</time>
                            @if (currentUserId == comment.UserId || isAdmin)
                            {
                                <form method="post" action="/api/posts/@post.Id/comments/@comment.Id/delete" class="ms-auto">
                                    <AntiforgeryToken />
                                    <button type="submit" class="post-comment-delete">Delete</button>
                                </form>
                            }
                        </div>
                        <p class="post-comment-body">@comment.Body</p>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public long Id { get; set; }

    private Post? post;
    private List<PostComment> comments = [];
    private MarkupString renderedHtml;
    private bool notFound;
    private string? commentError;
    private long? currentUserId;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("comment_error", out var errorCode))
        {
            commentError = (string?)errorCode switch
            {
                "empty" => "Comment cannot be empty.",
                _       => "An unknown error occurred. Please try again.",
            };
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
        isAdmin = authState.User.IsInRole("Bloodsport.Admin");

        await using var db = await DbFactory.CreateDbContextAsync();

        if (oid is not null)
        {
            var currentUser = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);
            currentUserId = currentUser?.Id;
        }

        post = await db.Posts
            .Include(p => p.User)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (post is null)
        {
            notFound = true;
            return;
        }

        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        renderedHtml = new MarkupString(Markdown.ToHtml(post.Markdown, pipeline));

        comments = await db.PostComments
            .Include(c => c.User)
            .Where(c => c.PostId == Id)
            .OrderBy(c => c.DateCreated)
            .ToListAsync();
    }
}
