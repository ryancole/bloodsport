@page "/news/{id:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Markdig
@using Markdig.Syntax
@using Markdig.Syntax.Inlines
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(post?.Title ?? "Post") | CAL</PageTitle>

@if (notFound)
{
    <p class="text-sm text-gray-500">Post not found.</p>
}
else if (post is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    <HeadContent>
        <meta property="og:type" content="article" />
        <meta property="og:site_name" content="Champions Amateur League" />
        <meta property="og:title" content="@post.Title" />
        <meta property="og:description" content="@description" />
        <meta property="og:url" content="@NavigationManager.Uri" />
        <meta property="og:image" content="@imageUrl" />
        <meta property="article:published_time" content="@post.DateCreated.ToString("o")" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@post.Title" />
        <meta name="twitter:description" content="@description" />
        <meta name="twitter:image" content="@imageUrl" />
    </HeadContent>

    <SectionContent SectionName="breadcrumbs">
        <nav><a href="/news" class="link">News</a> / @post.Title</nav>
    </SectionContent>

    <div class="mb-6 flex items-start justify-between gap-4">
        <div>
            <h1 class="page-title">@post.Title</h1>
            <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-gray-400">
                <time>@post.DateCreated.ToString("MMMM d, yyyy")</time>
                <span>·</span>
                <a href="/users/@post.User.Id" class="link inline-flex items-center gap-1.5"><UserFlag LogoUrl="@post.User.LogoUrl" />@post.User.DisplayName</a>
            </div>
        </div>
        <AuthorizeView Roles="Champions.Admin">
            <Authorized>
                <a href="/news/@post.Id/edit" class="btn btn-secondary">Edit</a>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="doc">
        @renderedHtml
    </div>

    <section id="comments" class="mt-10 max-w-3xl border-t border-gray-200 pt-6">
        <h2 class="mb-4 section-title">@(comments.Count == 1 ? "1 Comment" : $"{comments.Count} Comments")</h2>

        @if (commentError is not null)
        {
            <div class="alert alert-danger mb-4">@commentError</div>
        }

        <AuthorizeView>
            <Authorized>
                <form method="post" action="/api/posts/@post.Id/comments" class="mb-6 space-y-2">
                    <AntiforgeryToken />
                    <textarea name="body" rows="3" placeholder="Write a comment..." required class="input"></textarea>
                    <button type="submit" class="btn btn-primary">Post Comment</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <p class="mb-6 text-sm text-gray-500"><a href="/auth/login" class="link">Log in</a> to leave a comment.</p>
            </NotAuthorized>
        </AuthorizeView>

        @if (comments.Count == 0)
        {
            <p class="text-sm text-gray-500">No comments yet. Be the first!</p>
        }
        else
        {
            <div class="divide-y divide-gray-100">
                @foreach (var comment in comments)
                {
                    <div class="py-4">
                        <div class="mb-1 flex flex-wrap items-center gap-2 text-xs text-gray-400">
                            <a href="/users/@comment.User.Id" class="link inline-flex items-center gap-1.5"><UserFlag LogoUrl="@comment.User.LogoUrl" />@comment.User.DisplayName</a>
                            <span>·</span>
                            <time>@comment.DateCreated.ToString("MMMM d, yyyy")</time>
                            @if (currentUserId == comment.UserId || isAdmin)
                            {
                                <form method="post" action="/api/posts/@post.Id/comments/@comment.Id/delete">
                                    <AntiforgeryToken />
                                    <button type="submit" class="text-xs text-gray-400 hover:text-red-600">Delete</button>
                                </form>
                            }
                        </div>
                        <p class="text-gray-700">@comment.Body</p>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public long Id { get; set; }

    private Post? post;
    private List<PostComment> comments = [];
    private MarkupString renderedHtml;
    private string description = "";
    private string imageUrl = "";
    private bool notFound;
    private string? commentError;
    private long? currentUserId;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("comment_error", out var errorCode))
        {
            commentError = (string?)errorCode switch
            {
                "empty" => "Comment cannot be empty.",
                _       => "An unknown error occurred. Please try again.",
            };
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
        isAdmin = authState.User.IsInRole("Champions.Admin");

        await using var db = await DbFactory.CreateDbContextAsync();

        if (oid is not null)
        {
            var currentUser = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);
            currentUserId = currentUser?.Id;
        }

        post = await db.Posts
            .Include(p => p.User)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (post is null)
        {
            notFound = true;
            return;
        }

        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        var document = Markdown.Parse(post.Markdown, pipeline);
        renderedHtml = new MarkupString(document.ToHtml(pipeline));

        // Open Graph / Twitter Card metadata for link previews.
        var plain = Markdown.ToPlainText(post.Markdown, pipeline).Trim();
        plain = string.Join(" ", plain.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        description = plain.Length > 200 ? plain[..197].TrimEnd() + "…" : plain;

        var firstImage = document
            .Descendants<LinkInline>()
            .FirstOrDefault(l => l.IsImage && !string.IsNullOrWhiteSpace(l.Url))?
            .Url;
        imageUrl = ToAbsoluteUrl(firstImage) ?? ToAbsoluteUrl("og-default.png")!;

        comments = await db.PostComments
            .Include(c => c.User)
            .Where(c => c.PostId == Id)
            .OrderBy(c => c.DateCreated)
            .ToListAsync();
    }

    private string? ToAbsoluteUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }

        return Uri.TryCreate(url, UriKind.Absolute, out var absolute)
            ? absolute.ToString()
            : new Uri(new Uri(NavigationManager.BaseUri), url).ToString();
    }
}
