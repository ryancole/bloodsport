@page "/seasons/create"
@attribute [Authorize(Roles = "Champions.Admin")]
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager

<PageTitle>Create Season | CAL</PageTitle>

<h1 class="page-title mb-6">Create Season</h1>

@if (error is not null)
{
    <div class="alert alert-danger mb-4 max-w-md">@error</div>
}

<form method="post" action="/api/seasons/create" class="max-w-md space-y-4">
    <AntiforgeryToken />
    <div>
        <label class="label">Season Name</label>
        <input type="text" name="name" placeholder="Season 1" required autofocus class="input" />
    </div>
    <div>
        <label class="label">Season Length</label>
        <select name="length" class="input">
            @for (int i = 3; i <= 8; i++)
            {
                <option value="@i" selected="@(i == 6)">@i weeks</option>
            }
        </select>
    </div>
    <div>
        <label class="label">Estimated Start Date <span class="font-normal text-gray-400">(optional)</span></label>
        <input type="date" name="startDate" class="input" />
    </div>

    <h2 class="text-lg font-semibold pt-2">Matchup Settings</h2>
    <div>
        <label class="label">Team Size</label>
        <select name="teamSize" class="input">
            @for (int i = 1; i <= 5; i++)
            {
                <option value="@i" selected="@(i == 5)">@i</option>
            }
        </select>
    </div>
    <div>
        <label class="label">Pick Type</label>
        <select name="pickType" class="input">
            @foreach (var value in SeasonMatchupParameters.PickTypes)
            {
                <option value="@value" selected="@(value == "TOURNAMENT_DRAFT")">@value</option>
            }
        </select>
    </div>
    <div>
        <label class="label">Map Type</label>
        <select name="mapType" class="input">
            @foreach (var value in SeasonMatchupParameters.MapTypes)
            {
                <option value="@value" selected="@(value == "SUMMONERS_RIFT")">@value</option>
            }
        </select>
    </div>
    <div>
        <label class="label">Spectator Type</label>
        <select name="spectatorType" class="input">
            @foreach (var value in SeasonMatchupParameters.SpectatorTypes)
            {
                <option value="@value" selected="@(value == "ALL")">@value</option>
            }
        </select>
    </div>
    <div class="flex items-center gap-3">
        <button type="submit" class="btn btn-primary">Create</button>
        <a href="/seasons" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@code {
    private string? error;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var errorCode))
        {
            error = (string?)errorCode switch
            {
                "invalid_name" => "Please enter a season name.",
                _              => "An unknown error occurred. Please try again.",
            };
        }
    }
}
