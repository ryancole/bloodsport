@page "/seasons/create"
@attribute [Authorize(Roles = "Bloodsport.Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager

<PageTitle>Create Season</PageTitle>

<h1>Create Season</h1>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<form method="post" action="/api/seasons/create" class="mt-3">
    <AntiforgeryToken />
    <div class="mb-3" style="max-width: 400px;">
        <label class="form-label">Season Name</label>
        <input type="text" name="name" class="form-control" placeholder="Season 1" required autofocus />
    </div>
    <div class="mb-3" style="max-width: 400px;">
        <label class="form-label">Estimated Start Date <span class="text-muted">(optional)</span></label>
        <input type="date" name="startDate" class="form-control" />
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create</button>
        <a href="/seasons" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@code {
    private string? error;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var errorCode))
        {
            error = (string?)errorCode switch
            {
                "invalid_name" => "Please enter a season name.",
                _              => "An unknown error occurred. Please try again.",
            };
        }
    }
}
