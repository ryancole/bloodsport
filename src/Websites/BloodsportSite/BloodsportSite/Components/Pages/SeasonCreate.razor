@page "/seasons/create"
@attribute [Authorize(Roles = "Champions.Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager

<PageTitle>Create Season | BSAL</PageTitle>

<h1>Create Season</h1>

@if (error is not null)
{
    <div>@error</div>
}

<form method="post" action="/api/seasons/create">
    <AntiforgeryToken />
    <div style="max-width: 400px;">
        <label>Season Name</label>
        <input type="text" name="name" placeholder="Season 1" required autofocus />
    </div>
    <div style="max-width: 400px;">
        <label>Season Length</label>
        <select name="length">
            @for (int i = 3; i <= 8; i++)
            {
                <option value="@i" selected="@(i == 6)">@i weeks</option>
            }
        </select>
    </div>
    <div style="max-width: 400px;">
        <label>Estimated Start Date <span>(optional)</span></label>
        <input type="date" name="startDate" />
    </div>
    <div>
        <button type="submit">Create</button>
        <a href="/seasons">Cancel</a>
    </div>
</form>

@code {
    private string? error;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var errorCode))
        {
            error = (string?)errorCode switch
            {
                "invalid_name" => "Please enter a season name.",
                _              => "An unknown error occurred. Please try again.",
            };
        }
    }
}
