@page "/teams/{id:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject BloodsportSite.Services.BlobSasService BlobSasService


<PageTitle>@(team?.Name ?? "Team") | BSAL</PageTitle>

@if (notFound)
{
    <p class="text-sm text-gray-500">Team not found.</p>
}
else if (team is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    <SectionContent SectionName="breadcrumbs">
        <nav><a href="/teams" class="link">Teams</a> / @team.Name</nav>
    </SectionContent>

    <div class="mb-6 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            @if (team.LogoUrl is not null)
            {
                <img src="@BlobSasService.GetSasUrl(team.LogoUrl)" alt="@team.Name logo" class="h-16 w-16 rounded-[2px] object-contain ring-1 ring-black/20" />
            }
            <h1 class="page-title">@team.Name</h1>
        </div>
        @if (isManager || isMember)
        {
            <div class="flex items-center gap-2">
                @if (isManager)
                {
                    <a href="/teams/@team.Id/edit" class="btn btn-secondary">Edit</a>
                    <form method="post" action="/api/teams/@team.Id/delete">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                }
                @if (isMember)
                {
                    <form method="post" action="/api/teams/@team.Id/leave">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-danger">Leave Team</button>
                    </form>
                }
            </div>
        }
    </div>

    <dl class="mb-8 grid grid-cols-[120px_1fr] gap-y-2 text-sm">
        <dt class="font-medium text-gray-500">Manager</dt>
        <dd><a href="/users/@team.Manager.Id" class="link inline-flex items-center gap-2"><UserFlag LogoUrl="@team.Manager.LogoUrl" />@team.Manager.DisplayName</a></dd>

        <dt class="font-medium text-gray-500">Created</dt>
        <dd class="text-gray-700">@team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</dd>
    </dl>

    @if (isManager)
    {
        @if (inviteError is not null)
        {
            <div class="alert alert-danger mb-4">@inviteError</div>
        }
        @if (inviteSent)
        {
            <div class="alert alert-success mb-4">Invite sent successfully.</div>
        }

        @if (pendingInvites.Count > 0)
        {
            <h3 class="mb-3 mt-6 text-base font-semibold text-gray-900">Pending Invites</h3>
            <div class="overflow-x-auto">
                <table class="tbl">
                    <thead>
                        <tr><th>Riot ID</th><th>Sent</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var invite in pendingInvites)
                        {
                            <tr>
                                <td><a href="https://u.gg/lol/profile/na1/@Uri.EscapeDataString(invite.RiotAccount.GameName)-@Uri.EscapeDataString(invite.RiotAccount.TagLine)/overview" target="_blank" rel="noopener noreferrer" class="link"><strong>@invite.RiotAccount.GameName#@invite.RiotAccount.TagLine</strong></a></td>
                                <td>@invite.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="mt-4">
            <InviteMemberModal TeamId="@team.Id" />
        </div>
    }

    <div class="mb-3 mt-8 flex flex-wrap items-center justify-between gap-3">
        <h2 class="section-title">Members</h2>
        <div class="flex flex-wrap items-center gap-3">
            @if (team.TeamMemberships.Count > 0)
            {
                <div class="flex items-center gap-1 text-sm text-gray-500">
                    <span>@team.TeamMemberships.Count(m => m.Active) of @TeamMembership.MaxActiveMembers roster spots active</span>
                    <span class="group relative inline-flex" tabindex="0">
                        <Icon Path="@StatusIcons.QuestionMarkCircle" Class="h-3.5 w-3.5 cursor-help text-gray-400 hover:text-gray-600" />
                        <span role="tooltip" class="pointer-events-none absolute right-0 top-full z-20 mt-2 w-64 whitespace-normal rounded-md bg-gray-900 px-3 py-2 text-xs font-normal normal-case tracking-normal text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus:opacity-100">
                            A team can have at most @TeamMembership.MaxActiveMembers active members (5 starters + 2 bench). Each week during a season, your lineup must be made up entirely of active players on this roster.
                        </span>
                    </span>
                </div>
            }
            @if (isManager && joinableRiotAccounts.Count > 0)
            {
                <form method="post" action="/api/teams/@team.Id/join" class="flex items-center gap-2">
                    <AntiforgeryToken />
                    @if (joinableRiotAccounts.Count == 1)
                    {
                        <input type="hidden" name="riotAccountId" value="@joinableRiotAccounts[0].Id" />
                        <button type="submit" class="btn btn-primary btn-sm">Join with @joinableRiotAccounts[0].GameName#@joinableRiotAccounts[0].TagLine</button>
                    }
                    else
                    {
                        <select name="riotAccountId" class="input max-w-[250px] text-sm">
                            @foreach (var acct in joinableRiotAccounts)
                            {
                                <option value="@acct.Id">@acct.GameName#@acct.TagLine</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm">Join Team</button>
                    }
                </form>
            }
        </div>
    </div>

    @if (memberError is not null)
    {
        <div class="alert alert-danger mb-4">@memberError</div>
    }

    <TeamMembersTable Memberships="@team.TeamMemberships" TeamId="@team.Id" IsManager="@isManager" />

    <h2 class="mb-3 mt-8 section-title">Matchups</h2>

    @if (matchups.Count == 0)
    {
        <p class="text-sm text-gray-500">This team has no scheduled matchups.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tbl">
                <thead>
                    <tr><th>Matchup</th><th>Season</th><th>Week</th><th>Team 1</th><th>Team 2</th><th>Date Scheduled</th></tr>
                </thead>
                <tbody>
                    @foreach (var matchup in matchups)
                    {
                        <tr>
                            <td><a href="/seasons/@matchup.SeasonWeek.Season.Id/weeks/@matchup.SeasonWeek.Id/matchups/@matchup.Id" class="link">@matchup.Name</a></td>
                            <td><a href="/seasons/@matchup.SeasonWeek.Season.Id" class="link">@matchup.SeasonWeek.Season.Name</a></td>
                            <td><a href="/seasons/@matchup.SeasonWeek.Season.Id/weeks/@matchup.SeasonWeek.Id" class="link">@matchup.SeasonWeek.Name</a></td>
                            <td><a href="/teams/@matchup.TeamOne.Id" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@matchup.TeamOne.LogoUrl" />@matchup.TeamOne.Name</a></td>
                            <td><a href="/teams/@matchup.TeamTwo.Id" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@matchup.TeamTwo.LogoUrl" />@matchup.TeamTwo.Name</a></td>
                            <td>@matchup.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2 class="mb-3 mt-8 section-title">Seasons</h2>

    @if (team.SeasonRegistrations.Count == 0)
    {
        <p class="text-sm text-gray-500">This team has not been registered to any seasons.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Season</th><th>Status</th><th>Record</th><th>Registered</th>
                        @if (isManager)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in team.SeasonRegistrations.OrderByDescending(r => r.Season.EstimatedDateStart))
                    {
                        <tr>
                            <td><a href="/seasons/@reg.Season.Id" class="link">@reg.Season.Name</a></td>
                            <td>
                                @reg.Season.Status
                                @if (reg.Season.RegistrationOpen)
                                {
                                    <Pill Color="PillColor.Green">Reg. Open</Pill>
                                }
                            </td>
                            <td>
                                @if (seasonResults.TryGetValue(reg.Season.Id, out var result))
                                {
                                    <span class="font-semibold text-green-700">@result.WinCount W</span>
                                    <span class="text-gray-400">/</span>
                                    <span class="font-semibold text-red-700">@result.LoseCount L</span>
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td>@reg.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                            @if (isManager)
                            {
                                <td>
                                    @if (reg.Season.RegistrationOpen)
                                    {
                                        <form method="post" action="/api/seasons/@reg.Season.Id/unregister">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="teamId" value="@team.Id" />
                                            <button type="submit" class="btn btn-secondary btn-sm">Unregister</button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2 class="mb-3 mt-8 section-title">Playoffs</h2>

    @if (playoffEntries.Count == 0)
    {
        <p class="text-sm text-gray-500">This team has not participated in any playoffs.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tbl">
                <thead>
                    <tr><th>Playoff</th><th>Season</th><th>Seed</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in playoffEntries)
                    {
                        <tr>
                            <td><a href="/playoffs/@entry.PlayoffId" class="link">@entry.Playoff.Name</a></td>
                            <td><a href="/seasons/@entry.Playoff.SeasonId" class="link">@entry.Playoff.Season.Name</a></td>
                            <td>@entry.Seed</td>
                            <td><PlayoffStatusBadge Status="entry.Playoff.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

}

@code {
    [Parameter] public long Id { get; set; }

    private Bloodsport.Entity.Database.Team? team;
    private List<TeamInvite> pendingInvites = [];
    private List<SeasonWeekMatchup> matchups = [];
    private Dictionary<long, TeamSeasonResult> seasonResults = [];
    private List<PlayoffTeam> playoffEntries = [];
    private bool notFound;
    private bool isManager;
    private bool isMember;
    private List<RiotAccount> joinableRiotAccounts = [];
    private string? inviteError;
    private bool inviteSent;
    private string? memberError;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("invite_sent", out _))
            inviteSent = true;

        if (query.TryGetValue("member_error", out var memberErrorCode))
        {
            memberError = (string?)memberErrorCode switch
            {
                "active_full" => $"A team can have at most {TeamMembership.MaxActiveMembers} active members. Deactivate someone before activating another.",
                _             => "An unknown error occurred. Please try again.",
            };
        }

        if (query.TryGetValue("invite_error", out var errorCode))
        {
            inviteError = (string?)errorCode switch
            {
                "invalid_input"    => "Please enter both a Game Name and Tag.",
                "account_not_found" => "No linked Riot account found with that Game Name and Tag.",
                "already_member"   => "That Riot account is already a member of this team.",
                "already_invited"  => "That Riot account already has a pending invite.",
                _                  => "An unknown error occurred. Please try again.",
            };
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        team = await db.Teams
            .Include(t => t.Manager)
            .Include(t => t.TeamMemberships)
                .ThenInclude(m => m.RiotAccount)
                    .ThenInclude(r => r.User)
            .Include(t => t.SeasonRegistrations)
                .ThenInclude(r => r.Season)
            .FirstOrDefaultAsync(t => t.Id == Id);

        if (team is not null)
        {
            seasonResults = await db.TeamSeasonResults
                .Where(r => r.TeamId == Id)
                .ToDictionaryAsync(r => r.SeasonId);

            playoffEntries = await db.PlayoffTeams
                .Include(pt => pt.Playoff)
                    .ThenInclude(p => p.Season)
                .Where(pt => pt.TeamId == Id)
                .OrderByDescending(pt => pt.Playoff.DateCreated)
                .ToListAsync();
        }

        if (team is null)
        {
            notFound = true;
            return;
        }

        matchups = await db.SeasonWeekMatchups
            .Include(m => m.TeamOne)
            .Include(m => m.TeamTwo)
            .Include(m => m.SeasonWeek)
                .ThenInclude(w => w.Season)
            .Where(m => m.TeamOneId == Id || m.TeamTwoId == Id)
            .OrderByDescending(m => m.SeasonWeek.Season.EstimatedDateStart)
                .ThenBy(m => m.SeasonWeek.Index)
            .ToListAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            isManager = team.Manager.EntraObjectId == oid;
            isMember = team.TeamMemberships.Any(m => m.RiotAccount.User.EntraObjectId == oid);

            if (isManager)
            {
                pendingInvites = await db.TeamInvites
                    .Include(i => i.RiotAccount)
                    .Where(i => i.TeamId == Id && i.Status == TeamInviteStatus.Pending)
                    .OrderByDescending(i => i.DateCreated)
                    .ToListAsync();

                // The manager's own Riot accounts that aren't already members of this team.
                joinableRiotAccounts = await db.RiotAccounts
                    .Where(r => r.User.EntraObjectId == oid
                             && !db.TeamMemberships.Any(m => m.TeamId == Id && m.RiotAccountId == r.Id))
                    .OrderBy(r => r.GameName)
                    .ToListAsync();
            }
        }
    }
}
