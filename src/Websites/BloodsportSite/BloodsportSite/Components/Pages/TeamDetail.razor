@page "/teams/{id:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject BloodsportSite.Services.BlobSasService BlobSasService


<PageTitle>@(team?.Name ?? "Team") | BSAL</PageTitle>

@if (notFound)
{
    <p>Team not found.</p>
}
else if (team is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <SectionContent SectionName="breadcrumbs">
        <nav><a href="/teams">Teams</a> / @team.Name</nav>
    </SectionContent>

    <div>
        <div>
            @if (team.LogoUrl is not null)
            {
                <img src="@BlobSasService.GetSasUrl(team.LogoUrl)" alt="@team.Name logo" style="width: 72px; height: 72px; object-fit: contain;" />
            }
            <h1>@team.Name</h1>
        </div>
        @if (isManager)
        {
            <div>
                <a href="/teams/@team.Id/edit">Edit</a>
                <form method="post" action="/api/teams/@team.Id/delete">
                    <AntiforgeryToken />
                    <button type="submit">Delete</button>
                </form>
            </div>
        }
    </div>

    <dl>
        <dt>Manager</dt>
        <dd><a href="/users/@team.Manager.Id"><UserFlag LogoUrl="@team.Manager.LogoUrl" />@team.Manager.DisplayName</a></dd>

        <dt>Created</dt>
        <dd>@team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</dd>
    </dl>

    @if (isManager)
    {
        @if (inviteError is not null)
        {
            <div>@inviteError</div>
        }
        @if (inviteSent)
        {
            <div>Invite sent successfully.</div>
        }

        @if (pendingInvites.Count > 0)
        {
            <h3>Pending Invites</h3>
            <table>
                <thead>
                    <tr>
                        <th>Riot ID</th>
                        <th>Sent</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invite in pendingInvites)
                    {
                        <tr>
                            <td><a href="https://u.gg/lol/profile/na1/@Uri.EscapeDataString(invite.RiotAccount.GameName)-@Uri.EscapeDataString(invite.RiotAccount.TagLine)/overview" target="_blank" rel="noopener noreferrer"><strong>@invite.RiotAccount.GameName#@invite.RiotAccount.TagLine</strong></a></td>
                            <td>@invite.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <InviteMemberModal TeamId="@team.Id" />
    }

    <h2>Members</h2>
    <p>Teams are limited to 7 members (5 starters + 2 bench). Each week during a season, your lineup must be made up entirely of players on this roster.</p>

    <TeamMembersTable Memberships="@team.TeamMemberships" />

    <h2>Matchups</h2>

    @if (matchups.Count == 0)
    {
        <p>This team has no scheduled matchups.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Matchup</th>
                    <th>Season</th>
                    <th>Week</th>
                    <th>Team 1</th>
                    <th>Team 2</th>
                    <th>Date Scheduled</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var matchup in matchups)
                {
                    <tr>
                        <td><a href="/seasons/@matchup.SeasonWeek.Season.Id/weeks/@matchup.SeasonWeek.Id/matchups/@matchup.Id">@matchup.Name</a></td>
                        <td><a href="/seasons/@matchup.SeasonWeek.Season.Id">@matchup.SeasonWeek.Season.Name</a></td>
                        <td><a href="/seasons/@matchup.SeasonWeek.Season.Id/weeks/@matchup.SeasonWeek.Id">@matchup.SeasonWeek.Name</a></td>
                        <td><a href="/teams/@matchup.TeamOne.Id"><TeamFlag LogoUrl="@matchup.TeamOne.LogoUrl" />@matchup.TeamOne.Name</a></td>
                        <td><a href="/teams/@matchup.TeamTwo.Id"><TeamFlag LogoUrl="@matchup.TeamTwo.LogoUrl" />@matchup.TeamTwo.Name</a></td>
                        <td>@matchup.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Seasons</h2>

    @if (team.SeasonRegistrations.Count == 0)
    {
        <p>This team has not been registered to any seasons.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Season</th>
                    <th>Status</th>
                    <th>Record</th>
                    <th>Registered</th>
                    @if (isManager)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in team.SeasonRegistrations.OrderByDescending(r => r.Season.EstimatedDateStart))
                {
                    <tr>
                        <td><a href="/seasons/@reg.Season.Id">@reg.Season.Name</a></td>
                        <td>
                            @reg.Season.Status
                            @if (reg.Season.RegistrationOpen)
                            {
                                <span class="cal-badge cal-badge--success">Reg. Open</span>
                            }
                        </td>
                        <td>
                            @if (seasonResults.TryGetValue(reg.Season.Id, out var result))
                            {
                                <span style="color:var(--cal-success);font-weight:700">@result.WinCount W</span>
                                <span style="color:var(--cal-text-faint);margin:0 4px">/</span>
                                <span style="color:var(--cal-danger);font-weight:700">@result.LoseCount L</span>
                            }
                            else
                            {
                                <span style="color:var(--cal-text-faint)">—</span>
                            }
                        </td>
                        <td>@reg.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                        @if (isManager)
                        {
                            <td>
                                @if (reg.Season.RegistrationOpen)
                                {
                                    <form method="post" action="/api/seasons/@reg.Season.Id/unregister">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="teamId" value="@team.Id" />
                                        <button type="submit">Unregister</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Playoffs</h2>

    @if (playoffEntries.Count == 0)
    {
        <p>This team has not participated in any playoffs.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Playoff</th>
                    <th>Season</th>
                    <th>Seed</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in playoffEntries)
                {
                    <tr>
                        <td><a href="/playoffs/@entry.PlayoffId">@entry.Playoff.Name</a></td>
                        <td><a href="/seasons/@entry.Playoff.SeasonId">@entry.Playoff.Season.Name</a></td>
                        <td>@entry.Seed</td>
                        <td><span class="cal-badge @StatusBadgeClass(entry.Playoff.Status)">@entry.Playoff.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }

}

@code {
    private static string StatusBadgeClass(PlayoffStatus status) => status switch
    {
        PlayoffStatus.Active    => "cal-badge--magenta",
        PlayoffStatus.Upcoming  => "cal-badge--warning",
        PlayoffStatus.Completed => "",
        _                       => "",
    };

    [Parameter] public long Id { get; set; }

    private Bloodsport.Entity.Database.Team? team;
    private List<TeamInvite> pendingInvites = [];
    private List<SeasonWeekMatchup> matchups = [];
    private Dictionary<long, TeamSeasonResult> seasonResults = [];
    private List<PlayoffTeam> playoffEntries = [];
    private bool notFound;
    private bool isManager;
    private string? inviteError;
    private bool inviteSent;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("invite_sent", out _))
            inviteSent = true;

        if (query.TryGetValue("invite_error", out var errorCode))
        {
            inviteError = (string?)errorCode switch
            {
                "invalid_input"    => "Please enter both a Game Name and Tag.",
                "account_not_found" => "No linked Riot account found with that Game Name and Tag.",
                "already_member"   => "That Riot account is already a member of this team.",
                "already_invited"  => "That Riot account already has a pending invite.",
                "roster_full"      => "This team already has the maximum of 7 members.",
                _                  => "An unknown error occurred. Please try again.",
            };
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        team = await db.Teams
            .Include(t => t.Manager)
            .Include(t => t.TeamMemberships)
                .ThenInclude(m => m.RiotAccount)
                    .ThenInclude(r => r.User)
            .Include(t => t.SeasonRegistrations)
                .ThenInclude(r => r.Season)
            .FirstOrDefaultAsync(t => t.Id == Id);

        if (team is not null)
        {
            seasonResults = await db.TeamSeasonResults
                .Where(r => r.TeamId == Id)
                .ToDictionaryAsync(r => r.SeasonId);

            playoffEntries = await db.PlayoffTeams
                .Include(pt => pt.Playoff)
                    .ThenInclude(p => p.Season)
                .Where(pt => pt.TeamId == Id)
                .OrderByDescending(pt => pt.Playoff.DateCreated)
                .ToListAsync();
        }

        if (team is null)
        {
            notFound = true;
            return;
        }

        matchups = await db.SeasonWeekMatchups
            .Include(m => m.TeamOne)
            .Include(m => m.TeamTwo)
            .Include(m => m.SeasonWeek)
                .ThenInclude(w => w.Season)
            .Where(m => m.TeamOneId == Id || m.TeamTwoId == Id)
            .OrderByDescending(m => m.SeasonWeek.Season.EstimatedDateStart)
                .ThenBy(m => m.SeasonWeek.Index)
            .ToListAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            isManager = team.Manager.EntraObjectId == oid;

            if (isManager)
            {
                pendingInvites = await db.TeamInvites
                    .Include(i => i.RiotAccount)
                    .Where(i => i.TeamId == Id && i.Status == TeamInviteStatus.Pending)
                    .OrderByDescending(i => i.DateCreated)
                    .ToListAsync();
            }
        }
    }
}
