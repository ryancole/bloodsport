@page "/teams/{id:long}/edit"
@attribute [Authorize]
@using Bloodsport.Data.Sql
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject BloodsportSite.Services.BlobSasService BlobSasService


<PageTitle>Edit Team | CAL</PageTitle>

<h1 class="page-title mb-6">Edit Team</h1>

@if (notFound)
{
    <p class="text-sm text-gray-500">Team not found.</p>
}
else if (team is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    @if (error is not null)
    {
        <div class="alert alert-danger mb-4 max-w-md">@error</div>
    }

    <form method="post" action="/api/teams/@team.Id/edit" enctype="multipart/form-data" class="max-w-md space-y-4">
        <AntiforgeryToken />
        <div>
            <label class="label">Team Name</label>
            <input type="text" name="name" value="@team.Name" required autofocus class="input" />
        </div>
        <div>
            <label class="label">Team Logo</label>
            @if (team.LogoUrl is not null)
            {
                <div class="mb-2">
                    <img src="@BlobSasService.GetSasUrl(team.LogoUrl)" alt="Current team logo" class="max-h-20 max-w-[200px] rounded-[2px] object-contain ring-1 ring-black/20" />
                </div>
            }
            <input type="file" name="logo" accept="image/jpeg,image/png,image/gif,image/webp" class="block text-sm text-gray-600" />
            <div class="mt-1 text-xs text-gray-400">PNG, JPG, GIF, or WebP. Max 5 MB.</div>
        </div>
        <div class="flex items-center gap-3">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/teams" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
}

@code {
    [Parameter] public long Id { get; set; }

    private Bloodsport.Entity.Database.Team? team;
    private bool notFound;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var errorCode))
        {
            error = (string?)errorCode switch
            {
                "invalid_name" => "Please enter a team name.",
                "invalid_logo" => "The logo must be a PNG, JPG, GIF, or WebP image.",
                "logo_too_large" => "The logo must be under 5 MB.",
                _ => "An unknown error occurred. Please try again.",
            };
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is null)
        {
            NavigationManager.NavigateTo("/teams");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);

        if (user is null)
        {
            NavigationManager.NavigateTo("/teams");
            return;
        }

        team = await db.Teams.FirstOrDefaultAsync(t => t.Id == Id && t.ManagerId == user.Id);

        if (team is null)
            notFound = true;
    }
}
