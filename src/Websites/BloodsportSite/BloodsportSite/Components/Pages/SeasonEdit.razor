@page "/seasons/{id:long}/edit"
@attribute [Authorize(Roles = "Champions.Admin")]
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Camille.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Edit Season | BSAL</PageTitle>

@if (notFound)
{
    <p class="text-sm text-gray-500">Season not found.</p>
}
else if (season is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    <h1 class="page-title mb-6">Edit — @season.Name</h1>

    <form method="post" action="/api/seasons/@season.Id/edit" class="max-w-md space-y-4">
        <AntiforgeryToken />
        <div>
            <label class="label">Status</label>
            <select name="status" class="input">
                @foreach (var value in Enum.GetValues<SeasonStatus>())
                {
                    if (value == season.Status)
                    {
                        <option value="@((int)value)" selected>@value</option>
                    }
                    else
                    {
                        <option value="@((int)value)">@value</option>
                    }
                }
            </select>
        </div>
        <div>
            <label class="label">Riot Region</label>
            <select name="riotRegion" class="input">
                @foreach (var value in Enum.GetValues<TournamentRegion>())
                {
                    if (value.ToString() == season.RiotRegion)
                    {
                        <option value="@value" selected>@value</option>
                    }
                    else
                    {
                        <option value="@value">@value</option>
                    }
                }
            </select>
        </div>
        <div class="flex items-center gap-2">
            <input type="checkbox" name="registrationOpen" value="true"
                   id="registrationOpen" checked="@season.RegistrationOpen" class="h-4 w-4 rounded border-gray-300" />
            <label for="registrationOpen" class="text-sm text-gray-700">Registration open</label>
        </div>
        <div>
            <label class="label">Estimated Start Date <span class="font-normal text-gray-400">(optional)</span></label>
            <input type="date" name="startDate" class="input"
                   value="@(season.EstimatedDateStart?.ToString("yyyy-MM-dd"))" />
        </div>

        <h2 class="text-lg font-semibold pt-2">Matchup Settings</h2>
        <div>
            <label class="label">Team Size</label>
            <select name="teamSize" class="input">
                @for (int i = 1; i <= 5; i++)
                {
                    <option value="@i" selected="@(i == teamSize)">@i</option>
                }
            </select>
        </div>
        <div>
            <label class="label">Pick Type</label>
            <select name="pickType" class="input">
                @foreach (var value in SeasonMatchupParameters.PickTypes)
                {
                    <option value="@value" selected="@(value == pickType)">@value</option>
                }
            </select>
        </div>
        <div>
            <label class="label">Map Type</label>
            <select name="mapType" class="input">
                @foreach (var value in SeasonMatchupParameters.MapTypes)
                {
                    <option value="@value" selected="@(value == mapType)">@value</option>
                }
            </select>
        </div>
        <div>
            <label class="label">Spectator Type</label>
            <select name="spectatorType" class="input">
                @foreach (var value in SeasonMatchupParameters.SpectatorTypes)
                {
                    <option value="@value" selected="@(value == spectatorType)">@value</option>
                }
            </select>
        </div>
        <div class="flex items-center gap-2">
            <input type="checkbox" name="enoughPlayers" value="true"
                   id="enoughPlayers" checked="@enoughPlayers" class="h-4 w-4 rounded border-gray-300" />
            <label for="enoughPlayers" class="text-sm text-gray-700">Require enough players to fill teams</label>
        </div>

        <div class="flex items-center gap-3">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/seasons/@season.Id" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
}

@code {
    [Parameter] public long Id { get; set; }

    private Season? season;
    private bool notFound;

    // Current matchup parameter values, falling back to defaults when a season
    // predates the parameters table.
    private int teamSize = 5;
    private string pickType = "TOURNAMENT_DRAFT";
    private string mapType = "SUMMONERS_RIFT";
    private string spectatorType = "ALL";
    private bool enoughPlayers;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        season = await db.Seasons
            .Include(s => s.MatchupParameters)
            .FirstOrDefaultAsync(s => s.Id == Id);

        if (season is null)
        {
            notFound = true;
            return;
        }

        if (season.MatchupParameters is { } parameters)
        {
            teamSize = parameters.TeamSize;
            pickType = parameters.PickType;
            mapType = parameters.MapType;
            spectatorType = parameters.SpectatorType;
            enoughPlayers = parameters.EnoughPlayers;
        }
    }
}
