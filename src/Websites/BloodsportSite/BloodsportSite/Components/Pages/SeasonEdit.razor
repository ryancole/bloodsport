@page "/seasons/{id:long}/edit"
@attribute [Authorize(Roles = "Champions.Admin")]
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Edit Season | BSAL</PageTitle>

@if (notFound)
{
    <p>Season not found.</p>
}
else if (season is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Edit — @season.Name</h1>

    <form method="post" action="/api/seasons/@season.Id/edit">
        <AntiforgeryToken />
        <div style="max-width: 400px;">
            <label>Status</label>
            <select name="status">
                @foreach (var value in Enum.GetValues<SeasonStatus>())
                {
                    if (value == season.Status)
                    {
                        <option value="@((int)value)" selected>@value</option>
                    }
                    else
                    {
                        <option value="@((int)value)">@value</option>
                    }
                }
            </select>
        </div>
        <div>
            <div>
                <input type="checkbox" name="registrationOpen" value="true"
                       id="registrationOpen" checked="@season.RegistrationOpen" />
                <label for="registrationOpen">
                    Registration open
                </label>
            </div>
        </div>
        <div style="max-width: 400px;">
            <label>Estimated Start Date <span>(optional)</span></label>
            <input type="date" name="startDate"
                   value="@(season.EstimatedDateStart?.ToString("yyyy-MM-dd"))" />
        </div>
        <div>
            <button type="submit">Save</button>
            <a href="/seasons/@season.Id">Cancel</a>
        </div>
    </form>
}

@code {
    [Parameter] public long Id { get; set; }

    private Season? season;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        season = await db.Seasons.FirstOrDefaultAsync(s => s.Id == Id);

        if (season is null)
            notFound = true;
    }
}
