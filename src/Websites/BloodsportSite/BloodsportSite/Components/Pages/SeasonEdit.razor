@page "/seasons/{id:long}/edit"
@attribute [Authorize(Roles = "Bloodsport.Admin")]
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Edit Season</PageTitle>

@if (notFound)
{
    <p class="text-muted">Season not found.</p>
}
else if (season is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>Edit — @season.Name</h1>

    <form method="post" action="/api/seasons/@season.Id/edit" class="mt-3">
        <AntiforgeryToken />
        <div class="mb-3" style="max-width: 400px;">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                @foreach (var value in Enum.GetValues<SeasonStatus>())
                {
                    if (value == season.Status)
                    {
                        <option value="@((int)value)" selected>@value</option>
                    }
                    else
                    {
                        <option value="@((int)value)">@value</option>
                    }
                }
            </select>
        </div>
        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="registrationOpen" value="true"
                       id="registrationOpen" checked="@season.RegistrationOpen" />
                <label class="form-check-label" for="registrationOpen">
                    Registration open
                </label>
            </div>
        </div>
        <div class="mb-3" style="max-width: 400px;">
            <label class="form-label">Estimated Start Date <span class="text-muted">(optional)</span></label>
            <input type="date" name="startDate" class="form-control"
                   value="@(season.EstimatedDateStart?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/seasons/@season.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
}

@code {
    [Parameter] public long Id { get; set; }

    private Season? season;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        season = await db.Seasons.FirstOrDefaultAsync(s => s.Id == Id);

        if (season is null)
            notFound = true;
    }
}
