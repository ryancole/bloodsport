@page "/users/{id:long}"
@using Bloodsport.Data.Sql
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>@(user?.DisplayName ?? "User")</PageTitle>

@if (notFound)
{
    <p class="text-muted">User not found.</p>
}
else if (user is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1 class="mb-4">@user.DisplayName</h1>

    <dl class="row mb-4">
        <dt class="col-sm-3">Member Since</dt>
        <dd class="col-sm-9">@user.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</dd>
    </dl>

    <h2>Riot Accounts</h2>

    @if (user.RiotAccounts.Count == 0)
    {
        <p class="text-muted mb-4">No linked Riot accounts.</p>
    }
    else
    {
        <table class="table table-sm mb-4">
            <thead>
                <tr>
                    <th>Riot ID</th>
                    <th>Linked</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in user.RiotAccounts.OrderBy(a => a.GameName))
                {
                    <tr>
                        <td><a href="https://u.gg/lol/profile/na1/@Uri.EscapeDataString(account.GameName)-@Uri.EscapeDataString(account.TagLine)/overview" target="_blank" rel="noopener noreferrer"><strong>@account.GameName#@account.TagLine</strong></a></td>
                        <td>@account.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Managed Teams</h2>

    @if (user.ManagedTeams.Count == 0)
    {
        <p class="text-muted">No managed teams.</p>
    }
    else
    {
        <table class="table mb-4">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Members</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in user.ManagedTeams.OrderBy(t => t.Name))
                {
                    <tr>
                        <td><a href="/teams/@team.Id" class="d-flex align-items-center gap-2"><TeamFlag LogoUrl="@team.LogoUrl" />@team.Name</a></td>
                        <td>@team.TeamMemberships.Count</td>
                        <td>@team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Team Memberships</h2>

    @if (memberships.Count == 0)
    {
        <p class="text-muted">No team memberships.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Team</th>
                    <th>Riot ID</th>
                    <th>Joined</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var membership in memberships.OrderBy(m => m.Team.Name))
                {
                    <tr>
                        <td><a href="/teams/@membership.Team.Id" class="d-flex align-items-center gap-2"><TeamFlag LogoUrl="@membership.Team.LogoUrl" />@membership.Team.Name</a></td>
                        <td><a href="https://u.gg/lol/profile/na1/@Uri.EscapeDataString(membership.RiotAccount.GameName)-@Uri.EscapeDataString(membership.RiotAccount.TagLine)/overview" target="_blank" rel="noopener noreferrer"><strong>@membership.RiotAccount.GameName#@membership.RiotAccount.TagLine</strong></a></td>
                        <td>@membership.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public long Id { get; set; }

    private Bloodsport.Entity.Database.User? user;
    private List<Bloodsport.Entity.Database.TeamMembership> memberships = [];
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        user = await db.Users
            .Include(u => u.ManagedTeams)
                .ThenInclude(t => t.TeamMemberships)
            .Include(u => u.RiotAccounts)
                .ThenInclude(a => a.TeamMemberships)
                    .ThenInclude(m => m.Team)
            .FirstOrDefaultAsync(u => u.Id == Id);

        if (user is null)
        {
            notFound = true;
            return;
        }

        memberships = user.RiotAccounts.SelectMany(a => a.TeamMemberships).ToList();
    }
}
