@page "/users/{id:long}"
@using Bloodsport.Data.Sql
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject BloodsportSite.Services.BlobSasService BlobSasService

<PageTitle>@(user?.DisplayName ?? "User") | BSAL</PageTitle>

@if (notFound)
{
    <p class="text-sm text-gray-500">User not found.</p>
}
else if (user is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    <div class="mb-6 flex items-center gap-3">
        @if (user.LogoUrl is not null)
        {
            <img src="@BlobSasService.GetSasUrl(user.LogoUrl)" alt="@user.DisplayName logo" class="h-16 w-16 object-contain" />
        }
        <h1 class="page-title">@user.DisplayName</h1>
    </div>

    <dl class="mb-8 grid grid-cols-[120px_1fr] gap-y-2 text-sm">
        <dt class="font-medium text-gray-500">Member Since</dt>
        <dd class="text-gray-700">@user.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</dd>
    </dl>

    <h2 class="mb-3 text-lg font-semibold text-gray-900">Riot Accounts</h2>

    @if (user.RiotAccounts.Count == 0)
    {
        <p class="text-sm text-gray-500">No linked Riot accounts.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tbl">
                <thead>
                    <tr><th>Riot ID</th><th>Linked</th></tr>
                </thead>
                <tbody>
                    @foreach (var account in user.RiotAccounts.OrderBy(a => a.GameName))
                    {
                        <tr>
                            <td><a href="https://u.gg/lol/profile/na1/@Uri.EscapeDataString(account.GameName)-@Uri.EscapeDataString(account.TagLine)/overview" target="_blank" rel="noopener noreferrer" class="link"><strong>@account.GameName#@account.TagLine</strong></a></td>
                            <td>@account.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2 class="mb-3 mt-8 text-lg font-semibold text-gray-900">Teams</h2>

    @if (teamRows.Count == 0)
    {
        <p class="text-sm text-gray-500">No teams.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tbl">
                <thead>
                    <tr><th>Team</th><th>Role</th><th>Members</th><th>Created</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in teamRows)
                    {
                        <tr>
                            <td><a href="/teams/@row.Team.Id" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@row.Team.LogoUrl" />@row.Team.Name</a></td>
                            <td>@row.Role</td>
                            <td>@row.Team.TeamMemberships.Count</td>
                            <td>@row.Team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public long Id { get; set; }

    private Bloodsport.Entity.Database.User? user;
    private List<(Bloodsport.Entity.Database.Team Team, string Role)> teamRows = [];
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        user = await db.Users
            .Include(u => u.ManagedTeams)
                .ThenInclude(t => t.TeamMemberships)
            .Include(u => u.RiotAccounts)
                .ThenInclude(a => a.TeamMemberships)
                    .ThenInclude(m => m.Team)
                        .ThenInclude(t => t.TeamMemberships)
            .FirstOrDefaultAsync(u => u.Id == Id);

        if (user is null)
        {
            notFound = true;
            return;
        }

        var managedTeamIds = user.ManagedTeams.Select(t => t.Id).ToHashSet();
        var memberTeams = user.RiotAccounts.SelectMany(a => a.TeamMemberships).Select(m => m.Team).DistinctBy(t => t.Id);

        teamRows = memberTeams
            .Select(t => (Team: t, IsManager: managedTeamIds.Contains(t.Id), IsMember: true))
            .Concat(user.ManagedTeams
                .Where(t => !user.RiotAccounts.SelectMany(a => a.TeamMemberships).Any(m => m.Team.Id == t.Id))
                .Select(t => (Team: t, IsManager: true, IsMember: false)))
            .OrderBy(r => r.Team.Name)
            .Select(r => (r.Team, Role: r.IsManager && r.IsMember ? "Manager, Member" : r.IsManager ? "Manager" : "Member"))
            .ToList();
    }
}
