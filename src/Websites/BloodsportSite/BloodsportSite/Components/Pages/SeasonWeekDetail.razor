@page "/seasons/{seasonId:long}/weeks/{weekId:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>@(week?.Name ?? "Week") | BSAL</PageTitle>

@if (notFound)
{
    <p class="text-sm text-gray-500">Week not found.</p>
}
else if (week is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    <SectionContent SectionName="breadcrumbs">
        <nav><a href="/seasons" class="link">Seasons</a> / <a href="/seasons/@week.Season.Id" class="link">@week.Season.Name</a> / @week.Name</nav>
    </SectionContent>

    <div class="mb-6 flex flex-wrap items-baseline gap-3">
        <h1 class="page-title">@week.Name</h1>
        <span class="text-sm text-gray-500">@week.DateStart.ToLocalTime().ToString("MMMM d") – @week.DateEnd.ToLocalTime().ToString("MMMM d, yyyy")</span>
    </div>

    <h2 class="mb-3 section-title">Matchups</h2>

    @if (week.SeasonWeekMatchups.Count == 0)
    {
        <p class="text-sm text-gray-500">No matchups scheduled for this week.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tbl">
                <thead>
                    <tr><th>Matchup</th><th>Team One</th><th>Team Two</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var matchup in week.SeasonWeekMatchups.OrderByDescending(m => m.SeasonWeekMatchupResult != null))
                    {
                        var result = matchup.SeasonWeekMatchupResult;
                        <tr>
                            <td><a href="/seasons/@week.Season.Id/weeks/@week.Id/matchups/@matchup.Id" class="link">@matchup.Name</a></td>
                            <td><a href="/teams/@matchup.TeamOneId" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@matchup.TeamOne.LogoUrl" />@matchup.TeamOne.Name</a></td>
                            <td><a href="/teams/@matchup.TeamTwoId" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@matchup.TeamTwo.LogoUrl" />@matchup.TeamTwo.Name</a></td>
                            <td>
                                @if (result is not null)
                                {
                                    @if (result.DidNotPlay)
                                    {
                                        <Pill Color="PillColor.Gray">Did Not Play</Pill>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-2">
                                            <Pill Color="PillColor.Green">Final</Pill>
                                            <span class="text-gray-600">@result.WinnerTeam?.Name wins</span>
                                            @if (result.RosterMismatch)
                                            {
                                                <Pill Color="PillColor.Amber" Title="One or more players did not match the locked season roster">Roster Mismatch</Pill>
                                            }
                                        </span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public long SeasonId { get; set; }
    [Parameter] public long WeekId { get; set; }

    private SeasonWeek? week;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        week = await db.SeasonWeeks
            .Include(w => w.Season)
            .Include(w => w.SeasonWeekMatchups)
                .ThenInclude(m => m.TeamOne)
            .Include(w => w.SeasonWeekMatchups)
                .ThenInclude(m => m.TeamTwo)
            .Include(w => w.SeasonWeekMatchups)
                .ThenInclude(m => m.SeasonWeekMatchupResult)
                    .ThenInclude(r => r.WinnerTeam)
            .FirstOrDefaultAsync(w => w.Id == WeekId && w.SeasonId == SeasonId);

        if (week is null)
            notFound = true;
    }
}
