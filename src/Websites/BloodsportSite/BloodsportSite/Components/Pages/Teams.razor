@page "/teams"
@using Bloodsport.Data.Sql
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Teams</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Teams</h1>
    <AuthorizeView>
        <Authorized>
            <a href="/teams/create" class="btn btn-sm btn-primary">Create Team</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (teams is null)
{
    <p><em>Loading...</em></p>
}
else
{
    var filtered = string.IsNullOrWhiteSpace(Search)
        ? teams
        : teams.Where(t => t.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)).ToList();
    <TeamsTable Teams="filtered" CurrentPage="Page" Search="Search" />
}

@code {
    [SupplyParameterFromQuery(Name = "page")] public int Page { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }

    private List<Bloodsport.Entity.Database.Team>? teams;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        teams = await db.Teams
            .Include(t => t.Manager)
            .Include(t => t.TeamMemberships)
            .ToListAsync();
    }
}
