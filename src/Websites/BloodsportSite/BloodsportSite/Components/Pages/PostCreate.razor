@page "/news/create"
@attribute [Authorize(Roles = "Champions.Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager

<PageTitle>Create Post | BSAL</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css" />
</HeadContent>

<h1 class="page-title mb-6">Create Post</h1>

@if (error is not null)
{
    <div class="alert alert-danger mb-4 max-w-3xl">@error</div>
}

<form method="post" action="/api/posts/create" class="max-w-3xl space-y-4">
    <AntiforgeryToken />
    <div>
        <label class="label">Title</label>
        <input type="text" name="title" placeholder="Post title" required autofocus class="input" />
    </div>
    <div>
        <label class="label">Content</label>
        <textarea id="markdown-editor" name="markdown" class="input"></textarea>
    </div>
    <div class="flex items-center gap-3">
        <button type="submit" class="btn btn-primary">Publish</button>
        <a href="/news" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@code {
    private string? error;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var errorCode))
        {
            error = (string?)errorCode switch
            {
                "invalid_title"   => "Please enter a title.",
                "invalid_content" => "Please enter post content.",
                _                 => "An unknown error occurred. Please try again.",
            };
        }
    }
}
