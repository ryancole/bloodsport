@page "/news/create"
@attribute [Authorize(Roles = "Bloodsport.Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager

<PageTitle>Create Post | BSAL</PageTitle>

<h1>Create Post</h1>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<form method="post" action="/api/posts/create" class="mt-3">
    <AntiforgeryToken />
    <div class="mb-3" style="max-width: 600px;">
        <label class="form-label">Title</label>
        <input type="text" name="title" class="form-control" placeholder="Post title" required autofocus />
    </div>
    <div class="mb-3" style="max-width: 600px;">
        <label class="form-label">Content</label>
        <textarea name="markdown" class="form-control" rows="10" placeholder="Write your post content here..." required></textarea>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Publish</button>
        <a href="/news" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@code {
    private string? error;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var errorCode))
        {
            error = (string?)errorCode switch
            {
                "invalid_title"   => "Please enter a title.",
                "invalid_content" => "Please enter post content.",
                _                 => "An unknown error occurred. Please try again.",
            };
        }
    }
}
