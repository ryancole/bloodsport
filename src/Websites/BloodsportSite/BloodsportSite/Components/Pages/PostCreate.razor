@page "/news/create"
@attribute [Authorize(Roles = "Champions.Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager

<PageTitle>Create Post | BSAL</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css" />
</HeadContent>

<h1>Create Post</h1>

@if (error is not null)
{
    <div>@error</div>
}

<form method="post" action="/api/posts/create">
    <AntiforgeryToken />
    <div style="max-width: 700px;">
        <label>Title</label>
        <input type="text" name="title" placeholder="Post title" required autofocus />
    </div>
    <div style="max-width: 700px;">
        <label>Content</label>
        <textarea id="markdown-editor" name="markdown"></textarea>
    </div>
    <div>
        <button type="submit">Publish</button>
        <a href="/news">Cancel</a>
    </div>
</form>


@code {
    private string? error;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var errorCode))
        {
            error = (string?)errorCode switch
            {
                "invalid_title"   => "Please enter a title.",
                "invalid_content" => "Please enter post content.",
                _                 => "An unknown error occurred. Please try again.",
            };
        }
    }
}
