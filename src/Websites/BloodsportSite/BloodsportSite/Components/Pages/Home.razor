@page "/"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Dashboard | BSAL</PageTitle>

@if (seasons is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="dashboard-stat-row">
        <div class="dashboard-stat-card">
            <span class="dashboard-stat-label">Active seasons</span>
            <span class="dashboard-stat-value">@seasons.Count(s => s.Status == SeasonStatus.Active || s.Status == SeasonStatus.Upcoming)</span>
        </div>
        <div class="dashboard-stat-card">
            <span class="dashboard-stat-label">Active playoffs</span>
            <span class="dashboard-stat-value">@activePlayoffs.Count(p => p.Status == PlayoffStatus.Active)</span>
        </div>
        <div class="dashboard-stat-card">
            <span class="dashboard-stat-label">Results this week</span>
            <span class="dashboard-stat-value">@resultsThisWeek</span>
        </div>
    </div>

    <div class="dashboard-panels">
        <DashboardSeasonsPanel Seasons="seasons" />
        <DashboardPlayoffsPanel Playoffs="activePlayoffs" />
    </div>

    @if (recentPosts.Count > 0)
    {
        <div class="dashboard-feed-section mb-3">
            <h2 class="dashboard-panel-title">Latest news</h2>
            <div class="d-flex flex-column">
                @foreach (var post in recentPosts)
                {
                    <div class="dashboard-news-item">
                        <div class="d-flex align-items-baseline gap-2">
                            <a href="/news/@post.Id" class="dashboard-news-title">@post.Title</a>
                            <div class="dashboard-news-meta flex-shrink-0">
                                <span>@post.User.DisplayName</span>
                                <span>·</span>
                                <span>@post.DateCreated.ToString("MMM d, yyyy")</span>
                                <span>·</span>
                                <a href="/news/@post.Id#comments">@post.PostComments.Count @(post.PostComments.Count == 1 ? "comment" : "comments")</a>
                            </div>
                        </div>
                        <p class="dashboard-news-excerpt">@Excerpt(post.Markdown)</p>
                    </div>
                }
            </div>
            <div class="mt-2">
                <a href="/news" class="small">All news →</a>
            </div>
        </div>
    }

    <div class="dashboard-feed-section">
        <h2 class="dashboard-panel-title">Recent activity</h2>

        @if (activityFeed.Count == 0)
        {
            <p class="text-muted">No results yet.</p>
        }
        else
        {
            <div class="dashboard-feed">
                @foreach (var item in activityFeed)
                {
                    <div class="dashboard-feed-item">
                        <span class="badge @(item.IsPlayoff ? "dashboard-badge-playoff" : "dashboard-badge-regular") dashboard-feed-type">@(item.IsPlayoff ? "Playoff" : "Regular")</span>
                        <div class="dashboard-feed-winner-col">
                            @if (item.WinnerName is not null)
                            {
                                <a href="@item.WinnerUrl" class="dashboard-feed-winner d-inline-flex align-items-center gap-2">
                                    <TeamFlag LogoUrl="@item.WinnerLogoUrl" />
                                    @item.WinnerName
                                </a>
                            }
                            else
                            {
                                <span class="dashboard-feed-no-result">—</span>
                            }
                        </div>
                        <a href="@item.MatchupUrl" class="dashboard-feed-matchup">@item.MatchupName</a>
                        @if (item.ContextUrl is not null)
                        {
                            <a href="@item.ContextUrl" class="dashboard-feed-context">@item.Context</a>
                        }
                        else
                        {
                            <span class="dashboard-feed-context">@item.Context</span>
                        }
                        <span class="dashboard-feed-time" title="@item.Date.ToLocalTime().ToString("MMM d, yyyy h:mm tt")">@item.TimeAgo</span>
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    .dashboard-stat-row {
        display: flex;
        gap: 12px;
        margin-bottom: 1.5rem;
    }

    .dashboard-stat-card {
        flex: 1;
        background: var(--bs-tertiary-bg, #f8f9fa);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .dashboard-stat-label {
        font-size: 13px;
        color: var(--bs-secondary-color, #6c757d);
        font-weight: 500;
    }

    .dashboard-stat-value {
        font-size: 28px;
        font-weight: 500;
        line-height: 1.1;
    }

    .dashboard-panels {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .dashboard-panel {
        flex: 1;
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 8px;
        padding: 1rem 1.25rem;
    }

    .dashboard-panel-title {
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 0.75rem;
    }

    .dashboard-list-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 6px 0;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }

    .dashboard-list-item:last-child {
        border-bottom: none;
    }

    .dashboard-list-name {
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dashboard-list-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .dashboard-list-sub {
        font-size: 12px;
        color: var(--bs-secondary-color, #6c757d);
    }

    .dashboard-feed-section {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 8px;
        padding: 1rem 1.25rem;
    }

    .dashboard-feed {
        display: flex;
        flex-direction: column;
    }

    .dashboard-feed-item {
        display: grid;
        grid-template-columns: 70px 180px 1fr 160px 60px;
        align-items: center;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }

    .dashboard-feed-item:last-child {
        border-bottom: none;
    }

    .dashboard-feed-type {
        font-weight: 500;
        justify-self: start;
    }

    .dashboard-feed-winner-col {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }

    .dashboard-feed-winner {
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dashboard-feed-no-result {
        color: var(--bs-secondary-color, #6c757d);
    }

    .dashboard-feed-matchup {
        font-size: 13px;
        color: var(--bs-link-color, #0d6efd);
        text-decoration: none;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dashboard-feed-matchup:hover {
        text-decoration: underline;
    }

    .dashboard-feed-context {
        font-size: 12px;
        color: var(--bs-secondary-color, #6c757d);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-decoration: none;
    }

    a.dashboard-feed-context {
        color: var(--bs-link-color, #0d6efd);
    }

    a.dashboard-feed-context:hover {
        text-decoration: underline;
    }

    .dashboard-feed-time {
        font-size: 12px;
        color: var(--bs-secondary-color, #6c757d);
        text-align: right;
        white-space: nowrap;
        text-decoration: underline dotted;
        text-underline-offset: 3px;
        cursor: default;
    }

    .dashboard-news-item {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }

    .dashboard-news-item:last-child {
        border-bottom: none;
    }

    .dashboard-news-meta {
        display: flex;
        gap: 0.3rem;
        font-size: 12px;
        color: var(--bs-secondary-color, #6c757d);
    }

    .dashboard-news-title {
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        color: var(--bs-body-color, #212529);
        line-height: 1.3;
    }

    .dashboard-news-title:hover {
        color: #c0392b;
    }

    .dashboard-news-excerpt {
        margin: 0;
        font-size: 13px;
        color: #555;
        line-height: 1.5;
    }

    .dashboard-badge-regular {
        background-color: #E6F1FB;
        color: #185FA5;
        font-weight: 500;
    }

    .dashboard-badge-playoff {
        background-color: #EEEDFE;
        color: #3C3489;
        font-weight: 500;
    }
</style>

@code {
    private List<Season>? seasons;
    private List<Playoff> activePlayoffs = [];
    private List<ActivityItem> activityFeed = [];
    private List<Post> recentPosts = [];
    private int resultsThisWeek;

    private record ActivityItem(
        bool IsPlayoff,
        string MatchupName,
        string MatchupUrl,
        string? WinnerName,
        string? WinnerUrl,
        string? WinnerLogoUrl,
        string Context,
        string? ContextUrl,
        string TimeAgo,
        DateTime Date
    );

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        recentPosts = await db.Posts
            .Include(p => p.User)
            .Include(p => p.PostComments)
            .OrderByDescending(p => p.DateCreated)
            .Take(3)
            .ToListAsync();

        var sixMonthsAgo = DateTime.UtcNow.AddMonths(-6);
        var oneWeekAgo = DateTime.UtcNow.AddDays(-7);

        seasons = await db.Seasons
            .Where(s => s.Status == SeasonStatus.Active || s.Status == SeasonStatus.Upcoming || s.Status == SeasonStatus.PreSeason
                || s.DateCreated >= sixMonthsAgo)
            .OrderBy(s => s.Status)
            .ThenBy(s => s.Name)
            .ToListAsync();

        activePlayoffs = await db.Playoffs
            .Include(p => p.Season)
            .Include(p => p.PlayoffRounds)
            .Where(p => p.Status == PlayoffStatus.Active || p.Status == PlayoffStatus.Upcoming
                || p.DateCreated >= sixMonthsAgo)
            .OrderBy(p => p.Status)
            .ThenBy(p => p.Name)
            .ToListAsync();

        var regularResults = await db.SeasonWeekMatchupResults
            .Include(r => r.WinnerTeam)
            .Include(r => r.SeasonWeekMatchup)
                .ThenInclude(m => m.SeasonWeek)
                    .ThenInclude(w => w.Season)
            .OrderByDescending(r => r.DateCreated)
            .Take(10)
            .ToListAsync();

        var playoffResults = await db.PlayoffRoundMatchups
            .Where(m => m.PlayoffRoundMatchupResults.Any())
            .Include(m => m.PlayoffRoundMatchupResults)
                .ThenInclude(r => r.WinningTeam)
                    .ThenInclude(t => t!.Team)
            .Include(m => m.PlayoffRound)
                .ThenInclude(r => r.Playoff)
            .OrderByDescending(m => m.DateCreated)
            .Take(10)
            .ToListAsync();

        var regularThisWeek = await db.SeasonWeekMatchupResults
            .CountAsync(r => r.DateCreated >= oneWeekAgo);
        var playoffThisWeek = await db.PlayoffRoundMatchups
            .CountAsync(m => m.PlayoffRoundMatchupResults.Any() && m.DateCreated >= oneWeekAgo);
        resultsThisWeek = regularThisWeek + playoffThisWeek;

        var regularItems = regularResults.Select(r => new ActivityItem(
            IsPlayoff: false,
            MatchupName: r.SeasonWeekMatchup.Name,
            MatchupUrl: $"/seasons/{r.SeasonWeekMatchup.SeasonWeek.SeasonId}/weeks/{r.SeasonWeekMatchup.SeasonWeekId}/matchups/{r.SeasonWeekMatchupId}",
            WinnerName: r.WinnerTeam?.Name,
            WinnerUrl: r.WinnerTeamId is not null ? $"/teams/{r.WinnerTeamId}" : null,
            WinnerLogoUrl: r.WinnerTeam?.LogoUrl,
            Context: r.SeasonWeekMatchup.SeasonWeek.Season.Name,
            ContextUrl: $"/seasons/{r.SeasonWeekMatchup.SeasonWeek.SeasonId}",
            TimeAgo: FormatTimeAgo(r.DateCreated),
            Date: r.DateCreated
        ));

        var playoffItems = playoffResults.Select(m =>
        {
            var winner = m.PlayoffRoundMatchupResults.FirstOrDefault()?.WinningTeam;
            return new ActivityItem(
                IsPlayoff: true,
                MatchupName: m.Name,
                MatchupUrl: $"/playoffs/{m.PlayoffRound.PlayoffId}/matchups/{m.Id}",
                WinnerName: winner?.Team?.Name,
                WinnerUrl: winner is not null ? $"/teams/{winner.TeamId}" : null,
                WinnerLogoUrl: winner?.Team?.LogoUrl,
                Context: m.PlayoffRound.Playoff.Name,
                ContextUrl: $"/playoffs/{m.PlayoffRound.PlayoffId}",
                TimeAgo: FormatTimeAgo(m.DateCreated),
                Date: m.DateCreated
            );
        });

        activityFeed = regularItems.Concat(playoffItems)
            .OrderByDescending(i => i.Date)
            .Take(10)
            .ToList();
    }

    private static string Excerpt(string markdown, int maxLength = 160)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(markdown, @"[#*_~`>\[\]!]|(\[.*?\]\(.*?\))", " ");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        return text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "…";
    }

    private static string FormatTimeAgo(DateTime utcDate)
    {
        var diff = DateTime.UtcNow - utcDate;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return utcDate.ToLocalTime().ToString("MMM d");
    }
}
