@page "/"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Dashboard | CAL</PageTitle>

@if (seasons is null)
{
    <div class="flex items-center justify-center py-16">
        <span class="text-sm text-gray-500">Loading...</span>
    </div>
}
else
{
    <div class="space-y-6">
        <!-- stat row -->
        <div class="grid grid-cols-3 gap-3 sm:flex sm:flex-row sm:justify-center sm:gap-4">
            <div class="rounded-xl bg-sky-50 p-3 text-center sm:w-44 sm:p-5">
                <span class="block text-3xl font-bold text-sky-900">@seasons.Count(s => s.Status == SeasonStatus.Active || s.Status == SeasonStatus.Upcoming)</span>
                <span class="text-sm font-medium text-sky-700">Active seasons</span>
            </div>
            <div class="rounded-xl bg-amber-50 p-3 text-center sm:w-44 sm:p-5">
                <span class="block text-3xl font-bold text-amber-900">@activePlayoffs.Count(p => p.Status == PlayoffStatus.Active)</span>
                <span class="text-sm font-medium text-amber-700">Active playoffs</span>
            </div>
            <div class="rounded-xl bg-emerald-50 p-3 text-center sm:w-44 sm:p-5">
                <span class="block text-3xl font-bold text-emerald-900">@resultsThisWeek</span>
                <span class="text-sm font-medium text-emerald-700">Results this week</span>
            </div>
        </div>

        <!-- seasons + playoffs panels -->
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <DashboardSeasonsPanel Seasons="seasons" />
            <DashboardPlayoffsPanel Playoffs="activePlayoffs" />
        </div>

        <!-- news -->
        @if (recentPosts.Count > 0)
        {
            <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
                <div class="mb-4 flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Latest news</span>
                    <a href="/news" class="text-sm text-sky-600 no-underline hover:text-sky-700">All →</a>
                </div>
                <div class="divide-y divide-gray-100">
                    @foreach (var post in recentPosts)
                    {
                        <div class="py-3 first:pt-0 last:pb-0">
                            <div class="flex flex-wrap items-center gap-2 text-xs text-gray-400">
                                <span>@post.User.DisplayName</span>
                                <span>·</span>
                                <span>@post.DateCreated.ToString("MMM d, yyyy")</span>
                                <span>·</span>
                                <a href="/news/@post.Id#comments" class="text-sky-600 no-underline hover:text-sky-700">@post.PostComments.Count @(post.PostComments.Count == 1 ? "comment" : "comments")</a>
                            </div>
                            <a href="/news/@post.Id" class="mt-1 block text-lg font-semibold text-gray-900 no-underline hover:text-sky-600">@post.Title</a>
                            <p class="mt-1 text-sm text-gray-600">@Excerpt(post.Markdown)</p>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- activity feed -->
        <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <div class="mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Recent matchups</span>
            </div>
            @if (activityFeed.Count == 0)
            {
                <p class="text-sm text-gray-500">No results yet.</p>
            }
            else
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var item in activityFeed)
                    {
                        @* Mobile: pill (icon-only) + matchup name on the left, time-ago pushed right; winner and context hidden until sm. *@
                        <div class="flex items-center gap-3 py-2 text-sm sm:flex-wrap">
                            <div class="flex min-w-0 items-center gap-3">
                                <Pill Color="@(item.IsPlayoff ? PillColor.Amber : PillColor.Sky)" IconPath="@(item.IsPlayoff ? PlayoffIcon : RegularIcon)">@(item.IsPlayoff ? "Playoff" : "Regular")</Pill>
                                <div class="hidden min-w-0 sm:block">
                                    @if (item.WinnerName is not null)
                                    {
                                        <a href="@item.WinnerUrl" class="inline-flex items-center gap-2 font-medium text-gray-900 no-underline hover:text-sky-600">
                                            <TeamFlag LogoUrl="@item.WinnerLogoUrl" />
                                            @item.WinnerName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">—</span>
                                    }
                                </div>
                            </div>
                            <a href="@item.MatchupUrl" class="font-medium whitespace-nowrap text-gray-900 no-underline hover:text-sky-600">@item.MatchupName</a>
                            <div class="ml-auto flex items-center gap-3 text-gray-500">
                                @if (item.ContextUrl is not null)
                                {
                                    <a href="@item.ContextUrl" class="hidden text-gray-500 no-underline hover:text-sky-600 sm:inline">@item.Context</a>
                                }
                                else
                                {
                                    <span class="hidden sm:inline">@item.Context</span>
                                }
                                <span class="text-xs text-gray-400" title="@item.Date.ToLocalTime().ToString("MMM d, yyyy h:mm tt")">@item.TimeAgo</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}


@code {
    private List<Season>? seasons;
    private List<Playoff> activePlayoffs = [];
    private List<ActivityItem> activityFeed = [];
    private List<Post> recentPosts = [];
    private int resultsThisWeek;

    // Heroicons (20/solid): star, calendar-days
    private const string PlayoffIcon = "M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z";
    private const string RegularIcon = "M5.75 2a.75.75 0 0 1 .75.75V4h7V2.75a.75.75 0 0 1 1.5 0V4h.25A2.75 2.75 0 0 1 18 6.75v8.5A2.75 2.75 0 0 1 15.25 18H4.75A2.75 2.75 0 0 1 2 15.25v-8.5A2.75 2.75 0 0 1 4.75 4H5V2.75A.75.75 0 0 1 5.75 2zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75z";

    private record ActivityItem(
        bool IsPlayoff,
        string MatchupName,
        string MatchupUrl,
        string? WinnerName,
        string? WinnerUrl,
        string? WinnerLogoUrl,
        string Context,
        string? ContextUrl,
        string TimeAgo,
        DateTime Date
    );

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        recentPosts = await db.Posts
            .Include(p => p.User)
            .Include(p => p.PostComments)
            .OrderByDescending(p => p.DateCreated)
            .Take(3)
            .ToListAsync();

        var sixMonthsAgo = DateTime.UtcNow.AddMonths(-6);
        var oneWeekAgo = DateTime.UtcNow.AddDays(-7);

        seasons = await db.Seasons
            .Where(s => s.Status == SeasonStatus.Active || s.Status == SeasonStatus.Upcoming || s.Status == SeasonStatus.PreSeason
                || s.DateCreated >= sixMonthsAgo)
            .OrderBy(s => s.Status)
            .ThenBy(s => s.Name)
            .ToListAsync();

        activePlayoffs = await db.Playoffs
            .Include(p => p.Season)
            .Include(p => p.PlayoffRounds)
            .Where(p => p.Status == PlayoffStatus.Active || p.Status == PlayoffStatus.Upcoming
                || p.DateCreated >= sixMonthsAgo)
            .OrderBy(p => p.Status)
            .ThenBy(p => p.Name)
            .ToListAsync();

        var regularResults = await db.SeasonWeekMatchupResults
            .Include(r => r.WinnerTeam)
            .Include(r => r.SeasonWeekMatchup)
                .ThenInclude(m => m.SeasonWeek)
                    .ThenInclude(w => w.Season)
            .OrderByDescending(r => r.DateCreated)
            .Take(10)
            .ToListAsync();

        var playoffResults = await db.PlayoffRoundMatchups
            .Where(m => m.PlayoffRoundMatchupResults.Any())
            .Include(m => m.PlayoffRoundMatchupResults)
                .ThenInclude(r => r.WinningTeam)
                    .ThenInclude(t => t!.Team)
            .Include(m => m.PlayoffRound)
                .ThenInclude(r => r.Playoff)
            .OrderByDescending(m => m.DateCreated)
            .Take(10)
            .ToListAsync();

        var regularThisWeek = await db.SeasonWeekMatchupResults
            .CountAsync(r => r.DateCreated >= oneWeekAgo);
        var playoffThisWeek = await db.PlayoffRoundMatchups
            .CountAsync(m => m.PlayoffRoundMatchupResults.Any() && m.DateCreated >= oneWeekAgo);
        resultsThisWeek = regularThisWeek + playoffThisWeek;

        var regularItems = regularResults.Select(r => new ActivityItem(
            IsPlayoff: false,
            MatchupName: r.SeasonWeekMatchup.Name,
            MatchupUrl: $"/seasons/{r.SeasonWeekMatchup.SeasonWeek.SeasonId}/weeks/{r.SeasonWeekMatchup.SeasonWeekId}/matchups/{r.SeasonWeekMatchupId}",
            WinnerName: r.WinnerTeam?.Name,
            WinnerUrl: r.WinnerTeamId is not null ? $"/teams/{r.WinnerTeamId}" : null,
            WinnerLogoUrl: r.WinnerTeam?.LogoUrl,
            Context: r.SeasonWeekMatchup.SeasonWeek.Season.Name,
            ContextUrl: $"/seasons/{r.SeasonWeekMatchup.SeasonWeek.SeasonId}",
            TimeAgo: FormatTimeAgo(r.DateCreated),
            Date: r.DateCreated
        ));

        var playoffItems = playoffResults.Select(m =>
        {
            var winner = m.PlayoffRoundMatchupResults.FirstOrDefault()?.WinningTeam;
            return new ActivityItem(
                IsPlayoff: true,
                MatchupName: m.Name,
                MatchupUrl: $"/playoffs/{m.PlayoffRound.PlayoffId}/matchups/{m.Id}",
                WinnerName: winner?.Team?.Name,
                WinnerUrl: winner is not null ? $"/teams/{winner.TeamId}" : null,
                WinnerLogoUrl: winner?.Team?.LogoUrl,
                Context: m.PlayoffRound.Playoff.Name,
                ContextUrl: $"/playoffs/{m.PlayoffRound.PlayoffId}",
                TimeAgo: FormatTimeAgo(m.DateCreated),
                Date: m.DateCreated
            );
        });

        activityFeed = regularItems.Concat(playoffItems)
            .OrderByDescending(i => i.Date)
            .Take(10)
            .ToList();
    }

    private static string Excerpt(string markdown, int maxLength = 160)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(markdown, @"[#*_~`>\[\]!]|(\[.*?\]\(.*?\))", " ");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        return text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "…";
    }

    private static string FormatTimeAgo(DateTime utcDate)
    {
        var diff = DateTime.UtcNow - utcDate;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return utcDate.ToLocalTime().ToString("MMM d");
    }
}
