@page "/"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Dashboard | BSAL</PageTitle>

@if (seasons is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex gap-4 align-items-start">
        <div style="flex: 1 1 0; min-width: 0;">
            <h2 class="mb-3">Seasons</h2>
            <SeasonsTable Seasons="seasons" />
        </div>
        <div style="flex: 1 1 0; min-width: 0;">
            <h2 class="mb-3">Playoffs</h2>
            <PlayoffsTable Playoffs="activePlayoffs" />
        </div>
    </div>

    <div class="d-flex gap-4 align-items-start mt-4">
        <div style="flex: 1 1 0; min-width: 0;">
            <h2 class="mb-3">Regular Season Matchup Results</h2>

            @if (recentResults.Count == 0)
            {
                <p class="text-muted">No results yet.</p>
            }
            else
            {
                <table class="table" style="table-layout:fixed;">
                    <thead>
                        <tr>
                            <th style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">Matchup</th>
                            <th style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">Winner</th>
                            <th style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in recentResults)
                        {
                            <tr>
                                <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@result.SeasonWeekMatchup.Name">
                                    <a href="/seasons/@result.SeasonWeekMatchup.SeasonWeek.SeasonId/weeks/@result.SeasonWeekMatchup.SeasonWeekId/matchups/@result.SeasonWeekMatchupId">
                                        @result.SeasonWeekMatchup.Name
                                    </a>
                                </td>
                                <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@(result.WinnerTeam?.Name ?? "Did Not Play")">
                                    @if (result.WinnerTeam is not null)
                                    {
                                        <a href="/teams/@result.WinnerTeamId" class="d-flex align-items-center gap-2"><TeamFlag LogoUrl="@result.WinnerTeam.LogoUrl" />@result.WinnerTeam.Name</a>
                                    }
                                    else
                                    {
                                        <span>Did Not Play</span>
                                    }
                                </td>
                                <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@result.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")">@result.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div style="flex: 1 1 0; min-width: 0;">
            <h2 class="mb-3">Playoff Matchup Results</h2>

            @if (recentPlayoffResults.Count == 0)
            {
                <p class="text-muted">No results yet.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Playoff</th>
                            <th>Round</th>
                            <th>Match</th>
                            <th>Winner</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var matchup in recentPlayoffResults)
                        {
                            <tr>
                                <td>
                                    <a href="/playoffs/@matchup.PlayoffRound.PlayoffId">
                                        @matchup.PlayoffRound.Playoff.Name
                                    </a>
                                </td>
                                <td>@matchup.PlayoffRound.Name</td>
                                <td>Match @matchup.MatchNumber</td>
                                <td>
                                    @if (matchup.WinningTeam is not null)
                                    {
                                        <a href="/teams/@matchup.WinningTeam.TeamId" class="d-flex align-items-center gap-2"><TeamFlag LogoUrl="@matchup.WinningTeam.Team.LogoUrl" />@matchup.WinningTeam.Team.Name</a>
                                    }
                                </td>
                                <td>@matchup.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private List<Season>? seasons;
    private List<Playoff> activePlayoffs = [];
    private List<SeasonWeekMatchupResult> recentResults = [];
    private List<PlayoffMatchup> recentPlayoffResults = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var sixMonthsAgo = DateTime.UtcNow.AddMonths(-6);

        seasons = await db.Seasons
            .Where(s => s.Status == SeasonStatus.Active || s.Status == SeasonStatus.Upcoming || s.Status == SeasonStatus.PreSeason
                || s.DateCreated >= sixMonthsAgo)
            .OrderBy(s => s.Status)
            .ThenBy(s => s.Name)
            .ToListAsync();

        activePlayoffs = await db.Playoffs
            .Include(p => p.Season)
            .Where(p => p.Status == PlayoffStatus.Active || p.Status == PlayoffStatus.Upcoming
                || p.DateCreated >= sixMonthsAgo)
            .OrderBy(p => p.Status)
            .ThenBy(p => p.Name)
            .ToListAsync();

        recentResults = await db.SeasonWeekMatchupResults
            .Include(r => r.WinnerTeam)
            .Include(r => r.SeasonWeekMatchup)
                .ThenInclude(m => m.SeasonWeek)
            .OrderByDescending(r => r.DateCreated)
            .Take(5)
            .ToListAsync();

        recentPlayoffResults = await db.PlayoffMatchups
            .Where(m => m.WinningTeamId != null)
            .Include(m => m.WinningTeam)
                .ThenInclude(t => t.Team)
            .Include(m => m.PlayoffRound)
                .ThenInclude(r => r.Playoff)
            .OrderByDescending(m => m.DateCreated)
            .Take(5)
            .ToListAsync();
    }

}
