@page "/"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Dashboard | CAL</PageTitle>

@if (seasons is null)
{
    <div class="db-loading">
        <span class="db-loading-text">Loading...</span>
    </div>
}
else
{
    <!-- stat row -->
    <div class="db-stat-row">
        <div class="db-stat-card">
            <div class="db-stat-keyline"></div>
            <span class="db-stat-num">@seasons.Count(s => s.Status == SeasonStatus.Active || s.Status == SeasonStatus.Upcoming)</span>
            <span class="db-stat-label">Active seasons</span>
        </div>
        <div class="db-stat-card">
            <div class="db-stat-keyline"></div>
            <span class="db-stat-num">@activePlayoffs.Count(p => p.Status == PlayoffStatus.Active)</span>
            <span class="db-stat-label">Active playoffs</span>
        </div>
        <div class="db-stat-card">
            <div class="db-stat-keyline"></div>
            <span class="db-stat-num">@resultsThisWeek</span>
            <span class="db-stat-label">Results this week</span>
        </div>
    </div>

    <!-- seasons + playoffs panels -->
    <div class="db-panels">
        <DashboardSeasonsPanel Seasons="seasons" />
        <DashboardPlayoffsPanel Playoffs="activePlayoffs" />
    </div>

    <!-- news -->
    @if (recentPosts.Count > 0)
    {
        <div class="db-card db-news mb">
            <div class="db-card-keyline"></div>
            <div class="db-card-head">
                <span class="db-eyebrow">Latest news</span>
                <a href="/news" class="db-see-all">All news →</a>
            </div>
            <div class="db-news-list">
                @foreach (var post in recentPosts)
                {
                    <div class="db-news-item">
                        <div class="db-news-meta">
                            <span class="db-news-author">@post.User.DisplayName</span>
                            <span class="db-sep">·</span>
                            <span>@post.DateCreated.ToString("MMM d, yyyy")</span>
                            <span class="db-sep">·</span>
                            <a href="/news/@post.Id#comments" class="db-news-comments">@post.PostComments.Count @(post.PostComments.Count == 1 ? "comment" : "comments")</a>
                        </div>
                        <a href="/news/@post.Id" class="db-news-title">@post.Title</a>
                        <p class="db-news-excerpt">@Excerpt(post.Markdown)</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- activity feed -->
    <div class="db-card db-activity">
        <div class="db-card-keyline"></div>
        <div class="db-card-head">
            <span class="db-eyebrow">Recent activity</span>
        </div>
        @if (activityFeed.Count == 0)
        {
            <p class="db-empty">No results yet.</p>
        }
        else
        {
            <div class="db-feed">
                @foreach (var item in activityFeed)
                {
                    <div class="db-feed-row">
                        <span class="db-feed-badge @(item.IsPlayoff ? "db-feed-badge--playoff" : "db-feed-badge--regular")">
                            @(item.IsPlayoff ? "Playoff" : "Regular")
                        </span>
                        <div class="db-feed-winner">
                            @if (item.WinnerName is not null)
                            {
                                <a href="@item.WinnerUrl" class="db-feed-winner-link">
                                    <TeamFlag LogoUrl="@item.WinnerLogoUrl" />
                                    @item.WinnerName
                                </a>
                            }
                            else
                            {
                                <span class="db-feed-no-result">—</span>
                            }
                        </div>
                        <a href="@item.MatchupUrl" class="db-feed-matchup">@item.MatchupName</a>
                        @if (item.ContextUrl is not null)
                        {
                            <a href="@item.ContextUrl" class="db-feed-context">@item.Context</a>
                        }
                        else
                        {
                            <span class="db-feed-context">@item.Context</span>
                        }
                        <span class="db-feed-time" title="@item.Date.ToLocalTime().ToString("MMM d, yyyy h:mm tt")">@item.TimeAgo</span>
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    /* ── layout ── */
    .db-loading {
        padding: 48px 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .db-loading-text {
        font-family: var(--cal-font-mono);
        font-size: 13px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--cal-text-faint);
    }

    /* ── stat row ── */
    .db-stat-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 14px;
    }
    .db-stat-card {
        background: var(--cal-surface-2);
        border: 1px solid var(--cal-border);
        border-radius: var(--cal-radius-lg);
        box-shadow: var(--cal-shadow-md), var(--cal-edge-top);
        padding: 24px 22px 20px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        position: relative;
        overflow: hidden;
    }
    .db-stat-keyline {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: var(--cal-gradient);
    }
    .db-stat-num {
        font-family: var(--cal-font-display);
        font-weight: 900;
        font-size: 44px;
        line-height: 1;
        letter-spacing: -0.02em;
        background: var(--cal-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .db-stat-label {
        font-family: var(--cal-font-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--cal-text-faint);
    }

    /* ── shared card ── */
    .db-card {
        background: var(--cal-surface-2);
        border: 1px solid var(--cal-border);
        border-radius: var(--cal-radius-lg);
        box-shadow: var(--cal-shadow-lg), var(--cal-edge-top);
        position: relative;
        overflow: hidden;
    }
    .db-card.mb { margin-bottom: 14px; }
    .db-card-keyline {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: var(--cal-gradient);
    }
    .db-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 20px 0;
    }
    .db-eyebrow {
        font-family: var(--cal-font-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--cal-text-faint);
    }
    .db-see-all {
        font-family: var(--cal-font-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--cal-cyan);
        text-decoration: none;
        transition: color var(--cal-dur) var(--cal-ease);
    }
    .db-see-all:hover { color: var(--cal-text); }
    .db-empty {
        padding: 20px;
        font-size: 14px;
        color: var(--cal-text-faint);
        margin: 0;
    }

    /* ── panels ── */
    .db-panels {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 14px;
    }

    /* ── news ── */
    .db-news-list { padding: 8px 0 4px; }
    .db-news-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--cal-border-faint);
    }
    .db-news-item:last-child { border-bottom: none; }
    .db-news-meta {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--cal-font-mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--cal-text-faint);
    }
    .db-news-author { color: var(--cal-text-muted); }
    .db-sep { opacity: 0.4; }
    .db-news-comments {
        color: var(--cal-text-faint);
        text-decoration: none;
        transition: color var(--cal-dur) var(--cal-ease);
    }
    .db-news-comments:hover { color: var(--cal-cyan); }
    .db-news-title {
        font-family: var(--cal-font-display);
        font-size: 15px;
        font-weight: 700;
        color: var(--cal-text);
        text-decoration: none;
        line-height: 1.3;
        transition: color var(--cal-dur) var(--cal-ease);
    }
    .db-news-title:hover { color: var(--cal-cyan); }
    .db-news-excerpt {
        font-size: 13px;
        color: var(--cal-text-muted);
        line-height: 1.55;
        margin: 0;
    }

    /* ── activity feed ── */
    .db-activity { margin-bottom: 14px; }
    .db-feed { padding: 8px 0 4px; }
    .db-feed-row {
        display: grid;
        grid-template-columns: 76px 176px 1fr 160px 60px;
        align-items: center;
        gap: 12px;
        padding: 9px 20px;
        border-bottom: 1px solid var(--cal-border-faint);
        transition: background var(--cal-dur-fast) var(--cal-ease);
    }
    .db-feed-row:last-child { border-bottom: none; }
    .db-feed-row:hover { background: var(--cal-surface-3); }
    .db-feed-badge {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: var(--cal-radius-pill);
        font-family: var(--cal-font-mono);
        font-weight: 600;
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .db-feed-badge--regular {
        background: var(--cal-cyan-ghost);
        color: var(--cal-cyan);
    }
    .db-feed-badge--playoff {
        background: var(--cal-magenta-ghost);
        color: var(--cal-magenta);
    }
    .db-feed-winner {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }
    .db-feed-winner-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 14px;
        font-weight: 600;
        color: var(--cal-text);
        text-decoration: none;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color var(--cal-dur) var(--cal-ease);
    }
    .db-feed-winner-link:hover { color: var(--cal-cyan); }
    .db-feed-no-result { color: var(--cal-text-faint); }
    .db-feed-matchup {
        font-size: 13px;
        color: var(--cal-text-muted);
        text-decoration: none;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color var(--cal-dur) var(--cal-ease);
    }
    .db-feed-matchup:hover { color: var(--cal-cyan); }
    .db-feed-context {
        font-family: var(--cal-font-mono);
        font-size: 11px;
        letter-spacing: 0.10em;
        color: var(--cal-text-faint);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-decoration: none;
        transition: color var(--cal-dur) var(--cal-ease);
    }
    a.db-feed-context:hover { color: var(--cal-text-muted); }
    .db-feed-time {
        font-family: var(--cal-font-mono);
        font-size: 11px;
        letter-spacing: 0.10em;
        color: var(--cal-text-faint);
        text-align: right;
        white-space: nowrap;
        cursor: default;
    }
</style>

@code {
    private List<Season>? seasons;
    private List<Playoff> activePlayoffs = [];
    private List<ActivityItem> activityFeed = [];
    private List<Post> recentPosts = [];
    private int resultsThisWeek;

    private record ActivityItem(
        bool IsPlayoff,
        string MatchupName,
        string MatchupUrl,
        string? WinnerName,
        string? WinnerUrl,
        string? WinnerLogoUrl,
        string Context,
        string? ContextUrl,
        string TimeAgo,
        DateTime Date
    );

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        recentPosts = await db.Posts
            .Include(p => p.User)
            .Include(p => p.PostComments)
            .OrderByDescending(p => p.DateCreated)
            .Take(3)
            .ToListAsync();

        var sixMonthsAgo = DateTime.UtcNow.AddMonths(-6);
        var oneWeekAgo = DateTime.UtcNow.AddDays(-7);

        seasons = await db.Seasons
            .Where(s => s.Status == SeasonStatus.Active || s.Status == SeasonStatus.Upcoming || s.Status == SeasonStatus.PreSeason
                || s.DateCreated >= sixMonthsAgo)
            .OrderBy(s => s.Status)
            .ThenBy(s => s.Name)
            .ToListAsync();

        activePlayoffs = await db.Playoffs
            .Include(p => p.Season)
            .Include(p => p.PlayoffRounds)
            .Where(p => p.Status == PlayoffStatus.Active || p.Status == PlayoffStatus.Upcoming
                || p.DateCreated >= sixMonthsAgo)
            .OrderBy(p => p.Status)
            .ThenBy(p => p.Name)
            .ToListAsync();

        var regularResults = await db.SeasonWeekMatchupResults
            .Include(r => r.WinnerTeam)
            .Include(r => r.SeasonWeekMatchup)
                .ThenInclude(m => m.SeasonWeek)
                    .ThenInclude(w => w.Season)
            .OrderByDescending(r => r.DateCreated)
            .Take(10)
            .ToListAsync();

        var playoffResults = await db.PlayoffRoundMatchups
            .Where(m => m.PlayoffRoundMatchupResults.Any())
            .Include(m => m.PlayoffRoundMatchupResults)
                .ThenInclude(r => r.WinningTeam)
                    .ThenInclude(t => t!.Team)
            .Include(m => m.PlayoffRound)
                .ThenInclude(r => r.Playoff)
            .OrderByDescending(m => m.DateCreated)
            .Take(10)
            .ToListAsync();

        var regularThisWeek = await db.SeasonWeekMatchupResults
            .CountAsync(r => r.DateCreated >= oneWeekAgo);
        var playoffThisWeek = await db.PlayoffRoundMatchups
            .CountAsync(m => m.PlayoffRoundMatchupResults.Any() && m.DateCreated >= oneWeekAgo);
        resultsThisWeek = regularThisWeek + playoffThisWeek;

        var regularItems = regularResults.Select(r => new ActivityItem(
            IsPlayoff: false,
            MatchupName: r.SeasonWeekMatchup.Name,
            MatchupUrl: $"/seasons/{r.SeasonWeekMatchup.SeasonWeek.SeasonId}/weeks/{r.SeasonWeekMatchup.SeasonWeekId}/matchups/{r.SeasonWeekMatchupId}",
            WinnerName: r.WinnerTeam?.Name,
            WinnerUrl: r.WinnerTeamId is not null ? $"/teams/{r.WinnerTeamId}" : null,
            WinnerLogoUrl: r.WinnerTeam?.LogoUrl,
            Context: r.SeasonWeekMatchup.SeasonWeek.Season.Name,
            ContextUrl: $"/seasons/{r.SeasonWeekMatchup.SeasonWeek.SeasonId}",
            TimeAgo: FormatTimeAgo(r.DateCreated),
            Date: r.DateCreated
        ));

        var playoffItems = playoffResults.Select(m =>
        {
            var winner = m.PlayoffRoundMatchupResults.FirstOrDefault()?.WinningTeam;
            return new ActivityItem(
                IsPlayoff: true,
                MatchupName: m.Name,
                MatchupUrl: $"/playoffs/{m.PlayoffRound.PlayoffId}/matchups/{m.Id}",
                WinnerName: winner?.Team?.Name,
                WinnerUrl: winner is not null ? $"/teams/{winner.TeamId}" : null,
                WinnerLogoUrl: winner?.Team?.LogoUrl,
                Context: m.PlayoffRound.Playoff.Name,
                ContextUrl: $"/playoffs/{m.PlayoffRound.PlayoffId}",
                TimeAgo: FormatTimeAgo(m.DateCreated),
                Date: m.DateCreated
            );
        });

        activityFeed = regularItems.Concat(playoffItems)
            .OrderByDescending(i => i.Date)
            .Take(10)
            .ToList();
    }

    private static string Excerpt(string markdown, int maxLength = 160)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(markdown, @"[#*_~`>\[\]!]|(\[.*?\]\(.*?\))", " ");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        return text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "…";
    }

    private static string FormatTimeAgo(DateTime utcDate)
    {
        var diff = DateTime.UtcNow - utcDate;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return utcDate.ToLocalTime().ToString("MMM d");
    }
}
