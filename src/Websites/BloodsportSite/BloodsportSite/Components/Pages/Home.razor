@page "/"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Dashboard</PageTitle>

<h1 class="mb-4">Dashboard</h1>

@if (seasons is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h2 class="mb-3">Seasons</h2>

    @if (seasons.Count == 0)
    {
        <p class="text-muted">No seasons yet.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-3 mb-5">
            @foreach (var season in seasons)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">
                                    <a href="/seasons/@season.Id">@season.Name</a>
                                </h5>
                                <div class="d-flex gap-1">
                                    <span class="badge @StatusBadgeClass(season.Status)">@season.Status</span>
                                    @if (season.RegistrationOpen)
                                    {
                                        <span class="badge bg-success">Registration Open</span>
                                    }
                                </div>
                            </div>
                            <p class="card-text text-muted small mb-2">
                                @(season.EstimatedDateStart?.ToLocalTime().ToString("MMMM d, yyyy") ?? "TBD") – @(season.EstimatedDateEnd?.ToLocalTime().ToString("MMMM d, yyyy") ?? "TBD")
                            </p>
                            <p class="card-text small">
                                <strong>@season.SeasonRegistrations.Count</strong> team@(season.SeasonRegistrations.Count == 1 ? "" : "s") registered
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h2 class="mb-3">Playoffs</h2>

    <PlayoffsTable Playoffs="activePlayoffs" />

    <h2 class="mb-3">Recent Results</h2>

    @if (recentResults.Count == 0)
    {
        <p class="text-muted">No results yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Season</th>
                    <th>Week</th>
                    <th>Matchup</th>
                    <th>Winner</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in recentResults)
                {
                    <tr>
                        <td>
                            <a href="/seasons/@result.SeasonWeekMatchup.SeasonWeek.SeasonId">
                                @result.SeasonWeekMatchup.SeasonWeek.Season.Name
                            </a>
                        </td>
                        <td>
                            <a href="/seasons/@result.SeasonWeekMatchup.SeasonWeek.SeasonId/weeks/@result.SeasonWeekMatchup.SeasonWeekId">
                                @result.SeasonWeekMatchup.SeasonWeek.Name
                            </a>
                        </td>
                        <td>
                            <a href="/seasons/@result.SeasonWeekMatchup.SeasonWeek.SeasonId/weeks/@result.SeasonWeekMatchup.SeasonWeekId/matchups/@result.SeasonWeekMatchupId">
                                @result.SeasonWeekMatchup.Name
                            </a>
                        </td>
                        <td>
                            @if (result.WinnerTeam is not null)
                            {
                                <a href="/teams/@result.WinnerTeamId">@result.WinnerTeam.Name</a>
                            }
                            else
                            {
                                <span>Did Not Play</span>
                            }
                        </td>
                        <td>@result.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<Season>? seasons;
    private List<Playoff> activePlayoffs = [];
    private List<SeasonWeekMatchupResult> recentResults = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        seasons = await db.Seasons
            .Include(s => s.SeasonRegistrations)
            .Where(s => s.Status == SeasonStatus.Active || s.Status == SeasonStatus.Upcoming || s.Status == SeasonStatus.PreSeason)
            .OrderBy(s => s.EstimatedDateStart)
            .ToListAsync();

        activePlayoffs = await db.Playoffs
            .Include(p => p.Season)
            .Include(p => p.PlayoffTeams)
            .Where(p => p.Status == PlayoffStatus.Active || p.Status == PlayoffStatus.Upcoming)
            .OrderByDescending(p => p.DateCreated)
            .ToListAsync();

        recentResults = await db.SeasonWeekMatchupResults
            .Include(r => r.WinnerTeam)
            .Include(r => r.SeasonWeekMatchup)
                .ThenInclude(m => m.SeasonWeek)
                    .ThenInclude(w => w.Season)
            .OrderByDescending(r => r.DateCreated)
            .Take(5)
            .ToListAsync();
    }

    private static string StatusBadgeClass(SeasonStatus status) => status switch
    {
        SeasonStatus.Active => "bg-primary",
        SeasonStatus.PreSeason => "bg-info text-dark",
        SeasonStatus.Upcoming => "bg-secondary",
        SeasonStatus.Completed => "bg-dark",
        _ => "bg-secondary"
    };
}
