@page "/news"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>News | BSAL</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">News</h1>
    <AuthorizeView Roles="Champions.Admin">
        <Authorized>
            <a href="/news/create" class="btn btn-sm btn-primary">Create Post</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (posts is null)
{
    <p><em>Loading...</em></p>
}
else if (posts.Count == 0)
{
    <p class="text-muted">No posts yet.</p>
}
else
{
    <div class="news-list">
        @foreach (var post in posts)
        {
            <article class="news-item">
                <a href="/news/@post.Id" class="news-item-title">@post.Title</a>
                <div class="news-item-meta">
                    <time>@post.DateCreated.ToString("MMMM d, yyyy")</time>
                    <span class="news-item-meta-sep">·</span>
                    <a href="/users/@post.User.Id">@post.User.DisplayName</a>
                    <span class="news-item-meta-sep">·</span>
                    <a href="/news/@post.Id#comments">@post.PostComments.Count @(post.PostComments.Count == 1 ? "comment" : "comments")</a>
                </div>
                <p class="news-item-excerpt">@Excerpt(post.Markdown)</p>
                <a href="/news/@post.Id" class="news-item-read-more">Read more →</a>
            </article>
        }
    </div>
}

@code {
    private List<Post>? posts;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        posts = await db.Posts
            .Include(p => p.User)
            .Include(p => p.PostComments)
            .OrderByDescending(p => p.DateCreated)
            .ToListAsync();
    }

    private static string Excerpt(string markdown, int maxLength = 200)
    {
        // Strip common Markdown syntax for a clean plain-text preview
        var text = System.Text.RegularExpressions.Regex.Replace(markdown, @"[#*_~`>\[\]!]|(\[.*?\]\(.*?\))", " ");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        return text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "…";
    }
}
