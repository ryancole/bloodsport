@page "/news"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>News | BSAL</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <h1 class="page-title">News</h1>
    <AuthorizeView Roles="Champions.Admin">
        <Authorized>
            <a href="/news/create" class="btn btn-primary">Create Post</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (posts is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else if (posts.Count == 0)
{
    <p class="text-sm text-gray-500">No posts yet.</p>
}
else
{
    <div class="mx-auto max-w-3xl divide-y divide-gray-100">
        @foreach (var post in posts)
        {
            <article class="py-6 first:pt-0">
                <a href="/news/@post.Id" class="text-xl font-semibold text-gray-900 no-underline hover:text-brand-600">@post.Title</a>
                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-gray-400">
                    <time>@post.DateCreated.ToString("MMMM d, yyyy")</time>
                    <span>·</span>
                    <a href="/users/@post.User.Id" class="link inline-flex items-center gap-1.5"><UserFlag LogoUrl="@post.User.LogoUrl" />@post.User.DisplayName</a>
                    <span>·</span>
                    <a href="/news/@post.Id#comments" class="link">@post.PostComments.Count @(post.PostComments.Count == 1 ? "comment" : "comments")</a>
                </div>
                <p class="mt-2 text-gray-600">@Excerpt(post.Markdown)</p>
                <a href="/news/@post.Id" class="mt-2 inline-block text-sm font-medium text-brand-600 no-underline hover:text-brand-700">Read more →</a>
            </article>
        }
    </div>
}

@code {
    private List<Post>? posts;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        posts = await db.Posts
            .Include(p => p.User)
            .Include(p => p.PostComments)
            .OrderByDescending(p => p.DateCreated)
            .ToListAsync();
    }

    private static string Excerpt(string markdown, int maxLength = 200)
    {
        var text = System.Text.RegularExpressions.Regex.Replace(markdown, @"[#*_~`>\[\]!]|(\[.*?\]\(.*?\))", " ");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        return text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "…";
    }
}
