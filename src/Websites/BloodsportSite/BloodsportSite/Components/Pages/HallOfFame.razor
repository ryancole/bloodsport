@page "/hall-of-fame"
@using BloodsportSite.Services
@inject CareerStatsService CareerStatsService

<PageTitle>Hall of Fame | CAL</PageTitle>

<h1 class="page-title mb-6">Hall of Fame</h1>

@if (champions is null || careers is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    @* ---- Record superlatives ---- *@
    <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Most Titles</span>
            @if (mostTitles is not null && mostTitles.Titles > 0)
            {
                <div class="mt-3 flex items-center gap-2">
                    <TeamFlag LogoUrl="@mostTitles.LogoUrl" />
                    <a href="/teams/@mostTitles.TeamId" class="font-semibold text-gray-900 no-underline hover:text-brand-600">@mostTitles.TeamName</a>
                </div>
                <p class="mt-1 text-2xl font-bold text-gray-900">@mostTitles.Titles <span class="text-sm font-normal text-gray-500">@(mostTitles.Titles == 1 ? "title" : "titles")</span></p>
            }
            else
            {
                <p class="mt-3 text-sm text-gray-400">No champions crowned yet.</p>
            }
        </div>

        <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Most All-Time Wins</span>
            @if (mostWins is not null && mostWins.RegularSeasonWins > 0)
            {
                <div class="mt-3 flex items-center gap-2">
                    <TeamFlag LogoUrl="@mostWins.LogoUrl" />
                    <a href="/teams/@mostWins.TeamId" class="font-semibold text-gray-900 no-underline hover:text-brand-600">@mostWins.TeamName</a>
                </div>
                <p class="mt-1 text-2xl font-bold text-gray-900">@mostWins.RegularSeasonWins <span class="text-sm font-normal text-gray-500">wins</span></p>
            }
            else
            {
                <p class="mt-3 text-sm text-gray-400">No games recorded yet.</p>
            }
        </div>

        <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Best Season</span>
            @if (bestSeason is not null && bestSeason.BestSeasonWins is > 0)
            {
                <div class="mt-3 flex items-center gap-2">
                    <TeamFlag LogoUrl="@bestSeason.LogoUrl" />
                    <a href="/teams/@bestSeason.TeamId" class="font-semibold text-gray-900 no-underline hover:text-brand-600">@bestSeason.TeamName</a>
                </div>
                <p class="mt-1 text-2xl font-bold text-gray-900">
                    @bestSeason.BestSeasonWins<span class="text-gray-400">–</span>@bestSeason.BestSeasonLosses
                    <span class="text-sm font-normal text-gray-500">@bestSeason.BestSeasonName</span>
                </p>
            }
            else
            {
                <p class="mt-3 text-sm text-gray-400">No seasons completed yet.</p>
            }
        </div>
    </div>

    @* ---- Champions roll ---- *@
    <h2 class="mb-3 section-title">Champions</h2>
    @if (champions.Count == 0)
    {
        <p class="mb-8 text-sm text-gray-500">No playoffs have been completed yet. Check back once a champion is crowned.</p>
    }
    else
    {
        <div class="mb-8 overflow-x-auto">
            <table class="tbl">
                <thead>
                    <tr><th>Playoff</th><th>Season</th><th>Champion</th><th>Runner-up</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in champions)
                    {
                        <tr>
                            <td><a href="/playoffs/@c.PlayoffId" class="link">@c.PlayoffName</a></td>
                            <td><a href="/seasons/@c.SeasonId" class="link">@c.SeasonName</a></td>
                            <td>
                                @if (c.ChampionTeamId is { } champId)
                                {
                                    <span class="inline-flex items-center gap-2">
                                        <Icon Path="@StatusIcons.Star" Class="h-4 w-4 text-amber-400" />
                                        <a href="/teams/@champId" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@c.ChampionLogoUrl" />@c.ChampionTeamName</a>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td>
                                @if (c.RunnerUpTeamId is { } runnerId)
                                {
                                    <a href="/teams/@runnerId" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@c.RunnerUpLogoUrl" />@c.RunnerUpTeamName</a>
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ---- All-time leaderboard ---- *@
    <div class="mb-3 flex items-baseline gap-2">
        <h2 class="section-title">All-Time Leaderboard</h2>
        @if (careers.Count > LeaderboardLimit)
        {
            <span class="text-sm text-gray-500">Top @LeaderboardLimit of @careers.Count teams</span>
        }
    </div>
    @if (careers.Count == 0)
    {
        <p class="text-sm text-gray-500">No team history recorded yet.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>#</th><th>Team</th><th>Titles</th><th>W</th><th>L</th><th>Win %</th><th>Seasons</th><th>Playoffs</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rank = 1; }
                    @foreach (var s in rankedCareers.Take(LeaderboardLimit))
                    {
                        <tr>
                            <td>
                                <span class="inline-flex h-6 w-6 items-center justify-center rounded-full text-xs font-bold text-black/70 ring-1 ring-black/10"
                                      style="background-color:@RankColor(rank)">@rank</span>
                            </td>
                            <td><a href="/teams/@s.TeamId" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@s.LogoUrl" />@s.TeamName</a></td>
                            <td>
                                @if (s.Titles > 0)
                                {
                                    <span class="inline-flex items-center gap-1 font-semibold text-amber-600">
                                        <Icon Path="@StatusIcons.Star" Class="h-3.5 w-3.5" />@s.Titles
                                    </span>
                                }
                                else
                                {
                                    <span class="text-gray-400">—</span>
                                }
                            </td>
                            <td class="font-semibold text-green-700">@s.RegularSeasonWins</td>
                            <td class="font-semibold text-red-700">@s.RegularSeasonLosses</td>
                            <td>@(s.WinPct is { } pct ? pct.ToString("P0") : "—")</td>
                            <td>@s.SeasonsPlayed</td>
                            <td>@s.PlayoffAppearances</td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const int LeaderboardLimit = 25;

    private List<ChampionRecord>? champions;
    private List<TeamCareerStats>? careers;

    private List<TeamCareerStats> rankedCareers = [];
    private TeamCareerStats? mostTitles;
    private TeamCareerStats? mostWins;
    private TeamCareerStats? bestSeason;

    protected override async Task OnInitializedAsync()
    {
        champions = await CareerStatsService.GetChampionsAsync();
        careers = await CareerStatsService.GetTeamCareerStatsAsync();

        rankedCareers = careers
            .OrderByDescending(s => s.Titles)
            .ThenByDescending(s => s.RegularSeasonWins)
            .ThenByDescending(s => s.WinPct ?? 0)
            .ThenBy(s => s.TeamName)
            .ToList();

        mostTitles = rankedCareers.FirstOrDefault();
        mostWins = careers.OrderByDescending(s => s.RegularSeasonWins).FirstOrDefault();
        bestSeason = careers
            .Where(s => s.BestSeasonWins is not null)
            .OrderByDescending(s => s.BestSeasonWins)
            .ThenBy(s => s.BestSeasonLosses ?? 0)
            .FirstOrDefault();
    }

    // Rank medal color: gold at #1 → silver at the middle → bronze at the bottom of the list.
    private static string RankColor(int rank)
    {
        var t = Math.Clamp((rank - 1) / (double)(LeaderboardLimit - 1), 0.0, 1.0);

        (int R, int G, int B) gold = (255, 209, 74);
        (int R, int G, int B) silver = (192, 196, 204);
        (int R, int G, int B) bronze = (176, 115, 59);

        // Two segments meeting at silver: gold→silver for the top half, silver→bronze for the bottom.
        var (from, to, local) = t < 0.5
            ? (gold, silver, t / 0.5)
            : (silver, bronze, (t - 0.5) / 0.5);

        int Lerp(int a, int b) => (int)Math.Round(a + (b - a) * local);

        return $"#{Lerp(from.R, to.R):X2}{Lerp(from.G, to.G):X2}{Lerp(from.B, to.B):X2}";
    }
}
