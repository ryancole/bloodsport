@page "/playoffs/{id:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>@(playoff?.Name ?? "Playoff")</PageTitle>

@if (notFound)
{
    <p class="text-muted">Playoff not found.</p>
}
else if (playoff is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <nav class="small mb-2">
        <a href="/playoffs">Playoffs</a> / @playoff.Name
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@playoff.Name</h1>
        <AuthorizeView Roles="Bloodsport.Admin">
            <Authorized>
                <div class="d-flex gap-2">
                    @if (playoff.PlayoffRounds.Count == 0)
                    {
                        <form method="post" action="/api/playoffs/@playoff.Id/build-bracket">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm btn-primary">Build Bracket</button>
                        </form>
                    }
                    @if (playoff.Status == PlayoffStatus.Upcoming)
                    {
                        <form method="post" action="/api/playoffs/@playoff.Id/start">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm btn-success">Start Playoff</button>
                        </form>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-2">Season</dt>
        <dd class="col-sm-10"><a href="/seasons/@playoff.SeasonId">@playoff.Season.Name</a></dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10"><span class="badge @StatusBadgeClass(playoff.Status)">@playoff.Status</span></dd>

        <dt class="col-sm-2">Teams</dt>
        <dd class="col-sm-10">@playoff.PlayoffTeams.Count</dd>

        <dt class="col-sm-2">Created</dt>
        <dd class="col-sm-10">@playoff.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</dd>
    </dl>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(ActiveTab == "bracket" ? "active" : "")" href="/playoffs/@playoff.Id?tab=bracket">Bracket</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ActiveTab == "teams" ? "active" : "")" href="/playoffs/@playoff.Id?tab=teams">Teams</a>
        </li>
    </ul>

    @if (ActiveTab == "teams")
    {
        <PlayoffTeamsTable PlayoffId="playoff.Id" Teams="playoff.PlayoffTeams" CurrentPage="CurrentPage" />
    }
    else
    {
        <PlayoffBracket Rounds="playoff.PlayoffRounds.ToList()" />
    }
}

@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery] private int teamsPage { get; set; }
    [SupplyParameterFromQuery] private string? tab { get; set; }
    private int CurrentPage => teamsPage < 1 ? 1 : teamsPage;
    private string ActiveTab => tab == "teams" ? "teams" : "bracket";

    private Playoff? playoff;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        playoff = await db.Playoffs
            .Include(p => p.Season)
            .Include(p => p.PlayoffTeams)
                .ThenInclude(pt => pt.Team)
            .Include(p => p.PlayoffRounds)
                .ThenInclude(r => r.PlayoffMatchups)
                    .ThenInclude(m => m.TeamOne)
                        .ThenInclude(pt => pt!.Team)
            .Include(p => p.PlayoffRounds)
                .ThenInclude(r => r.PlayoffMatchups)
                    .ThenInclude(m => m.TeamTwo)
                        .ThenInclude(pt => pt!.Team)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (playoff is null)
            notFound = true;
    }

    private static string StatusBadgeClass(PlayoffStatus status) => status switch
    {
        PlayoffStatus.Upcoming => "bg-secondary",
        PlayoffStatus.Active => "bg-success",
        PlayoffStatus.Completed => "bg-dark",
        _ => "bg-secondary"
    };
}
