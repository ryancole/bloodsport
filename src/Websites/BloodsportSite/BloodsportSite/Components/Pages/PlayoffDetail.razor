@page "/playoffs/{id:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(playoff?.Name ?? "Playoff") | BSAL</PageTitle>

@if (notFound)
{
    <p class="text-sm text-gray-500">Playoff not found.</p>
}
else if (playoff is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    <SectionContent SectionName="breadcrumbs">
        <nav><a href="/playoffs" class="link">Playoffs</a> / @playoff.Name</nav>
    </SectionContent>

    <div class="mb-6 flex items-center justify-between gap-4">
        <h1 class="page-title">@playoff.Name</h1>
        <AuthorizeView Roles="Champions.Admin">
            <Authorized>
                <div class="flex items-center gap-2">
                    @if (playoff.PlayoffRounds.Count == 0)
                    {
                        <form method="post" action="/api/playoffs/@playoff.Id/build-bracket" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-primary">Build Bracket</button>
                        </form>
                    }
                    @if (playoff.Status == PlayoffStatus.Upcoming)
                    {
                        <form method="post" action="/api/playoffs/@playoff.Id/start" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-primary">Start Playoff</button>
                        </form>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    <dl class="mb-6 grid grid-cols-[140px_1fr] gap-y-2 text-sm">
        <dt class="font-medium text-gray-500">Season</dt>
        <dd><a href="/seasons/@playoff.SeasonId" class="link">@playoff.Season.Name</a></dd>

        <dt class="font-medium text-gray-500">Status</dt>
        <dd><PlayoffStatusBadge Status="playoff.Status" /></dd>

        <dt class="font-medium text-gray-500">Region</dt>
        <dd class="text-gray-700">@playoff.RiotRegion</dd>

        <dt class="font-medium text-gray-500">Teams</dt>
        <dd class="text-gray-700">@playoff.PlayoffTeams.Count</dd>

        <dt class="font-medium text-gray-500">Created</dt>
        <dd class="text-gray-700">@playoff.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</dd>
    </dl>

    <MatchupSettingsCard Parameters="playoff.Season.MatchupParameters" CssClass="mb-6 max-w-md" />

    @if (grandFinalWinner is not null)
    {
        <div role="alert" class="alert alert-success mb-6 flex items-center gap-2">
            <span class="text-2xl">🏆</span>
            <span><strong>@grandFinalWinner.Team?.Name</strong> wins the @playoff.Name!</span>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
        <script>
            (function () {
                var end = Date.now() + 3000;
                var colors = ['#ffd700', '#ff4500', '#00bfff'];
                (function frame() {
                    confetti({ particleCount: 3, angle: 60, spread: 55, origin: { x: 0 }, colors: colors });
                    confetti({ particleCount: 3, angle: 120, spread: 55, origin: { x: 1 }, colors: colors });
                    if (Date.now() < end) requestAnimationFrame(frame);
                })();
            })();
        </script>
    }

    @if (playoff.PlayoffRounds.Any(r => r.DateEnd == null))
    {
        <div role="alert" class="alert alert-info mb-6">
            This playoff has not started yet. Round end dates will be available once the playoff begins.
        </div>
    }

    <div class="mb-6 border-b border-gray-200">
        <nav class="flex gap-1">
            <a href="/playoffs/@playoff.Id?tab=bracket" class="border-b-2 px-4 py-2 text-sm font-medium no-underline @(ActiveTab == "bracket" ? "border-sky-600 text-sky-700" : "border-transparent text-gray-500 hover:text-gray-800")">Bracket</a>
            <a href="/playoffs/@playoff.Id?tab=teams" class="border-b-2 px-4 py-2 text-sm font-medium no-underline @(ActiveTab == "teams" ? "border-sky-600 text-sky-700" : "border-transparent text-gray-500 hover:text-gray-800")">Teams</a>
        </nav>
    </div>

    @if (ActiveTab == "teams")
    {
        <PlayoffTeamsTable PlayoffId="playoff.Id" Teams="playoff.PlayoffTeams" CurrentPage="CurrentPage" />
    }
    else
    {
        <PlayoffBracket Rounds="playoff.PlayoffRounds.ToList()" PlayoffId="playoff.Id" MyTeamIds="myTeamIds" />
    }
}

@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery] private int teamsPage { get; set; }
    [SupplyParameterFromQuery] private string? tab { get; set; }
    private int CurrentPage => teamsPage < 1 ? 1 : teamsPage;
    private string ActiveTab => tab == "teams" ? "teams" : "bracket";

    private Playoff? playoff;
    private bool notFound;
    private HashSet<long> myTeamIds = [];

    private PlayoffTeam? grandFinalWinner => playoff?.PlayoffRounds
        .OrderBy(r => r.PlayoffMatchups.Count)
        .FirstOrDefault()
        ?.PlayoffMatchups
        .SingleOrDefault()
        ?.PlayoffRoundMatchupResults.FirstOrDefault()?.WinningTeam;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        playoff = await db.Playoffs
            .Include(p => p.Season)
                .ThenInclude(s => s.MatchupParameters)
            .Include(p => p.PlayoffTeams)
                .ThenInclude(pt => pt.Team)
            .Include(p => p.PlayoffRounds)
                .ThenInclude(r => r.PlayoffMatchups)
                    .ThenInclude(m => m.TeamOne)
                        .ThenInclude(pt => pt!.Team)
            .Include(p => p.PlayoffRounds)
                .ThenInclude(r => r.PlayoffMatchups)
                    .ThenInclude(m => m.TeamTwo)
                        .ThenInclude(pt => pt!.Team)
            .Include(p => p.PlayoffRounds)
                .ThenInclude(r => r.PlayoffMatchups)
                    .ThenInclude(m => m.PlayoffRoundMatchupResults)
                        .ThenInclude(r => r.WinningTeam)
                            .ThenInclude(pt => pt!.Team)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (playoff is null)
        {
            notFound = true;
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            var user = await db.Users
                .Include(u => u.ManagedTeams)
                .Include(u => u.RiotAccounts)
                    .ThenInclude(a => a.TeamMemberships)
                .FirstOrDefaultAsync(u => u.EntraObjectId == oid);

            if (user is not null)
            {
                myTeamIds = user.ManagedTeams.Select(t => t.Id)
                    .Concat(user.RiotAccounts.SelectMany(a => a.TeamMemberships).Select(m => m.TeamId))
                    .ToHashSet();
            }
        }
    }
}
