@page "/seasons"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Seasons | BSAL</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <h1 class="page-title">Seasons</h1>
    <AuthorizeView Roles="Champions.Admin">
        <Authorized>
            <a href="/seasons/create" class="btn btn-primary">Create Season</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (seasons is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    <h2 class="mb-3 text-lg font-semibold text-gray-900">Active Seasons</h2>
    <SeasonsTable Seasons="activeSeasons" />

    <h2 class="mb-3 mt-8 text-lg font-semibold text-gray-900">Past Seasons</h2>
    <SeasonsTable Seasons="pastSeasons" />
}

@code {
    private List<Season>? seasons;
    private List<Season> activeSeasons = [];
    private List<Season> pastSeasons = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        seasons = await db.Seasons
            .Include(s => s.SeasonRegistrations)
            .OrderByDescending(s => s.DateCreated)
            .ToListAsync();

        activeSeasons = seasons.Where(s => s.Status != SeasonStatus.Completed).ToList();
        pastSeasons = seasons.Where(s => s.Status == SeasonStatus.Completed).ToList();
    }
}
