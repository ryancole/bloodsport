@page "/seasons"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory

<PageTitle>Seasons</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Seasons</h1>
    <AuthorizeView Roles="Bloodsport.Admin">
        <Authorized>
            <a href="/seasons/create" class="btn btn-sm btn-primary">Create Season</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (seasons is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <SeasonsTable Seasons="seasons" />
}

@code {
    private List<Season>? seasons;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        seasons = await db.Seasons
            .Include(s => s.SeasonRegistrations)
            .OrderByDescending(s => s.DateCreated)
            .ToListAsync();
    }
}
