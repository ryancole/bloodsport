@page "/about"
@using System.Globalization
@using BloodsportSite.Services
@inject CostService CostService

<PageTitle>About | BSAL</PageTitle>

<h1 class="page-title mb-6">About</h1>

<div class="doc">
<div class="mb-8 flex flex-wrap justify-center gap-6">
    <img src="image/about/01-join-a-team.svg" class="w-full max-w-[200px] rounded-[14px]"
         alt="Join a team — lock in a roster with friends or find open spots on squads looking for players." />
    <img src="image/about/02-compete-all-season.svg" class="w-full max-w-[200px] rounded-[14px]"
         alt="Compete all season — play a full schedule of weekly matchups with standings tracked automatically." />
    <img src="image/about/03-climb-the-bracket.svg" class="w-full max-w-[200px] rounded-[14px]"
         alt="Climb the bracket — qualify for single-elimination playoffs and battle your way to the championship." />
</div>

<section>
    <p>
        The Champions Amateur League (CAL) is a community-run competitive League of Legends
        league built for amateur players who want structured, meaningful matches. Teams register
        for a season, lock in their rosters, and battle through a full regular season and playoff
        bracket to crown a champion.
    </p>
    <p>
        Everything is organized around real matches played in custom tournament lobbies. Results,
        standings, and playoff brackets are tracked automatically so teams can focus on playing
        rather than paperwork.
    </p>
</section>

<section>
    <h2 class="section-title">What we offer</h2>
    <ul class="list-disc space-y-1 pl-10 leading-relaxed marker:text-gray-400">
        <li>Season-long regular play with a full schedule of weekly matchups.</li>
        <li>A single-elimination playoff bracket for qualifying teams.</li>
        <li>Automatic result tracking, standings, and seeding tiebreakers.</li>
        <li>Team and player profiles with custom logos.</li>
    </ul>
</section>

<section>
    <h2 class="section-title">Get involved</h2>
    <p>
        New to the league? Take a look at the <a href="/format">Format</a> to see how seasons and
        playoffs are structured, and read the <a href="/rules">Rules</a> before registering a team.
        Browse existing <a href="/teams">Teams</a> and <a href="/users">Users</a> to see who's
        already competing.
    </p>
</section>

<section id="donate">
    <h2 class="section-title">Support the league</h2>
    <p>
        The Champions Amateur League is run by one person, and I cover the hosting bills out of
        pocket to keep it online for everyone. If you'd like to help, donations are genuinely
        appreciated and go directly toward those hosting costs — nothing more. There's no
        obligation; playing and spreading the word helps just as much.
    </p>
    @if (m_cost is not null)
    {
        <div class="mt-4 rounded-lg border border-gray-200 bg-gray-50 px-5 py-4">
            <div class="text-sm text-gray-500">Hosting costs (last @m_cost.Days days)</div>
            <div class="text-2xl font-semibold text-gray-900">@FormatAmount(m_cost)</div>
            <div class="mt-1 text-xs text-gray-400">
                As of @m_cost.AsOf.ToLocalTime().ToString("MMM d, yyyy h:mm tt") · updates a few times a day
            </div>
        </div>
    }
    @* TODO: replace href with the Stripe payment/donation link once the account is set up. *@
    <a href="#" class="mt-2 inline-flex items-center gap-2 rounded-full bg-brand-600 px-5 py-2 font-medium text-white no-underline transition-opacity hover:opacity-80">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
