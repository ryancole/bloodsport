@code {
    private RecentCost? m_cost;

    protected override async Task OnInitializedAsync()
    {
        m_cost = await CostService.GetRecentAsync();
    }

    private static string FormatAmount(RecentCost cost)
    {
        // Render USD with the familiar symbol; fall back to "<code> <amount>" otherwise.
        if (string.Equals(cost.Currency, "USD", StringComparison.OrdinalIgnoreCase))
        {
            return cost.Amount.ToString("C2", CultureInfo.GetCultureInfo("en-US"));
        }

        return $"{cost.Currency} {cost.Amount.ToString("N2", CultureInfo.InvariantCulture)}";
    }
}
