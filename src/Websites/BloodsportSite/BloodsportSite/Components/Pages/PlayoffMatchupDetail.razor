@page "/playoffs/{playoffId:long}/matchups/{matchupId:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(matchup is not null && matchup.TeamOne is not null && matchup.TeamTwo is not null ? $"{matchup.TeamOne.Team?.Name} vs {matchup.TeamTwo.Team?.Name}" : "Matchup") | BSAL</PageTitle>

@if (notFound)
{
    <p class="text-muted">Matchup not found.</p>
}
else if (matchup is null)
{
    <p><em>Loading...</em></p>
}
else
{
    var teamOneName = matchup.TeamOne?.Team?.Name ?? "TBD";
    var teamTwoName = matchup.TeamTwo?.Team?.Name ?? "TBD";
    var round = matchup.PlayoffRound;
    var playoff = round.Playoff;
    var isGrandFinal = round.PlayoffMatchups.Count == 1;

    <SectionContent SectionName="breadcrumbs">
        <nav class="small"><a href="/playoffs">Playoffs</a> / <a href="/playoffs/@playoff.Id">@playoff.Name</a> / @round.Name / @teamOneName vs @teamTwoName</nav>
    </SectionContent>

    @if (isGrandFinal)
    {
        <div class="grand-final-banner mb-3">
            <span class="grand-final-trophy">🏆</span>
            <div>
                <div class="grand-final-title">Grand Final</div>
                <div class="grand-final-subtitle">@playoff.Name</div>
            </div>
            <span class="grand-final-trophy">🏆</span>
        </div>

        <h1 class="mb-1 grand-final-matchup-title">@teamOneName vs @teamTwoName</h1>
    }
    else
    {
        <h1 class="mb-1">@teamOneName vs @teamTwoName</h1>
        <p class="text-muted mb-1">@round.Name &mdash; @playoff.Name</p>
    }

    @if (round.DateEnd.HasValue)
    {
        <p class="text-muted small mb-4">Round ends @round.DateEnd.Value.ToLocalTime().ToString("MMMM d, yyyy")</p>
    }
    else
    {
        <p class="text-muted small mb-4">Round end date not yet set</p>
    }

    @* Tournament Lobby *@
    @if (playoff.Status == PlayoffStatus.Active && (isManager || isMember))
    {
        <PlayoffLobbyCode MatchupId="matchup.Id" IsManager="isManager" RoundEnded="RoundEnded" TournamentCode="@matchup.TournamentCode" Error="@error" Info="@info" />
    }

    @* Result *@
    @if (matchup.WinningTeam is not null)
    {
        <div class="alert alert-success mb-4">
            <strong>@matchup.WinningTeam.Team?.Name</strong> wins this matchup.
        </div>
    }
    else if (matchup.TournamentCode is not null && RoundEnded)
    {
        <MatchupPendingResultAlert />
    }

    @* Lobby Events *@
    @if (isManager && lobbyEvents.Count > 0)
    {
        <div class="card border-0 bg-body-secondary rounded-3 mb-4 p-4">
            <div class="text-uppercase fw-semibold small text-muted letter-spacing-1 mb-3">Lobby Events (@lobbyEvents.Count)</div>
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th class="text-muted fw-normal small">Time</th>
                        <th class="text-muted fw-normal small">Event</th>
                        <th class="text-muted fw-normal small">Player</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in lobbyEvents)
                    {
                        var displayName = evt.Puuid is not null && puuidToSummonerName.TryGetValue(evt.Puuid, out var name)
                            ? name
                            : (evt.Puuid?[..8] ?? "unknown") + "…";
                        var time = long.TryParse(evt.Timestamp, out var ms)
                            ? DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.ToString("MMM d, h:mm:ss tt")
                            : evt.Timestamp;
                        <tr>
                            <td class="small text-muted text-nowrap">@time</td>
                            <td class="small font-monospace">@evt.EventType</td>
                            <td class="small">@displayName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* Teams *@
    @if (matchup.WinningTeam is null)
    {
        <div class="alert alert-warning small mb-4">
            <strong>Locked-in rosters enforced.</strong>
            Only Riot IDs on each team's locked-in roster are permitted in the tournament lobby. Players not on the roster below will be blocked from joining.
        </div>
    }
    <div class="row g-0 mb-4 align-items-stretch">
        <div class="col-md-5">
            <TeamSeasonRosterCard TeamId="@(matchup.TeamOne?.TeamId ?? 0)" TeamName="@teamOneName" AllowedSummonerNames="@teamOneRoster" BadgeClass="bg-primary-subtle text-primary-emphasis" UserIds="@rosterUserIds" />
        </div>

        <div class="col-md-2 d-flex align-items-center justify-content-center py-4">
            <div class="fw-black fs-2 text-muted lh-1">VS</div>
        </div>

        <div class="col-md-5">
            <TeamSeasonRosterCard TeamId="@(matchup.TeamTwo?.TeamId ?? 0)" TeamName="@teamTwoName" AllowedSummonerNames="@teamTwoRoster" BadgeClass="bg-danger-subtle text-danger-emphasis" UserIds="@rosterUserIds" />
        </div>
    </div>
}

@code {
    [Parameter] public long PlayoffId { get; set; }
    [Parameter] public long MatchupId { get; set; }

    private record LobbyEvent(string? EventType, string? Puuid, string? Timestamp);

    private static readonly JsonSerializerOptions _caseInsensitive = new() { PropertyNameCaseInsensitive = true };

    private PlayoffRoundMatchup? matchup;
    private bool notFound;
    private bool isManager;
    private bool isMember;
    private string? error;
    private string? info;
    private ICollection<string> teamOneRoster = [];
    private ICollection<string> teamTwoRoster = [];
    private Dictionary<string, long> rosterUserIds = [];
    private List<LobbyEvent> lobbyEvents = [];
    private Dictionary<string, string> puuidToSummonerName = [];

    private bool RoundEnded => matchup?.PlayoffRound.DateEnd.HasValue == true
                            && matchup.PlayoffRound.DateEnd!.Value < DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        query.TryGetValue("error", out var errorVal);
        error = errorVal;

        query.TryGetValue("info", out var infoVal);
        info = infoVal;

        await using var db = await DbFactory.CreateDbContextAsync();

        matchup = await db.PlayoffRoundMatchups
            .Include(m => m.TeamOne).ThenInclude(pt => pt!.Team)
            .Include(m => m.TeamTwo).ThenInclude(pt => pt!.Team)
            .Include(m => m.WinningTeam).ThenInclude(pt => pt!.Team)
            .Include(m => m.PlayoffRound).ThenInclude(r => r.Playoff)
            .Include(m => m.PlayoffRound).ThenInclude(r => r.PlayoffMatchups)
            .FirstOrDefaultAsync(m => m.Id == MatchupId && m.PlayoffRound.PlayoffId == PlayoffId);

        if (matchup is null)
        {
            notFound = true;
            return;
        }

        if (matchup.TournamentCode is not null)
        {
            var rawEvents = await db.RiotLobbyEvents
                .Where(e => e.TournamentCode == matchup.TournamentCode)
                .OrderBy(e => e.Id)
                .ToListAsync();

            lobbyEvents = rawEvents
                .Select(e => JsonSerializer.Deserialize<LobbyEvent>(e.EventJson, _caseInsensitive))
                .Where(e => e is not null)
                .Select(e => e!)
                .ToList();

            var eventPuuids = lobbyEvents.Select(e => e.Puuid).Where(p => p is not null).Distinct().ToHashSet();
            var eventAccounts = await db.RiotAccounts
                .Where(a => eventPuuids.Contains(a.Puuid))
                .ToListAsync();
            puuidToSummonerName = eventAccounts.ToDictionary(a => a.Puuid, a => $"{a.GameName}#{a.TagLine}");
        }

        var teamOneId = matchup.TeamOne?.TeamId;
        var teamTwoId = matchup.TeamTwo?.TeamId;

        var rosters = await db.TeamPlayoffRosters
            .Where(r => r.PlayoffId == PlayoffId && (r.TeamId == teamOneId || r.TeamId == teamTwoId))
            .ToListAsync();

        static ICollection<string> ParseRoster(TeamPlayoffRoster? roster) =>
            roster is null ? [] :
            JsonSerializer.Deserialize<TeamPlayoffRosterJson>(roster.RosterJson)?.AllowedSummonerNames ?? [];

        teamOneRoster = ParseRoster(rosters.FirstOrDefault(r => r.TeamId == teamOneId));
        teamTwoRoster = ParseRoster(rosters.FirstOrDefault(r => r.TeamId == teamTwoId));

        var allSummonerNames = teamOneRoster.Concat(teamTwoRoster).ToHashSet();
        var accounts = await db.RiotAccounts
            .Where(a => allSummonerNames.Contains(a.GameName + "#" + a.TagLine))
            .ToListAsync();
        rosterUserIds = accounts.ToDictionary(a => $"{a.GameName}#{a.TagLine}", a => a.UserId);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);
            if (user is not null)
            {
                isManager = matchup.TeamOne?.Team?.ManagerId == user.Id
                         || matchup.TeamTwo?.Team?.ManagerId == user.Id;

                var teamOneTeamId = matchup.TeamOne?.TeamId;
                var teamTwoTeamId = matchup.TeamTwo?.TeamId;

                isMember = await db.TeamMemberships
                    .Include(m => m.RiotAccount)
                    .AnyAsync(m => m.RiotAccount.UserId == user.Id &&
                                   (m.TeamId == teamOneTeamId || m.TeamId == teamTwoTeamId));
            }
        }
    }
}
