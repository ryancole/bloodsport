@page "/playoffs/{playoffId:long}/matchups/{matchupId:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(matchup is not null && matchup.TeamOne is not null && matchup.TeamTwo is not null ? $"{matchup.TeamOne.Team?.Name} vs {matchup.TeamTwo.Team?.Name}" : "Matchup")</PageTitle>

@if (notFound)
{
    <p class="text-muted">Matchup not found.</p>
}
else if (matchup is null)
{
    <p><em>Loading...</em></p>
}
else
{
    var teamOneName = matchup.TeamOne?.Team?.Name ?? "TBD";
    var teamTwoName = matchup.TeamTwo?.Team?.Name ?? "TBD";
    var round = matchup.PlayoffRound;
    var playoff = round.Playoff;

    <nav class="small mb-2">
        <a href="/playoffs">Playoffs</a> /
        <a href="/playoffs/@playoff.Id">@playoff.Name</a> /
        @round.Name / @teamOneName vs @teamTwoName
    </nav>

    <h1 class="mb-1">@teamOneName vs @teamTwoName</h1>
    <p class="text-muted mb-1">@round.Name &mdash; @playoff.Name</p>
    @if (round.DateEnd.HasValue)
    {
        <p class="text-muted small mb-4">Round ends @round.DateEnd.Value.ToLocalTime().ToString("MMMM d, yyyy")</p>
    }
    else
    {
        <p class="text-muted small mb-4">Round end date not yet set</p>
    }

    @* Tournament Lobby *@
    <div class="card border-0 bg-body-secondary rounded-3 mb-4 p-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <div class="text-uppercase fw-semibold small text-muted letter-spacing-1 mb-1">Tournament Lobby</div>
                @if (matchup.TournamentCode is not null)
                {
                    @if (isManager)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <div class="font-monospace fs-3 fw-bold lh-1">@matchup.TournamentCode</div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Copy lobby code" onclick="navigator.clipboard.writeText('@matchup.TournamentCode').then(() => { this.textContent = '✓ Copied'; setTimeout(() => this.textContent = 'Copy', 2000); })">Copy</button>
                        </div>
                        <div class="small text-success mt-1">&#10003; Lobby code ready</div>
                    }
                    else
                    {
                        <div class="font-monospace fs-3 fw-bold lh-1 text-muted user-select-none">••••••••••••</div>
                        <div class="small text-muted mt-1">Join a competing team to reveal this code</div>
                    }
                }
                else
                {
                    <div class="fs-5 fw-medium text-muted lh-1">No code yet</div>
                    @if (isManager)
                    {
                        @if (RoundEnded)
                        {
                            <div class="small text-muted mt-1">This round has ended — lobby codes can no longer be generated</div>
                        }
                        else
                        {
                            <div class="small text-muted mt-1">Generate one below to create the custom lobby</div>
                        }
                    }
                    else
                    {
                        <div class="small text-muted mt-1">A team manager must generate the lobby code</div>
                    }
                }
            </div>
            @if (isManager && matchup.TournamentCode is null && !RoundEnded)
            {
                <form method="post" action="/api/playoff-matchups/@matchup.Id/tournament-code">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-primary px-4">Generate Lobby Code</button>
                </form>
            }
        </div>
        @if (error == "tournament_not_configured")
        {
            <div class="alert alert-warning mb-0 mt-3 py-2 small">This season has not been configured with a Riot tournament ID. An admin must set it up before lobby codes can be generated.</div>
        }
        else if (error == "riot_api_error")
        {
            <div class="alert alert-danger mb-0 mt-3 py-2 small">Failed to generate a lobby code from the Riot API. Please try again.</div>
        }
        else if (error == "round_ended")
        {
            <div class="alert alert-warning mb-0 mt-3 py-2 small">This round has ended — lobby codes can no longer be generated.</div>
        }
    </div>

    @* Result *@
    @if (matchup.WinningTeam is not null)
    {
        <div class="alert alert-success mb-4">
            <strong>@matchup.WinningTeam.Team?.Name</strong> wins this matchup.
        </div>
    }
    else if (matchup.TournamentCode is not null && RoundEnded)
    {
        <MatchupPendingResultAlert />
    }

    @* Teams *@
    <div class="row g-0 mb-4">
        <div class="col-md-5">
            <div class="card h-100 border-0 bg-body-secondary rounded-3 p-3">
                <div class="fw-semibold mb-1">
                    @if (matchup.TeamOne is not null)
                    {
                        <a href="/teams/@matchup.TeamOne.TeamId">@teamOneName</a>
                        <span class="text-muted small ms-2">Seed @matchup.TeamOne.Seed</span>
                    }
                    else
                    {
                        <span class="text-muted">TBD</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-2 d-flex align-items-center justify-content-center py-4">
            <div class="fw-black fs-2 text-muted lh-1">VS</div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 border-0 bg-body-secondary rounded-3 p-3">
                <div class="fw-semibold mb-1">
                    @if (matchup.TeamTwo is not null)
                    {
                        <a href="/teams/@matchup.TeamTwo.TeamId">@teamTwoName</a>
                        <span class="text-muted small ms-2">Seed @matchup.TeamTwo.Seed</span>
                    }
                    else
                    {
                        <span class="text-muted">TBD</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long PlayoffId { get; set; }
    [Parameter] public long MatchupId { get; set; }

    private PlayoffMatchup? matchup;
    private bool notFound;
    private bool isManager;
    private string? error;

    private bool RoundEnded => matchup?.PlayoffRound.DateEnd.HasValue == true
                            && matchup.PlayoffRound.DateEnd!.Value < DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        query.TryGetValue("error", out var errorVal);
        error = errorVal;

        await using var db = await DbFactory.CreateDbContextAsync();

        matchup = await db.PlayoffMatchups
            .Include(m => m.TeamOne).ThenInclude(pt => pt!.Team)
            .Include(m => m.TeamTwo).ThenInclude(pt => pt!.Team)
            .Include(m => m.WinningTeam).ThenInclude(pt => pt!.Team)
            .Include(m => m.PlayoffRound).ThenInclude(r => r.Playoff)
            .FirstOrDefaultAsync(m => m.Id == MatchupId && m.PlayoffRound.PlayoffId == PlayoffId);

        if (matchup is null)
        {
            notFound = true;
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);
            if (user is not null)
            {
                isManager = matchup.TeamOne?.Team?.ManagerId == user.Id
                         || matchup.TeamTwo?.Team?.ManagerId == user.Id;
            }
        }
    }
}
