@page "/profile"
@attribute [Authorize]
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject BloodsportSite.Services.BlobSasService BlobSasService

<PageTitle>Profile | BSAL</PageTitle>

<div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
        @if (user?.LogoUrl is not null)
        {
            <img src="@BlobSasService.GetSasUrl(user.LogoUrl)" alt="Profile logo" class="h-16 w-16 object-contain" />
        }
        <h1 class="page-title">My Profile</h1>
    </div>
    <form method="post" action="/auth/logout">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-secondary">Log out</button>
    </form>
</div>

@if (user is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    @if (pendingInvites.Count > 0)
    {
        <div class="mb-8">
            <h2 class="mb-3 section-title">Team Invites</h2>
            @if (inviteAccepted)
            {
                <div class="alert alert-success mb-3">Invite accepted — you have joined the team!</div>
            }
            <div class="overflow-x-auto">
                <table class="tbl">
                    <thead>
                        <tr><th>Team</th><th>Riot Account</th><th>Sent</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var invite in pendingInvites)
                        {
                            <tr>
                                <td><a href="/teams/@invite.TeamId" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@invite.Team.LogoUrl" />@invite.Team.Name</a></td>
                                <td><a href="https://u.gg/lol/profile/na1/@Uri.EscapeDataString(invite.RiotAccount.GameName)-@Uri.EscapeDataString(invite.RiotAccount.TagLine)/overview" target="_blank" rel="noopener noreferrer" class="link"><strong>@invite.RiotAccount.GameName#@invite.RiotAccount.TagLine</strong></a></td>
                                <td>@invite.DateCreated.ToLocalTime().ToString("MMM d, yyyy")</td>
                                <td>
                                    <div class="flex items-center gap-2">
                                        <form method="post" action="/api/invites/@invite.Id/accept">
                                            <AntiforgeryToken />
                                            <button type="submit" class="btn btn-primary btn-sm">Accept</button>
                                        </form>
                                        <form method="post" action="/api/invites/@invite.Id/decline">
                                            <AntiforgeryToken />
                                            <button type="submit" class="btn btn-secondary btn-sm">Decline</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <dl class="mb-6 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-[160px_1fr]">
        <dt class="text-sm font-medium text-gray-500">Display Name</dt>
        <dd>
            @if (displayNameError is not null)
            {
                <div class="alert alert-danger mb-2 max-w-md">@displayNameError</div>
            }
            <form method="post" action="/api/users/update-display-name" class="flex items-center gap-2">
                <AntiforgeryToken />
                <input type="text" name="displayName" class="input max-w-60" value="@user.DisplayName" required />
                <button type="submit" class="btn btn-secondary">Save</button>
            </form>
        </dd>

        <dt class="text-sm font-medium text-gray-500">Logo</dt>
        <dd>
            @if (logoError is not null)
            {
                <div class="alert alert-danger mb-2 max-w-md">@logoError</div>
            }
            <form method="post" action="/api/users/update-logo" enctype="multipart/form-data" class="flex items-center gap-2">
                <AntiforgeryToken />
                <input type="file" name="logo" class="block max-w-60 text-sm text-gray-600" accept="image/jpeg,image/png,image/gif,image/webp" required />
                <button type="submit" class="btn btn-secondary">Upload</button>
                <UserFlag LogoUrl="@user.LogoUrl" />
            </form>
            <div class="mt-1 text-xs text-gray-400">PNG, JPG, GIF, or WebP. Max 5 MB.</div>
        </dd>

        <dt class="text-sm font-medium text-gray-500">Member Since</dt>
        <dd class="text-gray-700">@user.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</dd>
    </dl>

    <div class="mb-8">
        <h2 class="mb-3 section-title">Looking for a Team</h2>
        @{
            var isLooking = user.UserRecruitment?.IsLookingForTeam == true;
        }
        @if (isLooking)
        {
            <div class="alert alert-success mb-3">You're marked as looking for a team. Team managers can find and recruit you.</div>
        }
        else
        {
            <p class="mb-3 text-sm text-gray-600">Let team managers know you're available to be recruited. Select the lanes you play.</p>
        }

        <form method="post" action="/api/users/update-recruitment">
            <AntiforgeryToken />
            <input type="hidden" name="isLookingForTeam" value="true" />
            <fieldset class="mb-4">
                <legend class="mb-2 text-sm font-medium text-gray-500">Lanes</legend>
                <div class="flex flex-wrap gap-3">
                    @foreach (var lane in allLanes)
                    {
                        <label class="cursor-pointer" title="@lane">
                            <input type="checkbox" name="lanes" value="@lane" checked="@selectedLanes.Contains(lane)" class="peer sr-only" />
                            <img src="/image/lanes/@(lane.ToString().ToLowerInvariant()).svg" width="32" height="32" alt="@lane"
                                 class="rounded-md bg-[#0e1a2b] p-1 opacity-40 ring-2 ring-transparent transition hover:opacity-70 peer-checked:opacity-100 peer-checked:ring-brand-500" />
                        </label>
                    }
                </div>
            </fieldset>
            <button type="submit" class="btn btn-primary">@(isLooking ? "Update lanes" : "Mark me as looking for a team")</button>
        </form>

        @if (isLooking)
        {
            <form method="post" action="/api/users/update-recruitment" class="mt-3">
                <AntiforgeryToken />
                <input type="hidden" name="isLookingForTeam" value="false" />
                <button type="submit" class="btn btn-secondary">Stop looking for a team</button>
            </form>
        }
    </div>

    <div class="mb-8">
        <ProfileRiotAccountsTable Accounts="user.RiotAccounts" RiotError="@riotError" />
    </div>

    <ProfileTeamsTable TeamRows="teamRows" />
}

@code {
    private Bloodsport.Entity.Database.User? user;
    private List<TeamInvite> pendingInvites = [];
    private List<(Bloodsport.Entity.Database.Team Team, string Role)> teamRows = [];
    private string? riotError;
    private string? displayNameError;
    private string? logoError;
    private bool inviteAccepted;

    private static readonly UserRecruitmentLanes[] allLanes =
    [
        UserRecruitmentLanes.Top,
        UserRecruitmentLanes.Jungle,
        UserRecruitmentLanes.Middle,
        UserRecruitmentLanes.Bottom,
        UserRecruitmentLanes.Support,
    ];
    private HashSet<UserRecruitmentLanes> selectedLanes = [];

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("invite_accepted", out _))
            inviteAccepted = true;

        if (query.TryGetValue("display_name_error", out _))
            displayNameError = "Display name cannot be empty.";

        if (query.TryGetValue("logo_error", out var logoErrorCode))
        {
            logoError = (string?)logoErrorCode switch
            {
                "invalid_logo"   => "The logo must be a PNG, JPG, GIF, or WebP image.",
                "logo_too_large" => "The logo must be under 5 MB.",
                _                => "An unknown error occurred. Please try again.",
            };
        }

        if (query.TryGetValue("riot_error", out var errorCode))
        {
            riotError = (string?)errorCode switch
            {
                "invalid_input"    => "Please enter both a Game Name and Tag.",
                "not_found"        => "No Riot account found with that Game Name and Tag.",
                "already_linked"   => "That Riot account is already linked to an account.",
                "riot_api_failed"  => "Could not reach the Riot API. Please try again later.",
                _                  => "An unknown error occurred. Please try again.",
            };
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        var oid = principal.FindFirst("oid")?.Value
               ?? principal.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            user = await db.Users
                .Include(u => u.RiotAccounts)
                    .ThenInclude(a => a.TeamMemberships)
                        .ThenInclude(m => m.Team)
                            .ThenInclude(t => t.TeamMemberships)
                .Include(u => u.ManagedTeams)
                    .ThenInclude(t => t.TeamMemberships)
                .Include(u => u.UserRecruitment)
                .FirstOrDefaultAsync(u => u.EntraObjectId == oid);

            if (user is not null)
            {
                selectedLanes = user.UserRecruitment?.Lanes.ToHashSet() ?? [];

                var managedTeamIds = user.ManagedTeams.Select(t => t.Id).ToHashSet();
                var memberTeams = user.RiotAccounts.SelectMany(a => a.TeamMemberships).Select(m => m.Team).DistinctBy(t => t.Id);

                teamRows = memberTeams
                    .Select(t => (Team: t, IsManager: managedTeamIds.Contains(t.Id), IsMember: true))
                    .Concat(user.ManagedTeams
                        .Where(t => !user.RiotAccounts.SelectMany(a => a.TeamMemberships).Any(m => m.Team.Id == t.Id))
                        .Select(t => (Team: t, IsManager: true, IsMember: false)))
                    .OrderBy(r => r.Team.Name)
                    .Select(r => (r.Team, Role: r.IsManager && r.IsMember ? "Manager, Member" : r.IsManager ? "Manager" : "Member"))
                    .ToList();

                var riotAccountIds = user.RiotAccounts.Select(r => r.Id).ToList();
                pendingInvites = await db.TeamInvites
                    .Include(i => i.Team)
                    .Include(i => i.RiotAccount)
                    .Where(i => riotAccountIds.Contains(i.RiotAccountId) && i.Status == TeamInviteStatus.Pending)
                    .OrderByDescending(i => i.DateCreated)
                    .ToListAsync();
            }
        }
    }
}
