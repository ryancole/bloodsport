@page "/profile"
@attribute [Authorize]
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Profile</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My Profile</h1>
    <form method="post" action="/auth/logout">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-outline-danger btn-sm">Log out</button>
    </form>
</div>

@if (user is null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (pendingInvites.Count > 0)
    {
        <div class="alert alert-info mb-4">
            <h5 class="alert-heading">Team Invites</h5>
            @if (inviteAccepted)
            {
                <div class="alert alert-success py-1 px-2 small mb-2">Invite accepted — you've joined the team!</div>
            }
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Team</th>
                        <th>Riot Account</th>
                        <th>Sent</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invite in pendingInvites)
                    {
                        <tr>
                            <td><a href="/teams/@invite.TeamId">@invite.Team.Name</a></td>
                            <td><strong>@invite.RiotAccount.GameName#@invite.RiotAccount.TagLine</strong></td>
                            <td>@invite.DateCreated.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td class="d-flex gap-2">
                                <form method="post" action="/api/invites/@invite.Id/accept">
                                    <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                </form>
                                <form method="post" action="/api/invites/@invite.Id/decline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Decline</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <dl class="row">
        <dt class="col-sm-3">Display Name</dt>
        <dd class="col-sm-9">
            @if (displayNameError is not null)
            {
                <div class="alert alert-danger py-1 px-2 small mb-2">@displayNameError</div>
            }
            <form method="post" action="/api/users/update-display-name" class="d-flex gap-2 align-items-center">
                <input type="text" name="displayName" class="form-control form-control-sm" style="max-width: 240px;"
                       value="@user.DisplayName" required />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
            </form>
        </dd>

        <dt class="col-sm-3">Member Since</dt>
        <dd class="col-sm-9">@user.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</dd>

        <dt class="col-sm-3">Account ID</dt>
        <dd class="col-sm-9"><code>@user.EntraObjectId</code></dd>

        <dt class="col-sm-3">Managed Teams</dt>
        <dd class="col-sm-9">
            @if (user.ManagedTeams.Count == 0)
            {
                <span class="text-muted">No managed teams</span>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var team in user.ManagedTeams.OrderBy(t => t.Name))
                    {
                        <a href="/teams/@team.Id" class="text-decoration-none">
                            <div class="card" style="min-width: 160px;">
                                <div class="card-body py-2 px-3">
                                    <div class="fw-semibold">@team.Name</div>
                                    <div class="text-muted small">@team.TeamMemberships.Count member@(team.TeamMemberships.Count == 1 ? "" : "s")</div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </dd>

        <dt class="col-sm-3">Riot Accounts</dt>
        <dd class="col-sm-9">
            @if (user.RiotAccounts.Count == 0)
            {
                <span class="text-muted">No linked accounts</span>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var account in user.RiotAccounts)
                    {
                        <li class="d-flex align-items-center gap-2 mb-1">
                            <a href="https://u.gg/lol/profile/na1/@Uri.EscapeDataString(account.GameName)-@Uri.EscapeDataString(account.TagLine)/overview" target="_blank" rel="noopener noreferrer"><strong>@account.GameName#@account.TagLine</strong></a>
                            <span class="text-muted small">(linked @account.DateCreated.ToLocalTime().ToShortDateString())</span>
                            <form method="post" action="/api/riot/unlink">
                                <input type="hidden" name="riotAccountId" value="@account.Id" />
                                <button type="submit" class="btn btn-link btn-sm text-danger p-0">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }

            <form method="post" action="/api/riot/link" class="mt-3">
                @if (riotError is not null)
                {
                    <div class="alert alert-danger py-1 px-2 small mb-2">@riotError</div>
                }
                <div class="d-flex gap-2 align-items-end">
                    <div>
                        <label class="form-label small mb-1">Game Name</label>
                        <input type="text" name="gameName" class="form-control form-control-sm" placeholder="HideOnBush" required />
                    </div>
                    <div>
                        <label class="form-label small mb-1">Tag</label>
                        <input type="text" name="tagLine" class="form-control form-control-sm" placeholder="NA1" required />
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Link Riot Account</button>
                </div>
            </form>
        </dd>
    </dl>

}

@code {
    private Bloodsport.Entity.Database.User? user;
    private List<TeamInvite> pendingInvites = [];
    private string? riotError;
    private string? displayNameError;
    private bool inviteAccepted;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("invite_accepted", out _))
            inviteAccepted = true;

        if (query.TryGetValue("display_name_error", out _))
            displayNameError = "Display name cannot be empty.";

        if (query.TryGetValue("riot_error", out var errorCode))
        {
            riotError = (string?)errorCode switch
            {
                "invalid_input"    => "Please enter both a Game Name and Tag.",
                "not_found"        => "No Riot account found with that Game Name and Tag.",
                "already_linked"   => "That Riot account is already linked to an account.",
                "riot_api_failed"  => "Could not reach the Riot API. Please try again later.",
                _                  => "An unknown error occurred. Please try again.",
            };
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        var oid = principal.FindFirst("oid")?.Value
               ?? principal.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            user = await db.Users
                .Include(u => u.RiotAccounts)
                .Include(u => u.ManagedTeams)
                    .ThenInclude(t => t.TeamMemberships)
                .FirstOrDefaultAsync(u => u.EntraObjectId == oid);

            if (user is not null)
            {
                var riotAccountIds = user.RiotAccounts.Select(r => r.Id).ToList();
                pendingInvites = await db.TeamInvites
                    .Include(i => i.Team)
                    .Include(i => i.RiotAccount)
                    .Where(i => riotAccountIds.Contains(i.RiotAccountId) && i.Status == TeamInviteStatus.Pending)
                    .OrderByDescending(i => i.DateCreated)
                    .ToListAsync();
            }
        }
    }
}
