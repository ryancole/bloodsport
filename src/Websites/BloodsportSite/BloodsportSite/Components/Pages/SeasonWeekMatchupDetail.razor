@page "/seasons/{seasonId:long}/weeks/{weekId:long}/matchups/{matchupId:long}"
@using System.Text.Json
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(matchup is not null ? $"{matchup.TeamOne.Name} vs {matchup.TeamTwo.Name}" : "Matchup")</PageTitle>

@if (notFound)
{
    <p class="text-muted">Matchup not found.</p>
}
else if (matchup is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <nav class="small mb-2">
        <a href="/seasons">Seasons</a> /
        <a href="/seasons/@matchup.SeasonWeek.Season.Id">@matchup.SeasonWeek.Season.Name</a> /
        <a href="/seasons/@matchup.SeasonWeek.Season.Id/weeks/@matchup.SeasonWeek.Id">@matchup.SeasonWeek.Name</a> /
        @matchup.TeamOne.Name vs @matchup.TeamTwo.Name
    </nav>

    <h1 class="mb-1">@matchup.TeamOne.Name vs @matchup.TeamTwo.Name</h1>
    <p class="text-muted mb-1">@matchup.SeasonWeek.Name &mdash; @matchup.SeasonWeek.Season.Name</p>
    <p class="text-muted small mb-4">@matchup.SeasonWeek.DateStart.ToLocalTime().ToString("MMMM d, yyyy") – @matchup.SeasonWeek.DateEnd.ToLocalTime().ToString("MMMM d, yyyy")</p>

    @* Tournament Lobby *@
    <div class="card border-0 bg-body-secondary rounded-3 mb-4 p-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <div class="text-uppercase fw-semibold small text-muted letter-spacing-1 mb-1">Tournament Lobby</div>
                @if (matchup.TournamentCode is not null)
                {
                    @if (isMember || isManager)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <div class="font-monospace fs-3 fw-bold lh-1">@matchup.TournamentCode</div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Copy lobby code" onclick="navigator.clipboard.writeText('@matchup.TournamentCode').then(() => { this.textContent = '✓ Copied'; setTimeout(() => this.textContent = 'Copy', 2000); })">Copy</button>
                        </div>
                        <div class="small text-success mt-1">&#10003; Lobby code ready</div>
                    }
                    else
                    {
                        <div class="font-monospace fs-3 fw-bold lh-1 text-muted user-select-none">••••••••••••</div>
                        <div class="small text-muted mt-1">Join a competing team to reveal this code</div>
                    }
                }
                else
                {
                    <div class="fs-5 fw-medium text-muted lh-1">No code yet</div>
                    @if (isManager)
                    {
                        <div class="small text-muted mt-1">Generate one below to create the custom lobby</div>
                    }
                    else
                    {
                        <div class="small text-muted mt-1">A team manager must generate the lobby code</div>
                    }
                }
            </div>
            @if (isManager && matchup.TournamentCode is null)
            {
                @if (matchup.SeasonWeek.DateEnd < DateTime.UtcNow)
                {
                    <div class="text-muted small">This week has ended — lobby codes can no longer be generated.</div>
                }
                else
                {
                    <form method="post" action="/api/matchups/@matchup.Id/tournament-code">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-primary px-4">Generate Lobby Code</button>
                    </form>
                }
            }
        </div>
        @if (error == "tournament_not_configured")
        {
            <div class="alert alert-warning mb-0 mt-3 py-2 small">This season has not been configured with a Riot tournament ID. An admin must set it up before lobby codes can be generated.</div>
        }
        else if (error == "riot_api_error")
        {
            <div class="alert alert-danger mb-0 mt-3 py-2 small">Failed to generate a lobby code from the Riot API. Please try again.</div>
        }
        else if (error == "week_ended")
        {
            <div class="alert alert-warning mb-0 mt-3 py-2 small">This week has ended — lobby codes can no longer be generated.</div>
        }
    </div>

    @* Result *@
    @if (result is not null)
    {
        <MatchupResultCard Result="result" />
    }
    else if (matchup.TournamentCode is not null)
    {
        <div class="card border-0 bg-body-secondary rounded-3 mb-4 p-4 text-center">
            <div class="text-uppercase fw-semibold small text-muted letter-spacing-1 mb-1">Match Result</div>
            <div class="fs-5 fw-medium text-muted mt-1">Awaiting results&hellip;</div>
        </div>
    }

    @* Teams *@
    <div class="alert alert-warning small mb-4">
        <strong>Roster verification required.</strong>
        Each team is allowed up to 7 players (5 starters + 2 bench) whose Riot IDs are locked in at the start of the season.
        Before play begins, both teams must manually verify that every player in the custom lobby matches the allowed roster listed below.
        Players not on a team's season roster are not eligible to compete and must be removed from the lobby.
    </div>
    <div class="row g-0 mb-4 align-items-stretch">
        <div class="col-md-5">
            <TeamSeasonRosterCard TeamId="@matchup.TeamOne.Id" TeamName="@matchup.TeamOne.Name" AllowedSummonerNames="@teamOneRoster" BadgeClass="bg-primary-subtle text-primary-emphasis" UserIds="@rosterUserIds" />
        </div>

        <div class="col-md-2 d-flex align-items-center justify-content-center py-4">
            <div class="fw-black fs-2 text-muted lh-1">VS</div>
        </div>

        <div class="col-md-5">
            <TeamSeasonRosterCard TeamId="@matchup.TeamTwo.Id" TeamName="@matchup.TeamTwo.Name" AllowedSummonerNames="@teamTwoRoster" BadgeClass="bg-danger-subtle text-danger-emphasis" UserIds="@rosterUserIds" />
        </div>
    </div>
}

@code {
    [Parameter] public long SeasonId { get; set; }
    [Parameter] public long WeekId { get; set; }
    [Parameter] public long MatchupId { get; set; }

    private SeasonWeekMatchup? matchup;
    private SeasonWeekMatchupResult? result;
    private bool notFound;
    private bool isManager;
    private bool isMember;
    private string? error;
    private ICollection<string> teamOneRoster = [];
    private ICollection<string> teamTwoRoster = [];
    private Dictionary<string, long> rosterUserIds = [];

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        query.TryGetValue("error", out var errorVal);
        error = errorVal;

        await using var db = await DbFactory.CreateDbContextAsync();

        matchup = await db.SeasonWeekMatchups
            .Include(m => m.TeamOne)
            .Include(m => m.TeamTwo)
            .Include(m => m.SeasonWeek)
                .ThenInclude(w => w.Season)
            .FirstOrDefaultAsync(m => m.Id == MatchupId && m.SeasonWeekId == WeekId);

        result = await db.SeasonWeekMatchupResults
            .Include(r => r.WinnerTeam)
            .FirstOrDefaultAsync(r => r.SeasonWeekMatchupId == MatchupId);

        if (matchup is null)
        {
            notFound = true;
            return;
        }

        var seasonId = matchup.SeasonWeek.SeasonId;

        var rosters = await db.TeamSeasonRosters
            .Where(r => r.SeasonId == seasonId && (r.TeamId == matchup.TeamOneId || r.TeamId == matchup.TeamTwoId))
            .ToListAsync();

        static ICollection<string> ParseRoster(TeamSeasonRoster? roster) =>
            roster is null ? [] :
            JsonSerializer.Deserialize<TeamSeasonRosterJson>(roster.RosterJson)?.AllowedSummonerNames ?? [];

        teamOneRoster = ParseRoster(rosters.FirstOrDefault(r => r.TeamId == matchup.TeamOneId));
        teamTwoRoster = ParseRoster(rosters.FirstOrDefault(r => r.TeamId == matchup.TeamTwoId));

        var allSummonerNames = teamOneRoster.Concat(teamTwoRoster).ToHashSet();
        var accounts = await db.RiotAccounts
            .Where(a => allSummonerNames.Contains(a.GameName + "#" + a.TagLine))
            .ToListAsync();
        rosterUserIds = accounts.ToDictionary(a => $"{a.GameName}#{a.TagLine}", a => a.UserId);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);
            if (user is not null)
            {
                isManager = matchup.TeamOne.ManagerId == user.Id || matchup.TeamTwo.ManagerId == user.Id;

                isMember = await db.TeamMemberships
                    .Include(m => m.RiotAccount)
                    .AnyAsync(m => m.RiotAccount.UserId == user.Id &&
                                   (m.TeamId == matchup.TeamOneId || m.TeamId == matchup.TeamTwoId));
            }
        }
    }
}
