@page "/seasons/{seasonId:long}/weeks/{weekId:long}/matchups/{matchupId:long}"
@using System.Text.Json
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(matchup is not null ? $"{matchup.TeamOne.Name} vs {matchup.TeamTwo.Name}" : "Matchup") | BSAL</PageTitle>

@if (notFound)
{
    <p class="text-muted">Matchup not found.</p>
}
else if (matchup is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <SectionContent SectionName="breadcrumbs">
        <nav class="small"><a href="/seasons">Seasons</a> / <a href="/seasons/@matchup.SeasonWeek.Season.Id">@matchup.SeasonWeek.Season.Name</a> / <a href="/seasons/@matchup.SeasonWeek.Season.Id/weeks/@matchup.SeasonWeek.Id">@matchup.SeasonWeek.Name</a> / @matchup.TeamOne.Name vs @matchup.TeamTwo.Name</nav>
    </SectionContent>

    <h1 class="mb-1">@matchup.TeamOne.Name vs @matchup.TeamTwo.Name</h1>
    <p class="text-muted mb-1">@matchup.SeasonWeek.Name &mdash; @matchup.SeasonWeek.Season.Name</p>
    <p class="text-muted small mb-4">@matchup.SeasonWeek.DateStart.ToLocalTime().ToString("MMMM d, yyyy") – @matchup.SeasonWeek.DateEnd.ToLocalTime().ToString("MMMM d, yyyy")</p>

    @* Tournament Lobby *@
    @if (!matchup.SeasonWeek.HasBeenEnded)
    {
    <div class="card border-0 bg-body-secondary rounded-3 mb-4 p-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <div class="text-uppercase fw-semibold small text-muted letter-spacing-1 mb-1">Tournament Lobby</div>
                @if (matchup.TournamentCode is not null)
                {
                    @if (isMember || isManager)
                    {
                        <LobbyCodeDisplay Code="@matchup.TournamentCode" />
                    }
                    else
                    {
                        <div class="font-monospace fs-3 fw-bold lh-1 text-muted user-select-none">••••••••••••</div>
                        <div class="small text-muted mt-1">Join a competing team to reveal this code</div>
                    }
                }
                else
                {
                    <div class="fs-5 fw-medium text-muted lh-1">No code yet</div>
                    @if (isManager)
                    {
                        <div class="small text-muted mt-1">Generate one below to create the custom lobby</div>
                    }
                    else
                    {
                        <div class="small text-muted mt-1">A team manager must generate the lobby code</div>
                    }
                }
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @if (isManager && matchup.TournamentCode is null)
                {
                    @if (matchup.SeasonWeek.HasBeenEnded)
                    {
                        <div class="text-muted small">This week has ended — lobby codes can no longer be generated.</div>
                    }
                    else
                    {
                        <form method="post" action="/api/matchups/@matchup.Id/tournament-code">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-primary px-4">Generate Lobby Code</button>
                        </form>
                    }
                }
                @if (isManager && matchup.TournamentCode is not null)
                {
                    <div class="text-end">
                        <form method="post" action="/api/matchups/@matchup.Id/fetch-lobby-events">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-danger px-4">Fetch Lobby Events</button>
                        </form>
                        <div class="small text-muted mt-1">Use this if there is a dispute about who participated in the lobby.</div>
                    </div>
                }
            </div>
        </div>
        @if (error == "tournament_not_configured")
        {
            <div class="alert alert-warning mb-0 mt-3 py-2 small">This season has not been configured with a Riot tournament ID. An admin must set it up before lobby codes can be generated.</div>
        }
        else if (error == "riot_api_error")
        {
            <div class="alert alert-danger mb-0 mt-3 py-2 small">Failed to generate a lobby code from the Riot API. Please try again.</div>
        }
        else if (error == "week_ended")
        {
            <div class="alert alert-warning mb-0 mt-3 py-2 small">This week has ended — lobby codes can no longer be generated.</div>
        }
        else if (info == "lobby_events_requested")
        {
            <div class="alert alert-success mb-0 mt-3 py-2 small">Lobby events have been requested and will be fetched shortly.</div>
        }
    </div>
    }

    @* Forfeit *@
    @if (isManager && result is null && !matchup.SeasonWeek.HasBeenEnded)
    {
        <div class="card border-0 bg-body-secondary rounded-3 mb-4 p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <div class="text-uppercase fw-semibold small text-muted letter-spacing-1 mb-1">Forfeit</div>
                    <div class="small text-muted">Forfeit this matchup on behalf of your team. This cannot be undone.</div>
                </div>
                <form method="post" action="/api/matchups/@matchup.Id/forfeit" onsubmit="return confirm('Are you sure you want to forfeit this matchup? This cannot be undone.');">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-danger px-4">Forfeit Matchup</button>
                </form>
            </div>
            @if (error == "result_exists")
            {
                <div class="alert alert-warning mb-0 mt-3 py-2 small">A result already exists for this matchup.</div>
            }
        </div>
    }

    @* Result *@
    @if (info == "forfeit_recorded")
    {
        <div class="alert alert-success mb-0 mb-4 py-2 small">Forfeit recorded. Your opponent has been awarded the win.</div>
    }
    @if (result is not null)
    {
        <MatchupResultCard Result="result" />
    }
    else if (matchup.TournamentCode is not null && !matchup.SeasonWeek.HasBeenEnded)
    {
        <MatchupPendingResultAlert />
    }

    @* Lobby Events *@
    @if (isManager && lobbyEvents.Count > 0)
    {
        <div class="card border-0 bg-body-secondary rounded-3 mb-4 p-4">
            <div class="text-uppercase fw-semibold small text-muted letter-spacing-1 mb-3">Lobby Events (@lobbyEvents.Count)</div>
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th class="text-muted fw-normal small">Time</th>
                        <th class="text-muted fw-normal small">Event</th>
                        <th class="text-muted fw-normal small">Player</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in lobbyEvents)
                    {
                        var displayName = evt.Puuid is not null && puuidToSummonerName.TryGetValue(evt.Puuid, out var name)
                            ? name
                            : (evt.Puuid?[..8] ?? "unknown") + "…";
                        var time = long.TryParse(evt.Timestamp, out var ms)
                            ? DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.ToString("MMM d, h:mm:ss tt")
                            : evt.Timestamp;
                        <tr>
                            <td class="small text-muted text-nowrap">@time</td>
                            <td class="small font-monospace">@evt.EventType</td>
                            <td class="small">@displayName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* Teams *@
    @if (result is null)
    {
        <div class="alert alert-warning small mb-4">
            <strong>Locked-in rosters enforced.</strong>
            Only Riot IDs on each team's locked-in roster are permitted in the tournament lobby. Players not on the roster below will be blocked from joining.
        </div>
    }
    <div class="row g-0 mb-4 align-items-stretch">
        <div class="col-md-5">
            <TeamSeasonRosterCard TeamId="@matchup.TeamOne.Id" TeamName="@matchup.TeamOne.Name" AllowedSummonerNames="@teamOneRoster" BadgeClass="bg-primary-subtle text-primary-emphasis" UserIds="@rosterUserIds" />
        </div>

        <div class="col-md-2 d-flex align-items-center justify-content-center py-4">
            <div class="fw-black fs-2 text-muted lh-1">VS</div>
        </div>

        <div class="col-md-5">
            <TeamSeasonRosterCard TeamId="@matchup.TeamTwo.Id" TeamName="@matchup.TeamTwo.Name" AllowedSummonerNames="@teamTwoRoster" BadgeClass="bg-danger-subtle text-danger-emphasis" UserIds="@rosterUserIds" />
        </div>
    </div>
}

@code {
    [Parameter] public long SeasonId { get; set; }
    [Parameter] public long WeekId { get; set; }
    [Parameter] public long MatchupId { get; set; }

    private record LobbyEvent(string? EventType, string? Puuid, string? Timestamp);

    private static readonly JsonSerializerOptions _caseInsensitive = new() { PropertyNameCaseInsensitive = true };

    private SeasonWeekMatchup? matchup;
    private SeasonWeekMatchupResult? result;
    private bool notFound;
    private bool isManager;
    private bool isMember;
    private string? error;
    private string? info;
    private ICollection<string> teamOneRoster = [];
    private ICollection<string> teamTwoRoster = [];
    private Dictionary<string, long> rosterUserIds = [];
    private List<LobbyEvent> lobbyEvents = [];
    private Dictionary<string, string> puuidToSummonerName = [];

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        query.TryGetValue("error", out var errorVal);
        error = errorVal;

        query.TryGetValue("info", out var infoVal);
        info = infoVal;

        await using var db = await DbFactory.CreateDbContextAsync();

        matchup = await db.SeasonWeekMatchups
            .Include(m => m.TeamOne)
            .Include(m => m.TeamTwo)
            .Include(m => m.SeasonWeek)
                .ThenInclude(w => w.Season)
            .FirstOrDefaultAsync(m => m.Id == MatchupId && m.SeasonWeekId == WeekId);

        result = await db.SeasonWeekMatchupResults
            .Include(r => r.WinnerTeam)
            .FirstOrDefaultAsync(r => r.SeasonWeekMatchupId == MatchupId);

        if (matchup is null)
        {
            notFound = true;
            return;
        }

        if (matchup.TournamentCode is not null)
        {
            var rawEvents = await db.RiotLobbyEvents
                .Where(e => e.TournamentCode == matchup.TournamentCode)
                .OrderBy(e => e.Id)
                .ToListAsync();

            lobbyEvents = rawEvents
                .Select(e => JsonSerializer.Deserialize<LobbyEvent>(e.EventJson, _caseInsensitive))
                .Where(e => e is not null)
                .Select(e => e!)
                .ToList();

            var eventPuuids = lobbyEvents.Select(e => e.Puuid).Distinct().ToHashSet();
            var eventAccounts = await db.RiotAccounts
                .Where(a => eventPuuids.Contains(a.Puuid))
                .ToListAsync();
            puuidToSummonerName = eventAccounts.ToDictionary(a => a.Puuid, a => $"{a.GameName}#{a.TagLine}");
        }

        var seasonId = matchup.SeasonWeek.SeasonId;

        var rosters = await db.TeamSeasonRosters
            .Where(r => r.SeasonId == seasonId && (r.TeamId == matchup.TeamOneId || r.TeamId == matchup.TeamTwoId))
            .ToListAsync();

        static ICollection<string> ParseRoster(TeamSeasonRoster? roster) =>
            roster is null ? [] :
            JsonSerializer.Deserialize<TeamSeasonRosterJson>(roster.RosterJson)?.AllowedSummonerNames ?? [];

        teamOneRoster = ParseRoster(rosters.FirstOrDefault(r => r.TeamId == matchup.TeamOneId));
        teamTwoRoster = ParseRoster(rosters.FirstOrDefault(r => r.TeamId == matchup.TeamTwoId));

        var allSummonerNames = teamOneRoster.Concat(teamTwoRoster).ToHashSet();
        var accounts = await db.RiotAccounts
            .Where(a => allSummonerNames.Contains(a.GameName + "#" + a.TagLine))
            .ToListAsync();
        rosterUserIds = accounts.ToDictionary(a => $"{a.GameName}#{a.TagLine}", a => a.UserId);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);
            if (user is not null)
            {
                isManager = matchup.TeamOne.ManagerId == user.Id || matchup.TeamTwo.ManagerId == user.Id;

                isMember = await db.TeamMemberships
                    .Include(m => m.RiotAccount)
                    .AnyAsync(m => m.RiotAccount.UserId == user.Id &&
                                   (m.TeamId == matchup.TeamOneId || m.TeamId == matchup.TeamTwoId));
            }
        }
    }
}
