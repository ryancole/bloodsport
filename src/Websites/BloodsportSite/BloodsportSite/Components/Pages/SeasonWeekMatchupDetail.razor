@page "/seasons/{seasonId:long}/weeks/{weekId:long}/matchups/{matchupId:long}"
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(matchup is not null ? $"{matchup.TeamOne.Name} vs {matchup.TeamTwo.Name}" : "Matchup")</PageTitle>

@if (notFound)
{
    <p class="text-muted">Matchup not found.</p>
}
else if (matchup is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <nav class="small mb-2">
        <a href="/seasons">Seasons</a> /
        <a href="/seasons/@matchup.SeasonWeek.Season.Id">@matchup.SeasonWeek.Season.Name</a> /
        <a href="/seasons/@matchup.SeasonWeek.Season.Id/weeks/@matchup.SeasonWeek.Id">@matchup.SeasonWeek.Name</a> /
        @matchup.TeamOne.Name vs @matchup.TeamTwo.Name
    </nav>

    <h1 class="mb-4">@matchup.TeamOne.Name vs @matchup.TeamTwo.Name</h1>

    <div class="row g-4 mb-4">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body text-center">
                    <h2 class="card-title"><a href="/teams/@matchup.TeamOne.Id">@matchup.TeamOne.Name</a></h2>
                </div>
            </div>
        </div>

        <div class="col-md-2 d-flex align-items-center justify-content-center">
            <span class="fs-3 text-muted fw-bold">VS</span>
        </div>

        <div class="col-md-5">
            <div class="card">
                <div class="card-body text-center">
                    <h2 class="card-title"><a href="/teams/@matchup.TeamTwo.Id">@matchup.TeamTwo.Name</a></h2>
                </div>
            </div>
        </div>
    </div>

    <h2>Tournament Lobby</h2>

    @if (error == "tournament_not_configured")
    {
        <div class="alert alert-warning">This season has not been configured with a Riot tournament ID. An admin must set it up before lobby codes can be generated.</div>
    }
    else if (error == "riot_api_error")
    {
        <div class="alert alert-danger">Failed to generate a lobby code from the Riot API. Please try again.</div>
    }

    @if (matchup.TournamentCode is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-3">
            <div>
                <strong>Lobby Code:</strong>
                <span class="font-monospace ms-2 fs-5">@matchup.TournamentCode</span>
            </div>
        </div>
    }
    else if (isManager)
    {
        <p class="text-muted">No lobby code has been generated yet.</p>
        <form method="post" action="/api/matchups/@matchup.Id/tournament-code">
            <button type="submit" class="btn btn-primary">Generate Lobby Code</button>
        </form>
    }
    else
    {
        <p class="text-muted">No lobby code has been generated yet. A team manager must request one.</p>
    }
}

@code {
    [Parameter] public long SeasonId { get; set; }
    [Parameter] public long WeekId { get; set; }
    [Parameter] public long MatchupId { get; set; }

    private SeasonWeekMatchup? matchup;
    private bool notFound;
    private bool isManager;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        query.TryGetValue("error", out var errorVal);
        error = errorVal;

        await using var db = await DbFactory.CreateDbContextAsync();

        matchup = await db.SeasonWeekMatchups
            .Include(m => m.TeamOne)
            .Include(m => m.TeamTwo)
            .Include(m => m.SeasonWeek)
                .ThenInclude(w => w.Season)
            .FirstOrDefaultAsync(m => m.Id == MatchupId && m.SeasonWeekId == WeekId);

        if (matchup is null)
        {
            notFound = true;
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);
            if (user is not null)
                isManager = matchup.TeamOne.ManagerId == user.Id || matchup.TeamTwo.ManagerId == user.Id;
        }
    }
}
