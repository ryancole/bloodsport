@page "/seasons/{seasonId:long}/weeks/{weekId:long}/matchups/{matchupId:long}"
@using System.Text.Json
@using Bloodsport.Data.Sql
@using Bloodsport.Entity.Database
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(matchup is not null ? $"{matchup.TeamOne.Name} vs {matchup.TeamTwo.Name}" : "Matchup") | BSAL</PageTitle>

@if (notFound)
{
    <p class="text-sm text-gray-500">Matchup not found.</p>
}
else if (matchup is null)
{
    <p class="text-sm text-gray-500"><em>Loading...</em></p>
}
else
{
    <SectionContent SectionName="breadcrumbs">
        <nav><a href="/seasons" class="link">Seasons</a> / <a href="/seasons/@matchup.SeasonWeek.Season.Id" class="link">@matchup.SeasonWeek.Season.Name</a> / <a href="/seasons/@matchup.SeasonWeek.Season.Id/weeks/@matchup.SeasonWeek.Id" class="link">@matchup.SeasonWeek.Name</a> / @matchup.TeamOne.Name vs @matchup.TeamTwo.Name</nav>
    </SectionContent>

    <h1 class="page-title">@matchup.TeamOne.Name vs @matchup.TeamTwo.Name</h1>
    <p class="mt-1 text-gray-600">@matchup.SeasonWeek.Name &mdash; @matchup.SeasonWeek.Season.Name</p>
    <p class="mb-6 text-sm text-gray-400">@matchup.SeasonWeek.DateStart.ToLocalTime().ToString("MMMM d, yyyy") – @matchup.SeasonWeek.DateEnd.ToLocalTime().ToString("MMMM d, yyyy")</p>

    @if (matchup.SeasonWeek.Season.MatchupParameters is { } mp)
    {
        <dl class="mb-6 grid grid-cols-[140px_1fr] sm:grid-cols-[140px_1fr_140px_1fr] gap-x-8 gap-y-2 text-sm">
            <dt class="font-medium text-gray-500">Team Size</dt>
            <dd class="text-gray-700">@(mp.TeamSize)v@(mp.TeamSize)</dd>

            <dt class="font-medium text-gray-500">Pick Type</dt>
            <dd class="text-gray-700">@MatchupParameterLabels.Humanize(mp.PickType)</dd>

            <dt class="font-medium text-gray-500">Map</dt>
            <dd class="text-gray-700">@MatchupParameterLabels.Humanize(mp.MapType)</dd>

            <dt class="font-medium text-gray-500">Spectators</dt>
            <dd class="text-gray-700">@MatchupParameterLabels.Humanize(mp.SpectatorType)</dd>
        </dl>
    }

    @* Tournament Lobby *@
    @if (!matchup.SeasonWeek.HasBeenEnded)
    {
        <div class="card mb-6 space-y-3">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="space-y-1">
                    <div class="eyebrow">Tournament Lobby</div>
                    @if (matchup.TournamentCode is not null)
                    {
                        @if (isMember || isManager)
                        {
                            <LobbyCodeDisplay Code="@matchup.TournamentCode" />
                        }
                        else
                        {
                            <div class="font-mono text-gray-400">••••••••••••</div>
                            <div class="text-xs text-gray-400">Join a competing team to reveal this code</div>
                        }
                    }
                    else
                    {
                        <div class="text-sm text-gray-500">No code yet</div>
                        @if (isManager)
                        {
                            <div class="text-xs text-gray-400">Generate one below to create the custom lobby</div>
                        }
                        else
                        {
                            <div class="text-xs text-gray-400">A team manager must generate the lobby code</div>
                        }
                    }
                </div>
                <div class="space-y-2">
                    @if (isManager && matchup.TournamentCode is null)
                    {
                        @if (matchup.SeasonWeek.HasBeenEnded)
                        {
                            <div class="text-xs text-gray-400">This week has ended — lobby codes can no longer be generated.</div>
                        }
                        else
                        {
                            <form method="post" action="/api/matchups/@matchup.Id/tournament-code">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-primary">Generate Lobby Code</button>
                            </form>
                        }
                    }
                    @if (isManager && matchup.TournamentCode is not null)
                    {
                        <div class="space-y-1">
                            <form method="post" action="/api/matchups/@matchup.Id/fetch-lobby-events">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-secondary">Fetch Lobby Events</button>
                            </form>
                            <div class="text-xs text-gray-400">Use this if there is a dispute about who participated in the lobby.</div>
                        </div>
                    }
                </div>
            </div>
            @if (error == "tournament_not_configured")
            {
                <div class="alert alert-danger">This season has not been configured with a Riot tournament ID. An admin must set it up before lobby codes can be generated.</div>
            }
            else if (error == "riot_api_error")
            {
                <div class="alert alert-danger">Failed to generate a lobby code from the Riot API. Please try again.</div>
            }
            else if (error == "week_ended")
            {
                <div class="alert alert-warning">This week has ended — lobby codes can no longer be generated.</div>
            }
            else if (info == "lobby_events_requested")
            {
                <div class="alert alert-info">Lobby events have been requested and will be fetched shortly.</div>
            }
        </div>
    }

    @* Forfeit *@
    @if (isManager && result is null && !matchup.SeasonWeek.HasBeenEnded)
    {
        <div class="card mb-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                    <div class="font-semibold text-gray-900">Forfeit</div>
                    <div class="text-sm text-gray-500">Forfeit this matchup on behalf of your team. This cannot be undone.</div>
                </div>
                <form method="post" action="/api/matchups/@matchup.Id/forfeit" onsubmit="return confirm('Are you sure you want to forfeit this matchup? This cannot be undone.');">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-danger">Forfeit Matchup</button>
                </form>
            </div>
            @if (error == "result_exists")
            {
                <div class="alert alert-danger mt-3">A result already exists for this matchup.</div>
            }
        </div>
    }

    @* Result *@
    @if (info == "forfeit_recorded")
    {
        <div class="alert alert-success mb-6">Forfeit recorded. Your opponent has been awarded the win.</div>
    }
    @if (result is not null)
    {
        <div class="mb-6">
            <MatchupResultCard Result="result" />
        </div>
    }
    else if (matchup.TournamentCode is not null && !matchup.SeasonWeek.HasBeenEnded)
    {
        <div class="mb-6">
            <MatchupPendingResultAlert />
        </div>
    }

    @* Lobby Events *@
    @if (isManager && lobbyEvents.Count > 0)
    {
        <div class="mb-6">
            <h2 class="mb-3 section-title">Lobby Events (@lobbyEvents.Count)</h2>
            <div class="overflow-x-auto">
                <table class="tbl">
                    <thead>
                        <tr><th>Time</th><th>Event</th><th>Player</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in lobbyEvents)
                        {
                            var displayName = evt.Puuid is not null && puuidToSummonerName.TryGetValue(evt.Puuid, out var name)
                                ? name
                                : (evt.Puuid?[..8] ?? "unknown") + "…";
                            var time = long.TryParse(evt.Timestamp, out var ms)
                                ? DateTimeOffset.FromUnixTimeMilliseconds(ms).LocalDateTime.ToString("MMM d, h:mm:ss tt")
                                : evt.Timestamp;
                            <tr>
                                <td>@time</td>
                                <td>@evt.EventType</td>
                                <td>@displayName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Teams *@
    @if (result is null)
    {
        <div class="alert alert-info mb-4">
            <strong>Locked-in rosters enforced.</strong>
            Only Riot IDs on each team's locked-in roster are permitted in the tournament lobby. Players not on the roster below will be blocked from joining.
        </div>
    }
    <div class="grid grid-cols-1 items-center gap-4 lg:grid-cols-[1fr_auto_1fr]">
        <TeamSeasonRosterCard TeamId="@matchup.TeamOne.Id" TeamName="@matchup.TeamOne.Name" AllowedSummonerNames="@teamOneRoster" DiamondColor="PillColor.Sky" UserIds="@rosterUserIds" IsInaugural="@teamOneInaugural" />

        <div class="text-center text-sm font-bold text-gray-400">VS</div>

        <TeamSeasonRosterCard TeamId="@matchup.TeamTwo.Id" TeamName="@matchup.TeamTwo.Name" AllowedSummonerNames="@teamTwoRoster" DiamondColor="PillColor.Red" UserIds="@rosterUserIds" IsInaugural="@teamTwoInaugural" />
    </div>
}

@code {
    [Parameter] public long SeasonId { get; set; }
    [Parameter] public long WeekId { get; set; }
    [Parameter] public long MatchupId { get; set; }

    private record LobbyEvent(string? EventType, string? Puuid, string? Timestamp);

    private static readonly JsonSerializerOptions _caseInsensitive = new() { PropertyNameCaseInsensitive = true };

    private SeasonWeekMatchup? matchup;
    private SeasonWeekMatchupResult? result;
    private bool notFound;
    private bool isManager;
    private bool isMember;
    private string? error;
    private string? info;
    private ICollection<string> teamOneRoster = [];
    private ICollection<string> teamTwoRoster = [];
    private bool teamOneInaugural;
    private bool teamTwoInaugural;
    private Dictionary<string, long> rosterUserIds = [];
    private List<LobbyEvent> lobbyEvents = [];
    private Dictionary<string, string> puuidToSummonerName = [];

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        query.TryGetValue("error", out var errorVal);
        error = errorVal;

        query.TryGetValue("info", out var infoVal);
        info = infoVal;

        await using var db = await DbFactory.CreateDbContextAsync();

        matchup = await db.SeasonWeekMatchups
            .Include(m => m.TeamOne)
            .Include(m => m.TeamTwo)
            .Include(m => m.SeasonWeek)
                .ThenInclude(w => w.Season)
                    .ThenInclude(s => s.MatchupParameters)
            .FirstOrDefaultAsync(m => m.Id == MatchupId && m.SeasonWeekId == WeekId);

        result = await db.SeasonWeekMatchupResults
            .Include(r => r.WinnerTeam)
            .FirstOrDefaultAsync(r => r.SeasonWeekMatchupId == MatchupId);

        if (matchup is null)
        {
            notFound = true;
            return;
        }

        if (matchup.TournamentCode is not null)
        {
            var rawEvents = await db.RiotLobbyEvents
                .Where(e => e.TournamentCode == matchup.TournamentCode)
                .OrderBy(e => e.Id)
                .ToListAsync();

            lobbyEvents = rawEvents
                .Select(e => JsonSerializer.Deserialize<LobbyEvent>(e.EventJson, _caseInsensitive))
                .Where(e => e is not null)
                .Select(e => e!)
                .ToList();

            var eventPuuids = lobbyEvents.Select(e => e.Puuid).Distinct().ToHashSet();
            var eventAccounts = await db.RiotAccounts
                .Where(a => eventPuuids.Contains(a.Puuid))
                .ToListAsync();
            puuidToSummonerName = eventAccounts.ToDictionary(a => a.Puuid, a => $"{a.GameName}#{a.TagLine}");
        }

        var seasonId = matchup.SeasonWeek.SeasonId;

        var rosters = await db.TeamSeasonRosters
            .Where(r => r.SeasonId == seasonId && (r.TeamId == matchup.TeamOneId || r.TeamId == matchup.TeamTwoId))
            .ToListAsync();

        static ICollection<string> ParseRoster(TeamSeasonRoster? roster) =>
            roster is null ? [] :
            JsonSerializer.Deserialize<TeamSeasonRosterJson>(roster.RosterJson)?.AllowedSummonerNames ?? [];

        teamOneRoster = ParseRoster(rosters.FirstOrDefault(r => r.TeamId == matchup.TeamOneId));
        teamTwoRoster = ParseRoster(rosters.FirstOrDefault(r => r.TeamId == matchup.TeamTwoId));

        var inauguralTeamIds = await db.SeasonRegistrations
            .Where(r => r.SeasonId == seasonId
                        && (r.TeamId == matchup.TeamOneId || r.TeamId == matchup.TeamTwoId)
                        && r.InauguralRegistration == true)
            .Select(r => r.TeamId)
            .ToListAsync();
        teamOneInaugural = inauguralTeamIds.Contains(matchup.TeamOneId);
        teamTwoInaugural = inauguralTeamIds.Contains(matchup.TeamTwoId);

        var allSummonerNames = teamOneRoster.Concat(teamTwoRoster).ToHashSet();
        var accounts = await db.RiotAccounts
            .Where(a => allSummonerNames.Contains(a.GameName + "#" + a.TagLine))
            .ToListAsync();
        rosterUserIds = accounts.ToDictionary(a => $"{a.GameName}#{a.TagLine}", a => a.UserId);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);
            if (user is not null)
            {
                isManager = matchup.TeamOne.ManagerId == user.Id || matchup.TeamTwo.ManagerId == user.Id;

                isMember = await db.TeamMemberships
                    .Include(m => m.RiotAccount)
                    .AnyAsync(m => m.RiotAccount.UserId == user.Id &&
                                   (m.TeamId == matchup.TeamOneId || m.TeamId == matchup.TeamTwoId));
            }
        }
    }
}
