@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="/" />
	<ResourcePreloader />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Exo+2:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
	<link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
	<link rel="stylesheet" href="@Assets["app.css"]" />
	<link rel="stylesheet" href="@Assets["BloodsportSite.styles.css"]" />
	<ImportMap />
	<link rel="icon" type="image/svg+xml" href="favicon.svg" />
	<link rel="icon" type="image/png" href="favicon.png" />
	<HeadOutlet />
	<script src="https://js.monitor.azure.com/scripts/b/ai.3.gbl.min.js"></script>
	<script>
		var appInsights = new Microsoft.ApplicationInsights.ApplicationInsights({
			config: {
				connectionString: "@Configuration.GetConnectionString("ApplicationInsights")",
				enableAutoRouteTracking: true
			}
		});
		appInsights.loadAppInsights();
		appInsights.trackPageView();
	</script>
</head>

<body>
	<Routes />
	<script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
	<script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
	<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
