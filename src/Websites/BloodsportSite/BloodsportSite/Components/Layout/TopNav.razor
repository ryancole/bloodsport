@using Bloodsport.Data.Sql
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<header class="sticky top-0 z-40 flex h-14 items-center gap-3 border-b border-gray-200 bg-white px-6">
    <a href="" class="text-base font-bold text-gray-900 no-underline hover:text-sky-600">Champions Amateur League</a>

    <span class="mx-1 h-5 w-px bg-gray-200"></span>

    <nav class="flex items-center gap-1">
        <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="news">News</NavLink>
        <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="format">Format</NavLink>
        <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="rules">Rules</NavLink>
        <span class="mx-1 h-5 w-px bg-gray-200"></span>
        <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="teams">Teams</NavLink>
        <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="users">Users</NavLink>
        <span class="mx-1 h-5 w-px bg-gray-200"></span>
        <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="seasons">Seasons</NavLink>
        <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="playoffs">Playoffs</NavLink>
    </nav>

    <div class="text-xs uppercase tracking-wide text-gray-400">
        <SectionOutlet SectionName="breadcrumbs" />
    </div>

    <div class="ml-auto flex items-center">
        <AuthorizeView>
            <Authorized>
                <a href="/profile" class="flex items-center gap-2 text-sm text-gray-600 no-underline hover:text-gray-900">
                    <UserFlag LogoUrl="@logoUrl" />@(displayName ?? context.User.FindFirst("preferred_username")?.Value ?? context.User.Identity?.Name)
                </a>
            </Authorized>
            <NotAuthorized>
                <a href="/auth/login" class="text-sm text-gray-600 no-underline hover:text-gray-900">Log in</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

@code {
    // Kept as consts so all nav links share one definition; Tailwind still scans these literals.
    private const string LinkClass = "rounded px-3 py-1.5 text-sm font-medium text-gray-600 no-underline transition-colors hover:bg-gray-100 hover:text-gray-900";
    private const string LinkActiveClass = "bg-sky-50 text-sky-700!";

    private string? displayName;
    private string? logoUrl;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);
            displayName = user?.DisplayName;
            logoUrl = user?.LogoUrl;
        }
    }
}
