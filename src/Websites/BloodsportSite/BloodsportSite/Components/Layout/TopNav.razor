@using Bloodsport.Data.Sql
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SqlDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<header class="sticky top-0 z-40 border-b border-gray-800 bg-gray-900">
    <div class="relative flex h-14 items-center gap-3 px-6">
        <a href="" class="group flex shrink-0 items-center gap-2 text-base font-bold whitespace-nowrap text-white no-underline hover:text-brand-400" aria-label="Champions Amateur League" title="Champions Amateur League">
            <img src="cal-logo.svg" alt="CAL" class="h-8 w-8 transition-[filter] duration-200 group-hover:drop-shadow-[0_0_8px_rgba(56,189,248,0.7)]" />
        </a>

        @* Pure-CSS toggle: the label flips this checkbox, and `peer-checked` reveals the menu (this is static SSR, no Blazor interactivity). *@
        <input type="checkbox" id="nav-toggle" class="peer sr-only" />

        <div class="absolute inset-x-0 top-full hidden flex-col gap-1 border-b border-gray-800 bg-gray-900 p-4 peer-checked:flex lg:static lg:flex lg:flex-1 lg:flex-row lg:items-center lg:gap-3 lg:border-0 lg:bg-transparent lg:p-0"
             onclick="document.getElementById('nav-toggle').checked = false">
            <span class="hidden h-5 w-px bg-white/10 lg:mx-1 lg:inline-block"></span>

            <nav class="flex flex-col gap-1 lg:flex-row lg:items-center lg:gap-1">
                <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="news">News</NavLink>
                <span class="hidden h-5 w-px bg-white/10 lg:mx-1 lg:inline-block"></span>
                <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="format">Format</NavLink>
                <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="rules">Rules</NavLink>
                <span class="hidden h-5 w-px bg-white/10 lg:mx-1 lg:inline-block"></span>
                <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="teams">Teams</NavLink>
                <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="users">Users</NavLink>
                <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="recruitment">Recruitment</NavLink>
                <span class="hidden h-5 w-px bg-white/10 lg:mx-1 lg:inline-block"></span>
                <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="seasons">Seasons</NavLink>
                <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="playoffs">Playoffs</NavLink>
                <NavLink class="@LinkClass" ActiveClass="@LinkActiveClass" href="hall-of-fame">Hall of Fame</NavLink>
            </nav>

            <div class="mt-2 flex items-center gap-4 border-t border-gray-800 pt-3 lg:mt-0 lg:ml-auto lg:border-0 lg:pt-0">
                <a href="/about#donate" class="inline-flex items-center gap-1.5 text-sm font-medium text-green-400 no-underline transition-colors hover:text-green-300" aria-label="Support the league" title="Support the league">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                        <path d="M10 3.5c-.6-1-1.7-1.5-2.9-1.5C4.8 2 3 3.9 3 6.3c0 3.3 3.4 6 7 8.7 3.6-2.7 7-5.4 7-8.7C17 3.9 15.2 2 12.9 2 11.7 2 10.6 2.5 10 3.5z"/>
                    </svg>
                    Donate
                </a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/profile" class="flex items-center gap-2 text-sm text-gray-300 no-underline hover:text-white">
                            <UserFlag LogoUrl="@logoUrl" OnDark="true" />@(displayName ?? context.User.FindFirst("preferred_username")?.Value ?? context.User.Identity?.Name)
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/auth/login" class="text-sm text-gray-300 no-underline hover:text-white">Log in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <label for="nav-toggle" class="ml-auto inline-flex cursor-pointer items-center justify-center rounded p-2 text-gray-300 hover:bg-white/10 hover:text-white lg:hidden" aria-label="Toggle navigation menu">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </label>
    </div>
</header>

@code {
    // Kept as consts so all nav links share one definition; Tailwind still scans these literals.
    private const string LinkClass = "rounded px-3 py-1.5 text-sm font-medium text-gray-300 no-underline transition-colors hover:bg-white/10 hover:text-white";
    private const string LinkActiveClass = "bg-brand-500/15 text-brand-300!";

    private string? displayName;
    private string? logoUrl;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (oid is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.Users.FirstOrDefaultAsync(u => u.EntraObjectId == oid);
            displayName = user?.DisplayName;
            logoUrl = user?.LogoUrl;
        }
    }
}
