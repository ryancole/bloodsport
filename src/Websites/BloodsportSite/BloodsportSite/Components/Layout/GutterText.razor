@* Decorative movie tagline pinned in an empty side gutter of the centered
   layout. Purely ornamental: hidden from assistive tech, and only shown on
   screens wide enough that the max-w-6xl page content leaves real gutter space.
   One slogan is picked per render, on a randomly chosen side (static SSR =
   fresh on each load). *@

@using Bloodsport.Entity.Quotes

@{
    var slogan = Slogans[Random.Shared.Next(Slogans.Length)];
    var sideClass = Random.Shared.Next(2) == 0 ? "left-0" : "right-0";
}

<div aria-hidden="true" class="pointer-events-none fixed inset-y-0 @sideClass -z-10 hidden w-[max(0px,calc((100vw-72rem)/2))] xl:flex items-center justify-center">
    @Render(slogan)
</div>

@code {
    // The rendered pool is every category of slogan combined — poster taglines
    // (MovieSlogans) and spoken character/person lines (MovieQuotes) — built once.
    private static readonly Slogan[] Slogans = [.. MovieSlogans.All, .. MovieQuotes.All];

    private RenderFragment Render(Slogan s) => __builder =>
    {
        // The text is set vertically, so its length runs down the page. The quote
        // and attribution each get their own line (parallel vertical columns), so
        // scale the whole block's font-size by the quote's (approx) per-character
        // advance alone — letting the quote grow to fill the viewport height (88vh
        // leaves a margin + scrollbar room) without the attribution eating into the
        // same line's budget. The shorter attribution column sits alongside, and
        // may overlap the quote's length when it's long — which is fine here. Short
        // quotes hit the 7rem cap instead of ballooning. min() picks the smaller.
        var advance = s.Quote.Length + 2;
        var fontSize = $"font-size: min(7rem, calc(88vh / {advance}))";

        <div class="[writing-mode:vertical-rl] rotate-180 select-none whitespace-nowrap text-center leading-tight" style="@fontSize">
            <div class="font-semibold uppercase tracking-[0.25em] text-gold-600" style="font-size:1em">@s.Quote</div>
            <div class="font-semibold uppercase tracking-[0.3em] text-brand-600" style="font-size:0.28em; margin-block-start:0.5em">@s.Attribution</div>
        </div>
    };
}
