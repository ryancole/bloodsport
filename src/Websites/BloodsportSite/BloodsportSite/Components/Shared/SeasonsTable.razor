@using Bloodsport.Entity.Database

@if (Seasons.Count == 0)
{
    <p class="text-sm text-gray-500">No seasons yet.</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="tbl">
            <thead>
                <tr><th>Name</th><th>Region</th><th>Status</th><th>End</th><th>Length</th></tr>
            </thead>
            <tbody>
                @foreach (var season in Seasons)
                {
                    <tr>
                        <td>
                            <a href="/seasons/@season.Id" class="link">@season.Name</a>
                            @if (season.RegistrationOpen)
                            {
                                <span class="badge bg-green-100 text-green-700">Reg. Open</span>
                            }
                        </td>
                        <td>@season.RiotRegion</td>
                        <td><span class="badge @StatusBadgeClass(season.Status)">@season.Status</span></td>
                        <td>@(season.EstimatedDateEnd?.ToLocalTime().ToString("MMM d, yyyy") ?? "TBD")</td>
                        <td>@season.Length weeks</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<Season> Seasons { get; set; } = [];

    private static string StatusBadgeClass(SeasonStatus status) => status switch
    {
        SeasonStatus.Active    => "bg-green-100 text-green-700",
        SeasonStatus.Upcoming  => "bg-sky-100 text-sky-700",
        SeasonStatus.PreSeason => "bg-amber-100 text-amber-700",
        SeasonStatus.Completed => "bg-gray-100 text-gray-600",
        _                      => "bg-gray-100 text-gray-600",
    };
}
