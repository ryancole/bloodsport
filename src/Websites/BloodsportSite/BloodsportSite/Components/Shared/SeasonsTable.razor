@using Bloodsport.Entity.Database

@if (Seasons.Count == 0)
{
    <p class="text-muted">No seasons yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Region</th>
                <th>Status</th>
                <th>End</th>
                <th>Length</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var season in Seasons)
            {
                <tr>
                    <td>
                        <a href="/seasons/@season.Id">@season.Name</a>
                        @if (season.RegistrationOpen)
                        {
                            <span class="cal-badge cal-badge--success ms-2">Reg. Open</span>
                        }
                    </td>
                    <td>@season.RiotRegion</td>
                    <td><span class="cal-badge @StatusBadgeClass(season.Status)">@season.Status</span></td>
                    <td>@(season.EstimatedDateEnd?.ToLocalTime().ToString("MMM d, yyyy") ?? "TBD")</td>
                    <td>@season.Length weeks</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public List<Season> Seasons { get; set; } = [];

    private static string StatusBadgeClass(SeasonStatus status) => status switch
    {
        SeasonStatus.Active    => "cal-badge--cyan",
        SeasonStatus.PreSeason => "cal-badge--warning",
        SeasonStatus.Upcoming  => "cal-badge--warning",
        SeasonStatus.Completed => "",
        _                      => "",
    };
}
