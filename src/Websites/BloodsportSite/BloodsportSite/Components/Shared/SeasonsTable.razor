@using Bloodsport.Entity.Database

@if (Seasons.Count == 0)
{
    <p class="text-sm text-gray-500">No seasons yet.</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="tbl">
            <thead>
                <tr><th>Name</th><th>Region</th><th>Status</th><th>End</th><th>Length</th></tr>
            </thead>
            <tbody>
                @foreach (var season in Seasons)
                {
                    <tr>
                        <td>
                            <a href="/seasons/@season.Id" class="link">@season.Name</a>
                            @if (season.RegistrationOpen)
                            {
                                <Pill Color="PillColor.Green">Reg. Open</Pill>
                            }
                        </td>
                        <td>@season.RiotRegion</td>
                        <td><SeasonStatusBadge Status="season.Status" /></td>
                        <td>@(season.EstimatedDateEnd?.ToLocalTime().ToString("MMM d, yyyy") ?? "TBD")</td>
                        <td>@season.Length weeks</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<Season> Seasons { get; set; } = [];
}
