@using Bloodsport.Entity.Database

<Pill Color="@BadgeColor" IconPath="@StatusIcon" Title="@Status.ToString()">@Status</Pill>

@code {
    [Parameter, EditorRequired] public PlayoffStatus Status { get; set; }

    private PillColor BadgeColor => Status switch
    {
        PlayoffStatus.Active    => PillColor.Green,
        PlayoffStatus.Upcoming  => PillColor.Sky,
        PlayoffStatus.Completed => PillColor.Gray,
        _                       => PillColor.Gray,
    };

    private string StatusIcon => Status switch
    {
        PlayoffStatus.Active    => StatusIcons.Bolt,
        PlayoffStatus.Completed => StatusIcons.Check,
        _                       => StatusIcons.Clock,
    };
}
