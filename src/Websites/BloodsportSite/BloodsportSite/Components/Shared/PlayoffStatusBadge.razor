@using Bloodsport.Entity.Database

<span class="cal-badge @BadgeClass">@Status</span>

@code {
    [Parameter, EditorRequired] public PlayoffStatus Status { get; set; }

    private string BadgeClass => Status switch
    {
        PlayoffStatus.Active    => "cal-badge--magenta",
        PlayoffStatus.Upcoming  => "cal-badge--warning",
        PlayoffStatus.Completed => "",
        _                       => "",
    };
}
