@using Bloodsport.Entity.Database

<span class="badge @BadgeClass">@Status</span>

@code {
    [Parameter, EditorRequired] public PlayoffStatus Status { get; set; }

    private string BadgeClass => Status switch
    {
        PlayoffStatus.Active    => "bg-green-100 text-green-700",
        PlayoffStatus.Upcoming  => "bg-sky-100 text-sky-700",
        PlayoffStatus.Completed => "bg-gray-100 text-gray-600",
        _                       => "bg-gray-100 text-gray-600",
    };
}
