@using Bloodsport.Entity.Database

<h2 class="mb-3 section-title">Teams</h2>

@if (TeamRows.Count == 0)
{
    <p class="text-sm text-gray-500">No teams.</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="tbl">
            <thead>
                <tr><th>Team</th><th>Role</th><th>Created</th></tr>
            </thead>
            <tbody>
                @foreach (var row in TeamRows)
                {
                    <tr>
                        <td><a href="/teams/@row.Team.Id" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@row.Team.LogoUrl" />@row.Team.Name</a></td>
                        <td>@row.Role</td>
                        <td>@row.Team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<(Team Team, string Role)> TeamRows { get; set; } = [];
}
