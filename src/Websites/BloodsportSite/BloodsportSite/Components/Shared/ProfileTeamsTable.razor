@using Bloodsport.Entity.Database

<h2 class="mt-4">Teams</h2>

@if (TeamRows.Count == 0)
{
    <p class="text-muted">No teams.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Team</th>
                <th>Role</th>
                <th>Members</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in TeamRows)
            {
                <tr>
                    <td><a href="/teams/@row.Team.Id" class="d-flex align-items-center gap-2"><TeamFlag LogoUrl="@row.Team.LogoUrl" />@row.Team.Name</a></td>
                    <td>@row.Role</td>
                    <td>@row.Team.TeamMemberships.Count</td>
                    <td>@row.Team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public List<(Team Team, string Role)> TeamRows { get; set; } = [];
}
