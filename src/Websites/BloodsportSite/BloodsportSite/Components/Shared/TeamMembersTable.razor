@using Bloodsport.Entity.Database

@if (Memberships.Count == 0)
{
    <p class="text-sm text-gray-500">No members yet.</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Riot ID</th><th>User</th>
                    <th>Status</th>
                    <th>Joined</th>
                    @if (IsManager)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var membership in Memberships)
                {
                    <tr>
                        <td><a href="https://u.gg/lol/profile/na1/@Uri.EscapeDataString(membership.RiotAccount.GameName)-@Uri.EscapeDataString(membership.RiotAccount.TagLine)/overview" target="_blank" rel="noopener noreferrer" class="link"><strong>@membership.RiotAccount.GameName#@membership.RiotAccount.TagLine</strong></a></td>
                        <td><a href="/users/@membership.RiotAccount.User.Id" class="link inline-flex items-center gap-2"><UserFlag LogoUrl="@membership.RiotAccount.User.LogoUrl" />@membership.RiotAccount.User.DisplayName</a></td>
                        <td>
                            @if (membership.Active)
                            {
                                <Pill Color="PillColor.Green">Active</Pill>
                            }
                            else
                            {
                                <Pill Color="PillColor.Gray">Inactive</Pill>
                            }
                        </td>
                        <td>@membership.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                        @if (IsManager)
                        {
                            <td class="text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @if (membership.Active)
                                    {
                                        <form method="post" action="/api/teams/@TeamId/members/@membership.Id/deactivate">
                                            <AntiforgeryToken />
                                            <button type="submit" class="btn btn-secondary btn-sm">Deactivate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" action="/api/teams/@TeamId/members/@membership.Id/activate">
                                            <AntiforgeryToken />
                                            <button type="submit" class="btn btn-primary btn-sm" disabled="@(ActiveCount >= TeamMembership.MaxActiveMembers)" title="@(ActiveCount >= TeamMembership.MaxActiveMembers ? $"Roster is full ({TeamMembership.MaxActiveMembers} active members)." : null)">Activate</button>
                                        </form>
                                    }
                                    <form method="post" action="/api/teams/@TeamId/members/@membership.Id/remove">
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public ICollection<TeamMembership> Memberships { get; set; } = [];
    [Parameter] public long TeamId { get; set; }
    [Parameter] public bool IsManager { get; set; }

    private int ActiveCount => Memberships.Count(m => m.Active);
}
