@using Bloodsport.Entity.Database

<div>
    <div>
        <div>
            <div>Tournament Lobby</div>
            @if (TournamentCode is not null)
            {
                <LobbyCodeDisplay Code="@TournamentCode" />
            }
            else
            {
                <div>No code yet</div>
                @if (IsManager)
                {
                    @if (RoundEnded)
                    {
                        <div>This round has ended — lobby codes can no longer be generated</div>
                    }
                    else
                    {
                        <div>Generate one below to create the custom lobby</div>
                    }
                }
                else
                {
                    <div>A team manager must generate the lobby code</div>
                }
            }
        </div>
        <div>
            @if (IsManager && TournamentCode is null && !RoundEnded)
            {
                <form method="post" action="/api/playoff-matchups/@MatchupId/tournament-code">
                    <AntiforgeryToken />
                    <button type="submit">Generate Lobby Code</button>
                </form>
            }
            @if (IsManager && TournamentCode is not null)
            {
                <div>
                    <form method="post" action="/api/playoff-matchups/@MatchupId/fetch-lobby-events">
                        <AntiforgeryToken />
                        <button type="submit">Fetch Lobby Events</button>
                    </form>
                    <div>Use this if there is a dispute about who participated in the lobby.</div>
                </div>
            }
        </div>
    </div>
    @if (Error == "tournament_not_configured")
    {
        <div>This playoff has not been configured with a Riot tournament ID. An admin must set it up before lobby codes can be generated.</div>
    }
    else if (Error == "riot_api_error")
    {
        <div>Failed to generate a lobby code from the Riot API. Please try again.</div>
    }
    else if (Error == "round_ended")
    {
        <div>This round has ended — lobby codes can no longer be generated.</div>
    }
    else if (Info == "lobby_events_requested")
    {
        <div>Lobby events have been requested and will be fetched shortly.</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public long MatchupId { get; set; }
    [Parameter, EditorRequired] public bool IsManager { get; set; }
    [Parameter, EditorRequired] public bool RoundEnded { get; set; }
    [Parameter] public string? TournamentCode { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Info { get; set; }
}
