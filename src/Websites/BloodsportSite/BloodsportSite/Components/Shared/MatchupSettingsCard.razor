@using Bloodsport.Entity.Database

@if (Parameters is not null)
{
    <div class="card @CssClass">
        <h2 class="section-title mb-3">Matchup Settings</h2>
        <dl class="grid grid-cols-[140px_1fr] gap-y-2 text-sm">
            <dt class="font-medium text-gray-500">Team Size</dt>
            <dd class="text-gray-700">@(Parameters.TeamSize)v@(Parameters.TeamSize)</dd>

            <dt class="font-medium text-gray-500">Pick Type</dt>
            <dd class="text-gray-700">@Humanize(Parameters.PickType)</dd>

            <dt class="font-medium text-gray-500">Map</dt>
            <dd class="text-gray-700">@Humanize(Parameters.MapType)</dd>

            <dt class="font-medium text-gray-500">Spectators</dt>
            <dd class="text-gray-700">@Humanize(Parameters.SpectatorType)</dd>
        </dl>
    </div>
}

@code {
    [Parameter] public SeasonMatchupParameters? Parameters { get; set; }

    /// <summary>Extra CSS classes applied to the card wrapper (e.g. margin utilities).</summary>
    [Parameter] public string? CssClass { get; set; }

    // Riot returns SCREAMING_SNAKE_CASE tokens; show friendly labels instead.
    private static string Humanize(string value) => value switch
    {
        "BLIND_PICK" => "Blind Pick",
        "DRAFT_MODE" => "Draft Mode",
        "ALL_RANDOM" => "All Random",
        "TOURNAMENT_DRAFT" => "Tournament Draft",
        "SUMMONERS_RIFT" => "Summoner's Rift",
        "HOWLING_ABYSS" => "Howling Abyss",
        "NONE" => "None",
        "LOBBYONLY" => "Lobby Only",
        "ALL" => "All",
        _ => value,
    };
}
