@using Bloodsport.Entity.Database

@if (Result is { } result)
{
    @if (result.DidNotPlay)
    {
        <div class="card">
            <div class="mb-3 flex items-center justify-between">
                <div class="eyebrow">Match Result</div>
                <div class="text-xs text-gray-400">Recorded @result.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</div>
            </div>
            <div class="flex items-start gap-3">
                <span class="text-2xl">&#10060;</span>
                @if (result.WinnerTeamId is not null)
                {
                    <div>
                        <div class="font-semibold text-gray-900">Forfeit</div>
                        <div class="text-sm text-gray-600">A team manually forfeited. <a href="/teams/@result.WinnerTeamId" class="link">@result.WinnerTeam?.Name</a> has been awarded the win.</div>
                    </div>
                }
                else
                {
                    <div>
                        <div class="font-semibold text-gray-900">Did Not Play</div>
                        <div class="text-sm text-gray-600">This match was not played before the week ended.</div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="mb-3 flex items-center justify-between">
                <div class="eyebrow">Match Result</div>
                <div class="text-xs text-gray-400">Recorded @result.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</div>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-2xl">&#127942;</span>
                <div>
                    <div class="font-semibold text-gray-900">
                        <a href="/teams/@result.WinnerTeamId" class="link">@result.WinnerTeam?.Name</a>
                    </div>
                    <div class="text-sm text-gray-500">Winner</div>
                </div>
            </div>
            @if (result.RosterMismatch)
            {
                <div class="alert alert-warning mt-3">
                    <strong>Roster Mismatch Detected:</strong> One or more players in this match did not match the locked season roster for their team. This result may be subject to review.
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public SeasonWeekMatchupResult? Result { get; set; }
}
