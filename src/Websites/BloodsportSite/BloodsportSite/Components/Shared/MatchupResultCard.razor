@using Bloodsport.Entity.Database

@if (Result is { } result)
{
    @if (result.DidNotPlay)
    {
        <div class="card border-0 bg-secondary-subtle rounded-3 mb-3 p-4">
            <div class="text-uppercase fw-semibold small text-secondary-emphasis letter-spacing-1 mb-3">Match Result</div>
            <div class="d-flex align-items-center gap-3 mb-2">
                <span class="fs-1">&#10060;</span>
                <div>
                    <div class="fs-4 fw-bold text-secondary-emphasis">Did Not Play</div>
                    <div class="small text-muted">This match was not played before the week ended.</div>
                </div>
            </div>
            <div class="text-muted small">Recorded @result.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</div>
        </div>
    }
    else
    {
        <div class="card border-0 bg-success-subtle rounded-3 mb-3 p-4">
            <div class="text-uppercase fw-semibold small text-success-emphasis letter-spacing-1 mb-3">Match Result</div>
            <div class="d-flex align-items-center gap-3 mb-2">
                <span class="fs-1">&#127942;</span>
                <div>
                    <div class="fs-4 fw-bold text-success-emphasis">
                        <a href="/teams/@result.WinnerTeamId" class="text-success-emphasis text-decoration-none">@result.WinnerTeam?.Name</a>
                    </div>
                    <div class="small text-muted">Winner</div>
                </div>
            </div>
            <div class="text-muted small">Recorded @result.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</div>
            @if (result.RosterMismatch)
            {
                <div class="alert alert-warning mb-0 mt-3 py-2 small">
                    <strong>Roster Mismatch Detected:</strong> One or more players in this match did not match the locked season roster for their team. This result may be subject to review.
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public SeasonWeekMatchupResult? Result { get; set; }
}
