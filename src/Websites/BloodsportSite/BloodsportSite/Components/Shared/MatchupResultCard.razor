@using Bloodsport.Entity.Database

@if (Result is { } result)
{
    @if (result.DidNotPlay)
    {
        <div>
            <div>
                <div>Match Result</div>
                <div>Recorded @result.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</div>
            </div>
            <div>
                <span>&#10060;</span>
                @if (result.WinnerTeamId is not null)
                {
                    <div>
                        <div>Forfeit</div>
                        <div>A team manually forfeited. <a href="/teams/@result.WinnerTeamId">@result.WinnerTeam?.Name</a> has been awarded the win.</div>
                    </div>
                }
                else
                {
                    <div>
                        <div>Did Not Play</div>
                        <div>This match was not played before the week ended.</div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div>
            <div>
                <div>Match Result</div>
                <div>Recorded @result.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</div>
            </div>
            <div>
                <span>&#127942;</span>
                <div>
                    <div>
                        <a href="/teams/@result.WinnerTeamId">@result.WinnerTeam?.Name</a>
                    </div>
                    <div>Winner</div>
                </div>
            </div>
            @if (result.RosterMismatch)
            {
                <div>
                    <strong>Roster Mismatch Detected:</strong> One or more players in this match did not match the locked season roster for their team. This result may be subject to review.
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public SeasonWeekMatchupResult? Result { get; set; }
}
