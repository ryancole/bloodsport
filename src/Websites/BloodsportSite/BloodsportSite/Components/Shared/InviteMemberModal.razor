@using Bloodsport.Entity.Database

<details class="rounded-lg border border-gray-200 bg-white p-4">
    <summary class="cursor-pointer font-medium text-gray-900">Invite Member</summary>
    <form method="post" action="/api/teams/@TeamId/invite" class="mt-3 space-y-3">
        <AntiforgeryToken />
        <div>
            <label class="label">Game Name</label>
            <input type="text" name="gameName" placeholder="HideOnBush" required class="input w-64" />
        </div>
        <div>
            <label class="label">Tag</label>
            <input type="text" name="tagLine" placeholder="NA1" required class="input w-32" />
        </div>
        <button type="submit" class="btn btn-primary">Send Invite</button>
    </form>
</details>

@code {
    [Parameter, EditorRequired] public long TeamId { get; set; }
}
