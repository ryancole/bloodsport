@using Bloodsport.Entity.Database

<details>
    <summary>Invite Member</summary>
    <form method="post" action="/api/teams/@TeamId/invite">
        <AntiforgeryToken />
        <p>
            <label>Game Name<br /><input type="text" name="gameName" placeholder="HideOnBush" required /></label>
        </p>
        <p>
            <label>Tag<br /><input type="text" name="tagLine" placeholder="NA1" required /></label>
        </p>
        <button type="submit">Send Invite</button>
    </form>
</details>

@code {
    [Parameter, EditorRequired] public long TeamId { get; set; }
}
