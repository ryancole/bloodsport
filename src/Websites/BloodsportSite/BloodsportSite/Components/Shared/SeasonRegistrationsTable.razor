@using Bloodsport.Entity.Database

@{
    var sorted = Registrations.OrderBy(r => r.Team.Name).ToList();
    var totalPages = (int)Math.Ceiling(sorted.Count / (double)PageSize);
    var page = CurrentPage < 1 ? 1 : CurrentPage;
    var pageItems = sorted.Skip((page - 1) * PageSize).Take(PageSize);
}

<div>
    <h2>Registered Teams</h2>
    <Pager CurrentPage="page" TotalPages="totalPages" PageUrl="PageUrl" />
</div>

@if (Registrations.Count == 0)
{
    <p>No teams registered yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Team</th>
                <th>Manager</th>
                <th>Registered</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reg in pageItems)
            {
                <tr>
                    <td><a href="/teams/@reg.Team.Id"><TeamFlag LogoUrl="@reg.Team.LogoUrl" />@reg.Team.Name</a></td>
                    <td><a href="/users/@reg.Team.Manager.Id"><UserFlag LogoUrl="@reg.Team.Manager.LogoUrl" />@reg.Team.Manager.DisplayName</a></td>
                    <td>@reg.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const int PageSize = 20;

    [Parameter, EditorRequired] public long SeasonId { get; set; }
    [Parameter, EditorRequired] public ICollection<SeasonRegistration> Registrations { get; set; } = [];
    [Parameter] public int CurrentPage { get; set; } = 1;

    private string PageUrl(int p) => $"/seasons/{SeasonId}?teamsPage={p}";
}
