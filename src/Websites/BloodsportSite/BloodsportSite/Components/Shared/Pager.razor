@{
    var windowStart = Math.Max(1, Math.Min(CurrentPage - Window / 2, TotalPages - Window + 1));
    var windowEnd = Math.Min(TotalPages, windowStart + Window - 1);
}

@if (TotalPages > 1)
{
    <nav class="flex flex-wrap items-center gap-1 @NavClass">
        <a href="@PageUrl(CurrentPage - 1)" class="rounded border border-gray-200 px-3 py-1 text-sm text-gray-700 no-underline hover:bg-gray-100 @(CurrentPage == 1 ? "pointer-events-none opacity-40" : "")">Previous</a>
        @if (windowStart > 1)
        {
            <span class="px-2 text-sm text-gray-400">…</span>
        }
        @for (var p = windowStart; p <= windowEnd; p++)
        {
            var pageNum = p;
            <a href="@PageUrl(pageNum)" class="rounded border px-3 py-1 text-sm no-underline @(CurrentPage == pageNum ? "border-brand-600 bg-brand-600 text-white" : "border-gray-200 text-gray-700 hover:bg-gray-100")">@pageNum</a>
        }
        @if (windowEnd < TotalPages)
        {
            <span class="px-2 text-sm text-gray-400">…</span>
        }
        <a href="@PageUrl(CurrentPage + 1)" class="rounded border border-gray-200 px-3 py-1 text-sm text-gray-700 no-underline hover:bg-gray-100 @(CurrentPage == TotalPages ? "pointer-events-none opacity-40" : "")">Next</a>
    </nav>
}

@code {
    private const int Window = 5;

    [Parameter, EditorRequired] public int CurrentPage { get; set; }
    [Parameter, EditorRequired] public int TotalPages { get; set; }
    [Parameter, EditorRequired] public Func<int, string> PageUrl { get; set; } = _ => "#";
    [Parameter] public string NavClass { get; set; } = "";
}
