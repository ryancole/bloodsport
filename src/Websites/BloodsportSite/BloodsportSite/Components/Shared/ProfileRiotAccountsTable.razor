@using Bloodsport.Entity.Database

<div class="mb-4">
    <h2 class="mb-3 text-lg font-semibold text-gray-900">Riot Accounts</h2>
    <form method="post" action="/api/riot/link" class="space-y-3">
        <AntiforgeryToken />
        @if (RiotError is not null)
        {
            <div class="alert alert-danger">@RiotError</div>
        }
        <div class="flex flex-wrap items-end gap-3">
            <div>
                <label class="label">Game Name</label>
                <input type="text" name="gameName" placeholder="HideOnBush" required class="input w-48" />
            </div>
            <div>
                <label class="label">Tag</label>
                <input type="text" name="tagLine" placeholder="NA1" required class="input w-28" />
            </div>
            <button type="submit" class="btn btn-primary">Link Riot Account</button>
        </div>
    </form>
</div>

@if (Accounts.Count == 0)
{
    <p class="text-sm text-gray-500">No linked accounts.</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="tbl">
            <thead>
                <tr><th>Riot ID</th><th>Linked</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var account in Accounts.OrderBy(a => a.GameName))
                {
                    <tr>
                        <td><a href="https://u.gg/lol/profile/na1/@Uri.EscapeDataString(account.GameName)-@Uri.EscapeDataString(account.TagLine)/overview" target="_blank" rel="noopener noreferrer" class="link"><strong>@account.GameName#@account.TagLine</strong></a></td>
                        <td>@account.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                        <td>
                            <form method="post" action="/api/riot/unlink">
                                <AntiforgeryToken />
                                <input type="hidden" name="riotAccountId" value="@account.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public ICollection<RiotAccount> Accounts { get; set; } = [];
    [Parameter] public string? RiotError { get; set; }
}
