@using Bloodsport.Entity.Database

<div class="db-card dpp">
    <div class="db-card-keyline"></div>
    <div class="db-card-head">
        <span class="db-eyebrow">Recent playoffs</span>
        <a href="/playoffs" class="db-see-all">All →</a>
    </div>
    @if (Playoffs.Count == 0)
    {
        <p class="db-empty">No playoffs yet.</p>
    }
    else
    {
        <div class="dpp-list">
            @foreach (var playoff in Playoffs)
            {
                var dateEnd = playoff.PlayoffRounds.Select(r => r.DateEnd).Where(d => d.HasValue).Max(d => d);
                <div class="dpp-row">
                    <a href="/playoffs/@playoff.Id" class="dpp-name">@playoff.Name</a>
                    <span class="dpp-badge @PlayoffBadgeClass(playoff.Status)">@playoff.Status</span>
                    <span class="dpp-date">
                        <span class="dpp-date-label">starts</span>
                        @playoff.DateCreated.ToLocalTime().ToString("MMM d, yyyy")
                    </span>
                    <span class="dpp-date">
                        <span class="dpp-date-label">ends</span>
                        @(dateEnd.HasValue ? dateEnd.Value.ToLocalTime().ToString("MMM d, yyyy") : "TBD")
                    </span>
                </div>
            }
        </div>
    }
</div>

<style>
    .dpp-list { padding: 8px 0 4px; }
    .dpp-row {
        display: grid;
        grid-template-columns: 1fr auto auto auto;
        align-items: center;
        gap: 10px;
        padding: 10px 20px;
        border-bottom: 1px solid var(--cal-border-faint);
        transition: background var(--cal-dur-fast) var(--cal-ease);
    }
    .dpp-row:last-child { border-bottom: none; }
    .dpp-row:hover { background: var(--cal-surface-3); }
    .dpp-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--cal-text);
        text-decoration: none;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
        transition: color var(--cal-dur) var(--cal-ease);
    }
    .dpp-name:hover { color: var(--cal-cyan); }
    .dpp-badge {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: var(--cal-radius-pill);
        font-family: var(--cal-font-mono);
        font-weight: 600;
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        white-space: nowrap;
        background: var(--cal-surface-3);
        color: var(--cal-text-muted);
        flex-shrink: 0;
    }
    .dpp-badge--active { background: var(--cal-cyan-ghost); color: var(--cal-cyan); }
    .dpp-badge--completed { background: var(--cal-border); color: var(--cal-text-faint); }
    .dpp-date {
        font-family: var(--cal-font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        color: var(--cal-text-faint);
        white-space: nowrap;
        flex-shrink: 0;
    }
    .dpp-date-label {
        text-transform: uppercase;
        opacity: 0.6;
        margin-right: 3px;
    }
</style>

@code {
    [Parameter, EditorRequired] public List<Playoff> Playoffs { get; set; } = [];

    private static string PlayoffBadgeClass(PlayoffStatus status) => status switch
    {
        PlayoffStatus.Active    => "dpp-badge--active",
        PlayoffStatus.Completed => "dpp-badge--completed",
        _                       => "",
    };
}
