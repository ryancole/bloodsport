@using Bloodsport.Entity.Database

<div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Recent playoffs</span>
        <a href="/playoffs" class="text-sm text-sky-600 no-underline hover:text-sky-700">All →</a>
    </div>
    @if (Playoffs.Count == 0)
    {
        <p class="text-sm text-gray-500">No playoffs yet.</p>
    }
    else
    {
        <div class="divide-y divide-gray-100">
            @foreach (var playoff in Playoffs)
            {
                var dateEnd = playoff.PlayoffRounds.Select(r => r.DateEnd).Where(d => d.HasValue).Max(d => d);
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 py-2">
                    <a href="/playoffs/@playoff.Id" class="font-medium text-gray-900 no-underline hover:text-sky-600">@playoff.Name</a>
                    <PlayoffStatusBadge Status="playoff.Status" />
                    <span class="ml-auto text-xs text-gray-400">
                        <span class="uppercase tracking-wide">starts</span>
                        @playoff.DateCreated.ToLocalTime().ToString("MMM d, yyyy")
                    </span>
                    <span class="text-xs text-gray-400">
                        <span class="uppercase tracking-wide">ends</span>
                        @(dateEnd.HasValue ? dateEnd.Value.ToLocalTime().ToString("MMM d, yyyy") : "TBD")
                    </span>
                </div>
            }
        </div>
    }
</div>


@code {
    [Parameter, EditorRequired] public List<Playoff> Playoffs { get; set; } = [];
}
