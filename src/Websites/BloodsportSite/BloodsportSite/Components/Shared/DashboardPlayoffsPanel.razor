@using Bloodsport.Entity.Database

<div class="db-card dpp">
    <div class="db-card-keyline"></div>
    <div class="db-card-head">
        <span class="db-eyebrow">Recent playoffs</span>
        <a href="/playoffs" class="db-see-all">All →</a>
    </div>
    @if (Playoffs.Count == 0)
    {
        <p class="db-empty">No playoffs yet.</p>
    }
    else
    {
        <div class="dpp-list">
            @foreach (var playoff in Playoffs)
            {
                var dateEnd = playoff.PlayoffRounds.Select(r => r.DateEnd).Where(d => d.HasValue).Max(d => d);
                <div class="dpp-row">
                    <a href="/playoffs/@playoff.Id" class="dpp-name">@playoff.Name</a>
                    <span class="dpp-badge @PlayoffBadgeClass(playoff.Status)">@playoff.Status</span>
                    <span class="dpp-date">
                        <span class="dpp-date-label">starts</span>
                        @playoff.DateCreated.ToLocalTime().ToString("MMM d, yyyy")
                    </span>
                    <span class="dpp-date">
                        <span class="dpp-date-label">ends</span>
                        @(dateEnd.HasValue ? dateEnd.Value.ToLocalTime().ToString("MMM d, yyyy") : "TBD")
                    </span>
                </div>
            }
        </div>
    }
</div>


@code {
    [Parameter, EditorRequired] public List<Playoff> Playoffs { get; set; } = [];

    private static string PlayoffBadgeClass(PlayoffStatus status) => status switch
    {
        PlayoffStatus.Active    => "dpp-badge--active",
        PlayoffStatus.Completed => "dpp-badge--completed",
        _                       => "",
    };
}
