@using Bloodsport.Entity.Database

<div class="dashboard-panel">
    <h2 class="dashboard-panel-title">Recent playoffs</h2>
    @if (Playoffs.Count == 0)
    {
        <p class="text-muted">No playoffs yet.</p>
    }
    else
    {
        @foreach (var playoff in Playoffs)
        {
            <div class="dashboard-list-item">
                <a href="/playoffs/@playoff.Id" class="dashboard-list-name">@playoff.Name</a>
                <div class="dashboard-list-meta">
                    <PlayoffStatusBadge Status="playoff.Status" />
                </div>
                @{ var dateEnd = playoff.PlayoffRounds.Select(r => r.DateEnd).Where(d => d.HasValue).Max(d => d); }
                <span class="dpp-date"><span class="dpp-date-label">starts</span> @playoff.DateCreated.ToLocalTime().ToString("MMM d, yyyy")</span>
                <span class="dpp-date"><span class="dpp-date-label">ends</span> @(dateEnd.HasValue ? dateEnd.Value.ToLocalTime().ToString("MMM d, yyyy") : "TBD")</span>
            </div>
        }
    }
</div>

<style>
    .dpp-date {
        font-size: 12px;
        color: var(--bs-secondary-color, #6c757d);
        flex-shrink: 0;
        white-space: nowrap;
        text-align: right;
    }

    .dpp-date-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        opacity: 0.6;
        margin-right: 3px;
    }
</style>

@code {
    [Parameter, EditorRequired] public List<Playoff> Playoffs { get; set; } = [];
}
