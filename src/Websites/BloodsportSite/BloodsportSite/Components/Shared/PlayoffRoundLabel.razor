@using Bloodsport.Entity.Database

<div class="px-2 text-center text-xs font-semibold uppercase tracking-wider text-gray-500" title="@(Round.DateEnd.HasValue ? $"Ends {Round.DateEnd.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt")}" : null)">@Round.Name</div>

@code {
    [Parameter] public required PlayoffRound Round { get; set; }
}
