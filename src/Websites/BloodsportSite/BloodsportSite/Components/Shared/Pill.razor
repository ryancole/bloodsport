@* Global pill/badge. Color drives the palette; an optional icon renders as a glyph,
   in a filled circle by default (the dashboard status-pill style) or bare when
   IconCircle is false. See PillColor.cs and StatusIcons.cs. *@
<span class="badge @(HasIcon ? "gap-1.5" : null) @ColorClass @Class" title="@Title">
    @if (HasIcon)
    {
        if (IconCircle)
        {
            <span class="inline-flex h-4 w-4 items-center justify-center rounded-full text-black @CircleClass">
                <Icon Path="@IconPath" />
            </span>
        }
        else
        {
            <Icon Path="@IconPath" />
        }
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
</span>

@code {
    [Parameter] public PillColor Color { get; set; } = PillColor.Gray;

    /// <summary>Heroicons (20/solid) SVG path data, e.g. <c>StatusIcons.Bolt</c>. Optional.</summary>
    [Parameter] public string? IconPath { get; set; }

    /// <summary>Wrap the icon in a filled circle (status-pill style). Set false for a bare glyph.</summary>
    [Parameter] public bool IconCircle { get; set; } = true;

    /// <summary>Label text. Ignored when <see cref="ChildContent"/> is supplied.</summary>
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional tooltip.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Extra utility classes, e.g. layout spacing like <c>mb-2</c>.</summary>
    [Parameter] public string? Class { get; set; }

    private bool HasIcon => !string.IsNullOrEmpty(IconPath);

    private string ColorClass => Color switch
    {
        PillColor.Green  => "bg-green-100 text-green-700",
        PillColor.Amber  => "bg-amber-100 text-amber-700",
        PillColor.Sky    => "bg-sky-100 text-sky-700",
        PillColor.Red    => "bg-red-100 text-red-700",
        PillColor.Purple => "bg-purple-100 text-purple-700",
        _                => "bg-gray-100 text-gray-600",
    };

    private string CircleClass => Color switch
    {
        PillColor.Green  => "bg-green-300",
        PillColor.Amber  => "bg-amber-300",
        PillColor.Sky    => "bg-sky-300",
        PillColor.Red    => "bg-red-300",
        PillColor.Purple => "bg-purple-300",
        _                => "bg-gray-300",
    };
}
