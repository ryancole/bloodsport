@using Bloodsport.Entity.Database

@{
    var sorted = Teams.OrderBy(t => t.Name).ToList();
    var totalPages = (int)Math.Ceiling(sorted.Count / (double)PageSize);
    var page = CurrentPage < 1 ? 1 : CurrentPage;
    var pageItems = sorted.Skip((page - 1) * PageSize).Take(PageSize);
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div class="d-flex align-items-center gap-3">
        <form method="get" class="d-flex gap-2">
            <input type="search" name="search" class="form-control w-auto" placeholder="Search by team name…" />
            <button type="submit" class="btn btn-secondary">Search</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Search))
        {
            <span class="text-muted">
                Filtering by &ldquo;@Search&rdquo;
                <a href="/teams" class="ms-1 text-decoration-none" title="Clear filter">&times;</a>
            </span>
        }
    </div>
    <Pager CurrentPage="page" TotalPages="totalPages" PageUrl="PageUrl" NavClass="d-flex" />
</div>

@if (!sorted.Any())
{
    <p class="text-center text-muted fs-5 py-4">No teams found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Manager</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var team in pageItems)
            {
                <tr>
                    <td><a href="/teams/@team.Id" class="d-flex align-items-center gap-2"><TeamFlag LogoUrl="@team.LogoUrl" />@team.Name</a></td>
                    <td><a href="/users/@team.Manager.Id">@team.Manager.DisplayName</a></td>
                    <td>@team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const int PageSize = 20;

    [Parameter, EditorRequired] public ICollection<Team> Teams { get; set; } = [];
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public string? Search { get; set; }

    private string PageUrl(int p) => string.IsNullOrWhiteSpace(Search)
        ? $"/teams?page={p}"
        : $"/teams?search={Uri.EscapeDataString(Search)}&page={p}";
}
