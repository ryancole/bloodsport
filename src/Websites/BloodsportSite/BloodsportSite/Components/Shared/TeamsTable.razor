@using Bloodsport.Entity.Database

@{
    var sorted = Teams.OrderBy(t => t.Name).ToList();
    var totalPages = (int)Math.Ceiling(sorted.Count / (double)PageSize);
    var page = CurrentPage < 1 ? 1 : CurrentPage;
    var pageItems = sorted.Skip((page - 1) * PageSize).Take(PageSize);
}

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-3">
        <form method="get" class="flex items-center gap-2">
            <input type="search" name="search" placeholder="Search by team name…" class="input w-64" />
            <button type="submit" class="btn btn-secondary">Search</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Search))
        {
            <span class="text-sm text-gray-500">
                Filtering by &ldquo;@Search&rdquo;
                <a href="/teams" class="link" title="Clear filter">&times;</a>
            </span>
        }
    </div>
    <Pager CurrentPage="page" TotalPages="totalPages" PageUrl="PageUrl" />
</div>

@if (!sorted.Any())
{
    <p class="text-sm text-gray-500">No teams found.</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="tbl">
            <thead>
                <tr><th>Name</th><th>Manager</th><th>Created</th></tr>
            </thead>
            <tbody>
                @foreach (var team in pageItems)
                {
                    <tr>
                        <td><a href="/teams/@team.Id" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@team.LogoUrl" />@team.Name</a></td>
                        <td><a href="/users/@team.Manager.Id" class="link inline-flex items-center gap-2"><UserFlag LogoUrl="@team.Manager.LogoUrl" />@team.Manager.DisplayName</a></td>
                        <td>@team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const int PageSize = 20;

    [Parameter, EditorRequired] public ICollection<Team> Teams { get; set; } = [];
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public string? Search { get; set; }

    private string PageUrl(int p) => string.IsNullOrWhiteSpace(Search)
        ? $"/teams?page={p}"
        : $"/teams?search={Uri.EscapeDataString(Search)}&page={p}";
}
