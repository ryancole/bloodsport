@using Bloodsport.Entity.Database

<span class="badge @BadgeClass">@Status</span>

@code {
    [Parameter] public SeasonStatus Status { get; set; }

    private string BadgeClass => Status switch
    {
        SeasonStatus.Active    => "bg-green-100 text-green-700",
        SeasonStatus.Upcoming  => "bg-sky-100 text-sky-700",
        SeasonStatus.PreSeason => "bg-amber-100 text-amber-700",
        SeasonStatus.Completed => "bg-gray-100 text-gray-600",
        _                      => "bg-gray-100 text-gray-600",
    };
}
