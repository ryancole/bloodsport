@using Bloodsport.Entity.Database

<Pill Color="@BadgeColor" IconPath="@StatusIcon" Title="@Status.ToString()">@Status</Pill>

@code {
    [Parameter] public SeasonStatus Status { get; set; }

    private PillColor BadgeColor => Status switch
    {
        SeasonStatus.Active    => PillColor.Green,
        SeasonStatus.Upcoming  => PillColor.Sky,
        SeasonStatus.PreSeason => PillColor.Amber,
        SeasonStatus.Completed => PillColor.Gray,
        _                      => PillColor.Gray,
    };

    private string StatusIcon => Status switch
    {
        SeasonStatus.Active    => StatusIcons.Bolt,
        SeasonStatus.Completed => StatusIcons.Check,
        _                      => StatusIcons.Clock,
    };
}
