@using Bloodsport.Entity.Database
@inject BloodsportSite.Services.BlobSasService BlobSasService

@if (flagUrl is not null)
{
    <img src="@flagUrl" width="28" height="18" style="object-fit:cover;flex-shrink:0;border-radius:3px;border:1px solid var(--cal-border-strong);box-shadow:var(--cal-shadow-sm);" alt="" />
}
else
{
    <span style="display:inline-block;width:28px;height:18px;flex-shrink:0;background:var(--cal-surface-3);border:1px solid var(--cal-border);border-radius:3px;"></span>
}

@code {
    [Parameter, EditorRequired] public string? LogoUrl { get; set; }

    private string? flagUrl => BlobSasService.GetSasUrl(LogoUrl?.Replace("/original.", "/flag."));
}
