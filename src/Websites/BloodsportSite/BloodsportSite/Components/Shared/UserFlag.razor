@using Bloodsport.Entity.Database
@inject BloodsportSite.Services.BlobSasService BlobSasService

@if (flagUrl is not null)
{
    <img src="@flagUrl" width="28" height="18" class="flex-shrink-0 rounded-[2px] object-cover ring-1 @(OnDark ? "ring-white/25" : "ring-black/20")" alt="" />
}
else
{
    <span class="inline-flex items-center justify-center flex-shrink-0 rounded-[2px] ring-1 @(OnDark ? "ring-white/25 bg-white/10 text-white/60" : "ring-black/20 bg-gray-100 text-gray-400")"
          style="width:28px;height:18px;">
        <svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <circle cx="8" cy="5" r="3" />
            <path d="M2 14c0-3.3 2.7-5 6-5s6 1.7 6 5z" />
        </svg>
    </span>
}

@code {
    [Parameter, EditorRequired] public string? LogoUrl { get; set; }

    /// <summary>Use a light ring instead of dark, for placement on dark surfaces like the top nav.</summary>
    [Parameter] public bool OnDark { get; set; }

    private string? flagUrl => BlobSasService.GetSasUrl(LogoUrl?.Replace("/original.", "/flag."));
}
