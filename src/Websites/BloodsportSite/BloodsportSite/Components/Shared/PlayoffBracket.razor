@using Bloodsport.Entity.Database
@using System.Text.Json

@{
    var orderedRounds = Rounds
        .OrderByDescending(r => r.PlayoffMatchups.Count)
        .ToList();

    var canvasId = $"bracket-canvas-{PlayoffId}";

    string? dataJson = null;
    if (orderedRounds.Any())
    {
        var bracketData = new
        {
            playoffId = PlayoffId,
            rounds = orderedRounds.Select(r => new
            {
                name = r.Name,
                matchups = r.PlayoffMatchups.OrderBy(m => m.MatchNumber).Select(m => new
                {
                    id            = m.Id,
                    teamOne       = m.TeamOne != null ? (object)new { seed = m.TeamOne.Seed, name = m.TeamOne.Team?.Name ?? "Unknown", logoUrl = m.TeamOne.Team?.LogoUrl?.Replace("/original.", "/flag."), myTeam = MyTeamIds.Contains(m.TeamOne.TeamId) } : null,
                    teamTwo       = m.TeamTwo != null ? (object)new { seed = m.TeamTwo.Seed, name = m.TeamTwo.Team?.Name ?? "Unknown", logoUrl = m.TeamTwo.Team?.LogoUrl?.Replace("/original.", "/flag."), myTeam = MyTeamIds.Contains(m.TeamTwo.TeamId) } : null,
                    teamOneWinner = m.PlayoffRoundMatchupResults.Any(r => r.WinningTeamId == m.TeamOneId),
                    teamTwoWinner = m.PlayoffRoundMatchupResults.Any(r => r.WinningTeamId == m.TeamTwoId)
                }).ToList()
            }).ToList()
        };

        dataJson = JsonSerializer.Serialize(bracketData);
    }
}

@if (!orderedRounds.Any())
{
    <p class="text-muted fst-italic">Bracket has not been built yet.</p>
}
else
{
    <div class="bracket-canvas-wrapper">
        <div class="bracket-toolbar">
            <button class="bracket-btn" type="button" onclick="window._bc?.zoomIn?.('@canvasId')" title="Zoom in">+</button>
            <button class="bracket-btn" type="button" onclick="window._bc?.fit?.('@canvasId')"    title="Fit to view">Fit</button>
            <button class="bracket-btn" type="button" onclick="window._bc?.zoomOut?.('@canvasId')" title="Zoom out">−</button>
        </div>
        <canvas id="@canvasId" data-bracket="@dataJson"></canvas>
    </div>
}

@code {
    [Parameter] public List<PlayoffRound> Rounds { get; set; } = [];
    [Parameter] public long PlayoffId { get; set; }
    [Parameter] public HashSet<long> MyTeamIds { get; set; } = [];
}
