@using Bloodsport.Entity.Database

@{
    // most matchups = first round played (leftmost column)
    var orderedRounds = Rounds
        .OrderByDescending(r => r.PlayoffMatchups.Count)
        .ToList();
}

@if (!Rounds.Any())
{
    <p class="text-muted fst-italic">Bracket has not been built yet.</p>
}
else
{
    <div class="playoff-bracket-outer">

        @* Header row: round labels *@
        <div class="bracket-header">
            @for (int ri = 0; ri < orderedRounds.Count; ri++)
            {
                var round = orderedRounds[ri];
                <PlayoffRoundLabel Round="round" />
                @if (ri < orderedRounds.Count - 1)
                {
                    <div class="bracket-connector-spacer"></div>
                }
            }
        </div>

        @* Body row: matchup slots interleaved with connector columns *@
        <div class="bracket-body">
            @for (int ri = 0; ri < orderedRounds.Count; ri++)
            {
                var round = orderedRounds[ri];
                var matchups = round.PlayoffMatchups.OrderBy(m => m.MatchNumber).ToList();
                bool isFirstRound = ri == 0;
                bool isLastRound = ri == orderedRounds.Count - 1;

                <div class="bracket-slots">
                    @foreach (var matchup in matchups)
                    {
                        <div class="bracket-slot @(isFirstRound ? "" : "has-left-stub")">
                            <a class="bracket-card text-decoration-none" href="/playoffs/@PlayoffId/matchups/@matchup.Id">
                                @TeamRow(matchup.TeamOne, matchup.WinningTeamId.HasValue && matchup.WinningTeamId == matchup.TeamOneId)
                                @TeamRow(matchup.TeamTwo, matchup.WinningTeamId.HasValue && matchup.WinningTeamId == matchup.TeamTwoId)
                            </a>
                        </div>

                    }
                </div>

                @if (!isLastRound)
                {
                    @* One connector-pair per two matchups in this round.
                       Each pair has flex:2, so it spans the same vertical space as two adjacent slots.
                       The ::before line runs from 25%-75% of the pair height, which aligns exactly
                       with the vertical centres of those two slots. *@
                    <div class="bracket-connector-col">
                        @for (int pi = 0; pi < matchups.Count / 2; pi++)
                        {
                            <div class="connector-pair"></div>
                        }
                    </div>
                }
            }
        </div>

    </div>
}

@code {
    [Parameter] public List<PlayoffRound> Rounds { get; set; } = [];
    [Parameter] public long PlayoffId { get; set; }

    private RenderFragment TeamRow(PlayoffTeam? team, bool isWinner) => __builder =>
    {
        <div class="@("bracket-team" + (isWinner ? " winner" : ""))">
            @if (team is not null)
            {
                <span class="bracket-seed">@team.Seed</span>
                <TeamFlag LogoUrl="@team.Team?.LogoUrl" />
                <span class="bracket-name">@(team.Team?.Name ?? "Unknown")</span>
            }
            else
            {
                <span class="bracket-seed text-muted">—</span>
                <span class="bracket-name text-muted">TBD</span>
            }
        </div>
    };
}
