@using Bloodsport.Entity.Database

<div class="dashboard-panel">
    <h2 class="dashboard-panel-title">Recent seasons</h2>
    @if (Seasons.Count == 0)
    {
        <p class="text-muted">No seasons yet.</p>
    }
    else
    {
        @foreach (var season in Seasons)
        {
            <div class="dashboard-list-item">
                <a href="/seasons/@season.Id" class="dashboard-list-name">@season.Name</a>
                <div class="dsp-badges">
                    <SeasonStatusBadge Status="season.Status" />
                    @if (season.RegistrationOpen)
                    {
                        <span class="badge bg-success">Registration Open</span>
                    }
                </div>
                <span class="dsp-date"><span class="dsp-date-label">starts</span> @(season.EstimatedDateStart.HasValue ? season.EstimatedDateStart.Value.ToLocalTime().ToString("MMM d, yyyy") : "TBD")</span>
                <span class="dsp-date"><span class="dsp-date-label">ends</span> @(season.EstimatedDateEnd.HasValue ? season.EstimatedDateEnd.Value.ToLocalTime().ToString("MMM d, yyyy") : "TBD")</span>
            </div>
        }
    }
</div>

<style>
    .dsp-badges {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .dsp-date {
        font-size: 12px;
        color: var(--bs-secondary-color, #6c757d);
        flex-shrink: 0;
        white-space: nowrap;
        text-align: right;
    }

    .dsp-date-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        opacity: 0.6;
        margin-right: 3px;
    }
</style>

@code {
    [Parameter, EditorRequired] public List<Season> Seasons { get; set; } = [];
}
