@using Bloodsport.Entity.Database

<div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Recent seasons</span>
        <a href="/seasons" class="text-sm text-sky-600 no-underline hover:text-sky-700">All →</a>
    </div>
    @if (Seasons.Count == 0)
    {
        <p class="text-sm text-gray-500">No seasons yet.</p>
    }
    else
    {
        <div class="divide-y divide-gray-100">
            @foreach (var season in Seasons)
            {
                <div class="flex flex-col gap-1 py-2 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-3 sm:gap-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <a href="/seasons/@season.Id" class="font-medium text-gray-900 no-underline hover:text-sky-600">@season.Name</a>
                        <SeasonStatusBadge Status="season.Status" />
                        @if (season.RegistrationOpen)
                        {
                            <Pill Color="PillColor.Green" IconPath="@StatusIcons.Check">Reg. Open</Pill>
                        }
                    </div>
                    <div class="flex items-center gap-3 sm:ml-auto">
                        <span class="text-xs text-gray-400">
                            <span class="uppercase tracking-wide">starts</span>
                            @(season.EstimatedDateStart.HasValue ? season.EstimatedDateStart.Value.ToLocalTime().ToString("MMM d, yyyy") : "TBD")
                        </span>
                        <span class="text-xs text-gray-400">
                            <span class="uppercase tracking-wide">ends</span>
                            @(season.EstimatedDateEnd.HasValue ? season.EstimatedDateEnd.Value.ToLocalTime().ToString("MMM d, yyyy") : "TBD")
                        </span>
                    </div>
                </div>
            }
        </div>
    }
</div>


@code {
    [Parameter, EditorRequired] public List<Season> Seasons { get; set; } = [];
}
