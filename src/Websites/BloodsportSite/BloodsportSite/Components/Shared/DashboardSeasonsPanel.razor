@using Bloodsport.Entity.Database

<div class="db-card dsp">
    <div class="db-card-keyline"></div>
    <div class="db-card-head">
        <span class="db-eyebrow">Recent seasons</span>
        <a href="/seasons" class="db-see-all">All →</a>
    </div>
    @if (Seasons.Count == 0)
    {
        <p class="db-empty">No seasons yet.</p>
    }
    else
    {
        <div class="dsp-list">
            @foreach (var season in Seasons)
            {
                <div class="dsp-row">
                    <a href="/seasons/@season.Id" class="dsp-name">@season.Name</a>
                    <div class="dsp-badges">
                        <span class="dsp-badge @SeasonBadgeClass(season.Status)">@season.Status</span>
                        @if (season.RegistrationOpen)
                        {
                            <span class="dsp-badge dsp-badge--reg">Reg. Open</span>
                        }
                    </div>
                    <span class="dsp-date">
                        <span class="dsp-date-label">starts</span>
                        @(season.EstimatedDateStart.HasValue ? season.EstimatedDateStart.Value.ToLocalTime().ToString("MMM d, yyyy") : "TBD")
                    </span>
                    <span class="dsp-date">
                        <span class="dsp-date-label">ends</span>
                        @(season.EstimatedDateEnd.HasValue ? season.EstimatedDateEnd.Value.ToLocalTime().ToString("MMM d, yyyy") : "TBD")
                    </span>
                </div>
            }
        </div>
    }
</div>


@code {
    [Parameter, EditorRequired] public List<Season> Seasons { get; set; } = [];

    private static string SeasonBadgeClass(SeasonStatus status) => status switch
    {
        SeasonStatus.Active    => "dsp-badge--active",
        SeasonStatus.PreSeason => "dsp-badge--preseason",
        _                      => "",
    };
}
