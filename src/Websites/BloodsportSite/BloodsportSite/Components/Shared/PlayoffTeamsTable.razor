@using Bloodsport.Entity.Database

@{
    var sorted = Teams.OrderBy(t => t.Seed).ToList();
    var totalPages = (int)Math.Ceiling(sorted.Count / (double)PageSize);
    var page = CurrentPage < 1 ? 1 : CurrentPage;
    var pageItems = sorted.Skip((page - 1) * PageSize).Take(PageSize);
}

<div class="mb-3 flex items-center justify-between">
    <h2 class="section-title">Teams</h2>
    <Pager CurrentPage="page" TotalPages="totalPages" PageUrl="PageUrl" />
</div>

@if (Teams.Count == 0)
{
    <p class="text-sm text-gray-500">No teams yet.</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="tbl">
            <thead>
                <tr><th>Seed</th><th>Team</th></tr>
            </thead>
            <tbody>
                @foreach (var pt in pageItems)
                {
                    <tr>
                        <td>@pt.Seed</td>
                        <td><a href="/teams/@pt.TeamId" class="link inline-flex items-center gap-2"><TeamFlag LogoUrl="@pt.Team.LogoUrl" />@pt.Team.Name</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const int PageSize = 10;

    [Parameter, EditorRequired] public long PlayoffId { get; set; }
    [Parameter, EditorRequired] public ICollection<PlayoffTeam> Teams { get; set; } = [];
    [Parameter] public int CurrentPage { get; set; } = 1;

    private string PageUrl(int p) => $"/playoffs/{PlayoffId}?tab=teams&teamsPage={p}";
}
