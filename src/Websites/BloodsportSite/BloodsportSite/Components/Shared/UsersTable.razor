@using Bloodsport.Entity.Database

@{
    var sorted = Users.OrderBy(u => u.DisplayName).ToList();
    var totalPages = (int)Math.Ceiling(sorted.Count / (double)PageSize);
    var page = CurrentPage < 1 ? 1 : CurrentPage;
    var pageItems = sorted.Skip((page - 1) * PageSize).Take(PageSize);
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div class="d-flex align-items-center gap-3">
        <form method="get" class="d-flex gap-2">
            <input type="search" name="search" class="form-control w-auto" placeholder="Search by name…" />
            <button type="submit" class="btn btn-secondary">Search</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Search))
        {
            <span class="text-muted">
                Filtering by &ldquo;@Search&rdquo;
                <a href="/users" class="ms-1 text-decoration-none" title="Clear filter">&times;</a>
            </span>
        }
    </div>
    <Pager CurrentPage="page" TotalPages="totalPages" PageUrl="PageUrl" NavClass="d-flex" />
</div>

@if (!sorted.Any())
{
    <p class="text-center text-muted fs-5 py-4">No users found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Teams</th>
                <th>Member Since</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in pageItems)
            {
                var teamNames = string.Join(", ", user.RiotAccounts
                    .SelectMany(a => a.TeamMemberships)
                    .Select(m => m.Team.Name)
                    .Distinct()
                    .OrderBy(n => n));

                <tr>
                    <td><a href="/users/@user.Id">@user.DisplayName</a></td>
                    <td style="max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @if (string.IsNullOrEmpty(teamNames))
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            @teamNames
                        }
                    </td>
                    <td>@user.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const int PageSize = 20;

    [Parameter, EditorRequired] public ICollection<User> Users { get; set; } = [];
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public string? Search { get; set; }

    private string PageUrl(int p) => string.IsNullOrWhiteSpace(Search)
        ? $"/users?page={p}"
        : $"/users?search={Uri.EscapeDataString(Search)}&page={p}";
}
