@if (FlagUrl is not null)
{
    <img src="@FlagUrl" width="28" height="18" style="object-fit:cover;flex-shrink:0;border-radius:2px;border:2px solid #f0b429;box-shadow:1px 1px 2px rgba(0,0,0,0.2);" alt="" />
}
else
{
    <span style="display:inline-block;width:28px;height:18px;flex-shrink:0;background:#dee2e6;border-radius:2px;"></span>
}

@code {
    [Parameter, EditorRequired] public string? FlagUrl { get; set; }
}
