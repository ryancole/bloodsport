@if (FlagUrl is not null)
{
    <img src="@FlagUrl" width="28" height="18" class="flex-shrink-0 rounded-[2px] object-cover ring-1 ring-black/20" alt="" />
}
else
{
    <span style="display:inline-block;width:28px;height:18px;flex-shrink:0;"></span>
}

@code {
    [Parameter, EditorRequired] public string? FlagUrl { get; set; }
}
