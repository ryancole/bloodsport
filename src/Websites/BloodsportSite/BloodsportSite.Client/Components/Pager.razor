@{
    var windowStart = Math.Max(1, Math.Min(CurrentPage - Window / 2, TotalPages - Window + 1));
    var windowEnd = Math.Min(TotalPages, windowStart + Window - 1);
}

@if (TotalPages > 1)
{
    <nav class="flex flex-wrap items-center gap-1">
        <button type="button" @onclick="() => OnPageChanged.InvokeAsync(CurrentPage - 1)" disabled="@(CurrentPage == 1)" class="rounded border border-gray-200 px-3 py-1 text-sm text-gray-700 hover:bg-gray-100 disabled:pointer-events-none disabled:opacity-40">Previous</button>
        @if (windowStart > 1)
        {
            <span class="px-2 text-sm text-gray-400">…</span>
        }
        @for (var p = windowStart; p <= windowEnd; p++)
        {
            var pageNum = p;
            <button type="button" @onclick="() => OnPageChanged.InvokeAsync(pageNum)" class="rounded border px-3 py-1 text-sm @(CurrentPage == pageNum ? "border-sky-600 bg-sky-600 text-white" : "border-gray-200 text-gray-700 hover:bg-gray-100")">@pageNum</button>
        }
        @if (windowEnd < TotalPages)
        {
            <span class="px-2 text-sm text-gray-400">…</span>
        }
        <button type="button" @onclick="() => OnPageChanged.InvokeAsync(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)" class="rounded border border-gray-200 px-3 py-1 text-sm text-gray-700 hover:bg-gray-100 disabled:pointer-events-none disabled:opacity-40">Next</button>
    </nav>
}

@code {
    private const int Window = 5;

    [Parameter, EditorRequired] public int CurrentPage { get; set; }
    [Parameter, EditorRequired] public int TotalPages { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnPageChanged { get; set; }
}
