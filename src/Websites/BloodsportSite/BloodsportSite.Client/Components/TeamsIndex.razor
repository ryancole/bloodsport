@rendermode InteractiveWebAssembly
@using BloodsportSite.Client.Models
@inject HttpClient Http

@if (teams is null)
{
    <LoadingSpinner />
}
else
{
    var filtered = string.IsNullOrWhiteSpace(search)
        ? teams
        : teams.Where(t => t.Name.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    var totalPages = (int)Math.Ceiling(filtered.Count / (double)PageSize);
    var page = currentPage < 1 ? 1 : currentPage;
    var pageItems = filtered.Skip((page - 1) * PageSize).Take(PageSize).ToList();

    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-2">
                <input type="search" class="input w-64" placeholder="Search by team name…"
                       @bind="searchInput" @bind:event="oninput" @onkeydown="HandleSearchKey" />
                <button class="btn btn-secondary" @onclick="ApplySearch">Search</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <span class="text-sm text-gray-500">
                    Filtering by &ldquo;@search&rdquo;
                    <button class="link cursor-pointer" @onclick="ClearSearch">&times;</button>
                </span>
            }
        </div>
        <Pager CurrentPage="page" TotalPages="totalPages" OnPageChanged="GoToPage" />
    </div>

    @if (!filtered.Any())
    {
        <p class="py-4 text-center text-gray-500">No teams found.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tbl">
                <thead>
                    <tr><th>Name</th><th>Manager</th><th>Created</th></tr>
                </thead>
                <tbody>
                    @foreach (var team in pageItems)
                    {
                        <tr>
                            <td><a href="/teams/@team.Id" class="link inline-flex items-center gap-2"><TeamFlag FlagUrl="@team.FlagUrl" />@team.Name</a></td>
                            <td><a href="/users/@team.ManagerId" class="link inline-flex items-center gap-2"><TeamFlag FlagUrl="@team.ManagerFlagUrl" />@team.ManagerName</a></td>
                            <td>@team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const int PageSize = 20;

    private List<TeamListItem>? teams;
    private string? search;
    private string searchInput = "";
    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            teams = await Http.GetFromJsonAsync<List<TeamListItem>>("/api/teams");
        }
    }

    private void ApplySearch()
    {
        search = string.IsNullOrWhiteSpace(searchInput) ? null : searchInput.Trim();
        currentPage = 1;
    }

    private void ClearSearch()
    {
        search = null;
        searchInput = "";
        currentPage = 1;
    }

    private void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplySearch();
    }

    private void GoToPage(int page)
    {
        currentPage = page;
    }
}
