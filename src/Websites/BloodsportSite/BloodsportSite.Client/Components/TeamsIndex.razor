@rendermode InteractiveWebAssembly
@using BloodsportSite.Client.Models
@inject HttpClient Http

@if (teams is null)
{
    <LoadingSpinner />
}
else
{
    var filtered = string.IsNullOrWhiteSpace(search)
        ? teams
        : teams.Where(t => t.Name.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    var totalPages = (int)Math.Ceiling(filtered.Count / (double)PageSize);
    var page = currentPage < 1 ? 1 : currentPage;
    var pageItems = filtered.Skip((page - 1) * PageSize).Take(PageSize).ToList();

    <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex gap-2">
                <input type="search" class="form-control w-auto" placeholder="Search by team name…"
                       @bind="searchInput" @bind:event="oninput" @onkeydown="HandleSearchKey" />
                <button class="btn btn-secondary" @onclick="ApplySearch">Search</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <span class="text-muted">
                    Filtering by &ldquo;@search&rdquo;
                    <button class="btn btn-link btn-sm p-0 ms-1 text-decoration-none" @onclick="ClearSearch">&times;</button>
                </span>
            }
        </div>
        <Pager CurrentPage="page" TotalPages="totalPages" OnPageChanged="GoToPage" />
    </div>

    @if (!filtered.Any())
    {
        <p class="text-center text-muted fs-5 py-4">No teams found.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Manager</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in pageItems)
                {
                    <tr>
                        <td>
                            <a href="/teams/@team.Id" class="d-flex align-items-center gap-2">
                                <TeamFlag FlagUrl="@team.FlagUrl" />
                                @team.Name
                            </a>
                        </td>
                        <td>
                            <a href="/users/@team.ManagerId" class="d-flex align-items-center gap-2">
                                <TeamFlag FlagUrl="@team.ManagerFlagUrl" />
                                @team.ManagerName
                            </a>
                        </td>
                        <td>@team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private const int PageSize = 20;

    private List<TeamListItem>? teams;
    private string? search;
    private string searchInput = "";
    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            teams = await Http.GetFromJsonAsync<List<TeamListItem>>("/api/teams");
        }
    }

    private void ApplySearch()
    {
        search = string.IsNullOrWhiteSpace(searchInput) ? null : searchInput.Trim();
        currentPage = 1;
    }

    private void ClearSearch()
    {
        search = null;
        searchInput = "";
        currentPage = 1;
    }

    private void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplySearch();
    }

    private void GoToPage(int page)
    {
        currentPage = page;
    }
}
