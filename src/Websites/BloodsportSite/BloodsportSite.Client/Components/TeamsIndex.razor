@rendermode InteractiveWebAssembly
@using BloodsportSite.Client.Models
@inject HttpClient Http

@if (result is null)
{
    <LoadingSpinner />
}
else
{
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-2">
                <input type="search" class="input w-64" placeholder="Search by team name…"
                       @bind="searchInput" @bind:event="oninput" @onkeydown="HandleSearchKey" />
                <button class="btn btn-secondary" @onclick="ApplySearch">Search</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <span class="text-sm text-gray-500">
                    Filtering by &ldquo;@search&rdquo;
                    <button class="link cursor-pointer" @onclick="ClearSearch">&times;</button>
                </span>
            }
        </div>
        <Pager CurrentPage="result.Page" TotalPages="result.TotalPages" OnPageChanged="GoToPage" />
    </div>

    @if (result.Items.Count == 0)
    {
        <p class="py-4 text-center text-gray-500">No teams found.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tbl">
                <thead>
                    <tr><th>Name</th><th>Manager</th><th>Created</th></tr>
                </thead>
                <tbody>
                    @foreach (var team in result.Items)
                    {
                        <tr>
                            <td><a href="/teams/@team.Id" class="link inline-flex max-w-full items-center gap-2"><TeamFlag FlagUrl="@team.FlagUrl" /><span class="truncate">@team.Name</span></a></td>
                            <td><a href="/users/@team.ManagerId" class="link inline-flex max-w-full items-center gap-2"><TeamFlag FlagUrl="@team.ManagerFlagUrl" /><span class="truncate">@team.ManagerName</span></a></td>
                            <td>@team.DateCreated.ToLocalTime().ToString("MMMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const int PageSize = 20;

    private PagedResult<TeamListItem>? result;
    private string? search;
    private string searchInput = "";
    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var url = $"/api/teams?page={currentPage}&pageSize={PageSize}";
        if (!string.IsNullOrWhiteSpace(search))
        {
            url += $"&search={Uri.EscapeDataString(search)}";
        }

        result = await Http.GetFromJsonAsync<PagedResult<TeamListItem>>(url);
        if (result is not null)
        {
            currentPage = result.Page;
        }
    }

    private async Task ApplySearch()
    {
        search = string.IsNullOrWhiteSpace(searchInput) ? null : searchInput.Trim();
        currentPage = 1;
        await LoadAsync();
    }

    private async Task ClearSearch()
    {
        search = null;
        searchInput = "";
        currentPage = 1;
        await LoadAsync();
    }

    private async Task HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplySearch();
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadAsync();
    }
}
