{
  "$comment": "CAL (Champions Amateur League) design tokens, extracted from the Bloodsport Blazor site. Tailwind CSS v4; the brand accent is exposed as the brand-* scale via an @theme block in Styles/app.css (aliases sky), gray = neutral scale. Hex values are sRGB equivalents of Tailwind's OKLCH defaults. See design-tokens.md for full context.",
  "brand": {
    "name": "Champions Amateur League",
    "abbreviation": "CAL",
    "logo": {
      "navbar": "src/Websites/BloodsportSite/BloodsportSite/wwwroot/cal-logo.svg",
      "favicon": "src/Websites/BloodsportSite/BloodsportSite/wwwroot/favicon.svg",
      "style": "8-bit pixel coin",
      "field": "#111827",
      "letters": "#ffffff",
      "coin": "#0ea5e9",
      "hoverGlow": "0 0 8px rgba(56,189,248,0.7)"
    }
  },
  "color": {
    "primary": "brand",
    "neutral": "gray",
    "brand": {
      "$comment": "Exposed as brand-* utilities via @theme; values mirror Tailwind sky.",
      "50": "#f0f9ff", "100": "#e0f2fe", "200": "#bae6fd", "300": "#7dd3fc",
      "400": "#38bdf8", "500": "#0ea5e9", "600": "#0284c7", "700": "#0369a1",
      "800": "#075985", "900": "#0c4a6e"
    },
    "sky": {
      "50": "#f0f9ff", "100": "#e0f2fe", "200": "#bae6fd", "300": "#7dd3fc",
      "400": "#38bdf8", "500": "#0ea5e9", "600": "#0284c7", "700": "#0369a1",
      "800": "#075985", "900": "#0c4a6e"
    },
    "gray": {
      "50": "#f9fafb", "100": "#f3f4f6", "200": "#e5e7eb", "300": "#d1d5db",
      "400": "#9ca3af", "500": "#6b7280", "600": "#4b5563", "700": "#374151",
      "800": "#1f2937", "900": "#111827"
    },
    "semantic": {
      "success": { "tone": "green", "bg": "#dcfce7", "border": "#bbf7d0", "solid": "#16a34a", "text": "#15803d" },
      "warning": { "tone": "amber", "bg": "#fef3c7", "border": "#fde68a", "text": "#b45309" },
      "danger":  { "tone": "red",   "bg": "#fee2e2", "border": "#fecaca", "solid": "#dc2626", "text": "#b91c1c" },
      "info":    { "tone": "sky",   "bg": "#e0f2fe", "border": "#bae6fd", "text": "#075985" }
    }
  },
  "typography": {
    "fontFamily": "Tailwind default font-sans (ui-sans-serif, system-ui, sans-serif, ...)",
    "pageTitle":   { "size": "text-2xl", "weight": "font-bold", "color": "#111827" },
    "sectionTitle":{ "size": "text-lg",  "weight": "font-semibold", "color": "#111827" },
    "eyebrow":     { "size": "text-xs",  "weight": "font-semibold", "transform": "uppercase", "tracking": "wider", "color": "#6b7280" },
    "body":        { "size": "text-sm",  "color": "#374151" }
  },
  "radius": {
    "card": "0.5rem",
    "button": "0.375rem",
    "input": "0.375rem",
    "pill": "9999px"
  },
  "spacing": {
    "pageContainer": "max-w-6xl px-6 py-6",
    "docWidth": "max-w-3xl",
    "cardPadding": "1.25rem",
    "navbarHeight": "3.5rem"
  },
  "elevation": {
    "card": "shadow-sm"
  },
  "componentClasses": [
    "page-wrap", "page-title", "section-title", "eyebrow", "card", "link",
    "btn", "btn-primary", "btn-secondary", "btn-danger", "btn-sm",
    "input", "label", "badge", "tbl",
    "alert", "alert-info", "alert-success", "alert-warning", "alert-danger", "doc"
  ]
}
